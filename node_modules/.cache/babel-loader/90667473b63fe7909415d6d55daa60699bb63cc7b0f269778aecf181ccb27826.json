{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nexport default {\n  name: \"ReportDetailView\",\n  data() {\n    return {\n      reportId: null,\n      doctorNotes: \"\",\n      diseaseCategories: [\"糖尿病视网膜病变\", \"青光眼\", \"白内障\", \"AMD\", \"高血压视网膜病变\", \"近视\", \"其他异常\", \"正常\"],\n      report: {\n        id: \"\",\n        time: \"\",\n        doctor: \"\",\n        leftEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        rightEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        leftEye: {\n          diagnosis: \"\",\n          confidence: 0,\n          probabilities: []\n        },\n        rightEye: {\n          diagnosis: \"\",\n          confidence: 0,\n          probabilities: []\n        },\n        finalDiagnosis: \"\",\n        suggestion: \"\"\n      }\n    };\n  },\n  methods: {\n    goBack() {\n      this.$router.go(-1);\n    },\n    exportReport() {\n      this.$message.success(\"报告已导出为PDF文件\");\n    },\n    printReport() {\n      window.print();\n    },\n    saveNotes() {\n      this.$message.success(\"医生备注已保存\");\n    },\n    percentFormat(percentage) {\n      return percentage + \"%\";\n    },\n    getConfidenceColor(confidence) {\n      if (confidence >= 80) {\n        return \"#67c23a\"; // 高置信度，绿色\n      } else if (confidence >= 60) {\n        return \"#e6a23c\"; // 中等置信度，黄色\n      } else {\n        return \"#f56c6c\"; // 低置信度，红色\n      }\n    },\n    getMatrixData(probabilities) {\n      if (!probabilities || probabilities.length === 0) {\n        return [];\n      }\n      return this.diseaseCategories.map((disease, index) => ({\n        disease,\n        probability: Math.round(probabilities[index] * 100)\n      }));\n    },\n    generateRandomProbabilities() {\n      // 生成随机概率分布\n      const probs = Array(this.diseaseCategories.length).fill(0).map(() => Math.random());\n      const sum = probs.reduce((a, b) => a + b, 0);\n      return probs.map(p => p / sum);\n    },\n    getMaxProbabilityIndex(probabilities) {\n      return probabilities.indexOf(Math.max(...probabilities));\n    },\n    generateFinalDiagnosis(leftIndex, rightIndex) {\n      // 根据左右眼结果生成综合诊断\n      if (leftIndex === rightIndex) {\n        return `双眼${this.diseaseCategories[leftIndex]}`;\n      } else if (leftIndex === 7 || rightIndex === 7) {\n        // 7是\"正常\"的索引\n        const abnormalIndex = leftIndex === 7 ? rightIndex : leftIndex;\n        const abnormalSide = leftIndex === 7 ? \"右眼\" : \"左眼\";\n        return `${abnormalSide}${this.diseaseCategories[abnormalIndex]}，另眼正常`;\n      } else {\n        return `左眼${this.diseaseCategories[leftIndex]}，右眼${this.diseaseCategories[rightIndex]}`;\n      }\n    },\n    generateSuggestion(leftIndex, rightIndex) {\n      // 根据诊断结果生成建议\n      const suggestions = {\n        0: \"建议进行血糖控制，定期复查眼底，必要时考虑激光或抗VEGF治疗。\",\n        1: \"建议测量眼压，进行视野检查，必要时使用降眼压药物。\",\n        2: \"建议进行视力矫正，必要时考虑白内障手术。\",\n        3: \"建议定期监测黄斑区变化，必要时考虑抗VEGF治疗。\",\n        4: \"建议控制血压，定期复查眼底。\",\n        5: \"建议进行屈光矫正，控制近距离用眼时间。\",\n        6: \"建议进一步检查确定具体异常类型。\",\n        7: \"眼底未见明显异常，建议定期检查。\"\n      };\n      if (leftIndex === rightIndex) {\n        return suggestions[leftIndex];\n      } else {\n        return `左眼：${suggestions[leftIndex]}\\n右眼：${suggestions[rightIndex]}`;\n      }\n    },\n    loadReportData() {\n      // 模拟从后端加载报告数据\n      // 在实际应用中，这里应该是一个API请求\n\n      // 生成模拟数据\n      const leftEyeProbs = this.generateRandomProbabilities();\n      const rightEyeProbs = this.generateRandomProbabilities();\n      const leftMaxIndex = this.getMaxProbabilityIndex(leftEyeProbs);\n      const rightMaxIndex = this.getMaxProbabilityIndex(rightEyeProbs);\n      const date = new Date();\n      this.report = {\n        id: this.reportId,\n        time: date.toLocaleString(),\n        doctor: \"张医生\",\n        leftEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        rightEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        leftEye: {\n          diagnosis: this.diseaseCategories[leftMaxIndex],\n          confidence: Math.round(leftEyeProbs[leftMaxIndex] * 100),\n          probabilities: leftEyeProbs\n        },\n        rightEye: {\n          diagnosis: this.diseaseCategories[rightMaxIndex],\n          confidence: Math.round(rightEyeProbs[rightMaxIndex] * 100),\n          probabilities: rightEyeProbs\n        },\n        finalDiagnosis: this.generateFinalDiagnosis(leftMaxIndex, rightMaxIndex),\n        suggestion: this.generateSuggestion(leftMaxIndex, rightMaxIndex)\n      };\n    }\n  },\n  created() {\n    // 从路由参数获取报告ID\n    this.reportId = this.$route.params.id;\n    this.loadReportData();\n  },\n  mounted() {\n    // 检查登录状态\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\n    if (!isLoggedIn) {\n      this.$router.push(\"/login\");\n    }\n  }\n};","map":{"version":3,"names":["name","data","reportId","doctorNotes","diseaseCategories","report","id","time","doctor","leftEyeImage","rightEyeImage","leftEye","diagnosis","confidence","probabilities","rightEye","finalDiagnosis","suggestion","methods","goBack","$router","go","exportReport","$message","success","printReport","window","print","saveNotes","percentFormat","percentage","getConfidenceColor","getMatrixData","length","map","disease","index","probability","Math","round","generateRandomProbabilities","probs","Array","fill","random","sum","reduce","a","b","p","getMaxProbabilityIndex","indexOf","max","generateFinalDiagnosis","leftIndex","rightIndex","abnormalIndex","abnormalSide","generateSuggestion","suggestions","loadReportData","leftEyeProbs","rightEyeProbs","leftMaxIndex","rightMaxIndex","date","Date","toLocaleString","created","$route","params","mounted","isLoggedIn","localStorage","getItem","push"],"sources":["E:\\Apollo\\Eye-Diagnose-System\\src\\views\\ReportDetailView.vue"],"sourcesContent":["<template>\r\n  <div class=\"report-detail-container\">\r\n    <div class=\"report-header\">\r\n      <div class=\"back-button\">\r\n        <el-button icon=\"el-icon-arrow-left\" @click=\"goBack\">返回</el-button>\r\n      </div>\r\n      <h1 class=\"report-title\">眼底图像诊断报告</h1>\r\n      <div class=\"report-actions\">\r\n        <el-button type=\"primary\" icon=\"el-icon-download\" @click=\"exportReport\"\r\n          >导出报告</el-button\r\n        >\r\n        <el-button type=\"success\" icon=\"el-icon-printer\" @click=\"printReport\"\r\n          >打印报告</el-button\r\n        >\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"report-content\" ref=\"reportContent\">\r\n      <el-card class=\"report-card\">\r\n        <template #header>\r\n          <div class=\"report-card-header\">\r\n            <h2>基本信息</h2>\r\n          </div>\r\n        </template>\r\n        <div class=\"basic-info\">\r\n          <div class=\"info-item\">\r\n            <span class=\"info-label\">报告ID：</span>\r\n            <span class=\"info-value\">{{ report.id }}</span>\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <span class=\"info-label\">诊断时间：</span>\r\n            <span class=\"info-value\">{{ report.time }}</span>\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <span class=\"info-label\">医生：</span>\r\n            <span class=\"info-value\">{{ report.doctor }}</span>\r\n          </div>\r\n        </div>\r\n      </el-card>\r\n\r\n      <el-row :gutter=\"20\" class=\"eye-images-row\">\r\n        <el-col :xs=\"24\" :sm=\"12\">\r\n          <el-card class=\"image-card\">\r\n            <template #header>\r\n              <div class=\"image-card-header\">\r\n                <h3>左眼眼底图像</h3>\r\n              </div>\r\n            </template>\r\n            <div class=\"eye-image-container\">\r\n              <img\r\n                :src=\"report.leftEyeImage\"\r\n                alt=\"左眼眼底图像\"\r\n                class=\"eye-image\"\r\n              />\r\n            </div>\r\n          </el-card>\r\n        </el-col>\r\n        <el-col :xs=\"24\" :sm=\"12\">\r\n          <el-card class=\"image-card\">\r\n            <template #header>\r\n              <div class=\"image-card-header\">\r\n                <h3>右眼眼底图像</h3>\r\n              </div>\r\n            </template>\r\n            <div class=\"eye-image-container\">\r\n              <img\r\n                :src=\"report.rightEyeImage\"\r\n                alt=\"右眼眼底图像\"\r\n                class=\"eye-image\"\r\n              />\r\n            </div>\r\n          </el-card>\r\n        </el-col>\r\n      </el-row>\r\n\r\n      <el-row :gutter=\"20\" class=\"diagnosis-row\">\r\n        <el-col :xs=\"24\" :sm=\"12\">\r\n          <el-card class=\"diagnosis-card\">\r\n            <template #header>\r\n              <div class=\"diagnosis-card-header\">\r\n                <h3>左眼诊断结果</h3>\r\n              </div>\r\n            </template>\r\n            <div class=\"diagnosis-content\">\r\n              <div class=\"diagnosis-result\">\r\n                <h4>诊断结论：</h4>\r\n                <div class=\"result-text\">{{ report.leftEye.diagnosis }}</div>\r\n                <div class=\"confidence-bar\">\r\n                  <span class=\"confidence-label\">置信度：</span>\r\n                  <el-progress\r\n                    :percentage=\"report.leftEye.confidence\"\r\n                    :format=\"percentFormat\"\r\n                    :stroke-width=\"18\"\r\n                    :color=\"getConfidenceColor(report.leftEye.confidence)\"\r\n                  ></el-progress>\r\n                </div>\r\n              </div>\r\n              <div class=\"probability-matrix\">\r\n                <h4>疾病置信度矩阵：</h4>\r\n                <div class=\"matrix-table\">\r\n                  <el-table\r\n                    :data=\"getMatrixData(report.leftEye.probabilities)\"\r\n                    style=\"width: 100%\"\r\n                    border\r\n                    size=\"small\"\r\n                  >\r\n                    <el-table-column\r\n                      prop=\"disease\"\r\n                      label=\"疾病类型\"\r\n                      width=\"180\"\r\n                    ></el-table-column>\r\n                    <el-table-column prop=\"probability\" label=\"概率\">\r\n                      <template #default=\"scope\">\r\n                        <el-progress\r\n                          :percentage=\"scope.row.probability\"\r\n                          :stroke-width=\"10\"\r\n                          :show-text=\"true\"\r\n                          :color=\"getConfidenceColor(scope.row.probability)\"\r\n                        ></el-progress>\r\n                      </template>\r\n                    </el-table-column>\r\n                  </el-table>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </el-card>\r\n        </el-col>\r\n        <el-col :xs=\"24\" :sm=\"12\">\r\n          <el-card class=\"diagnosis-card\">\r\n            <template #header>\r\n              <div class=\"diagnosis-card-header\">\r\n                <h3>右眼诊断结果</h3>\r\n              </div>\r\n            </template>\r\n            <div class=\"diagnosis-content\">\r\n              <div class=\"diagnosis-result\">\r\n                <h4>诊断结论：</h4>\r\n                <div class=\"result-text\">{{ report.rightEye.diagnosis }}</div>\r\n                <div class=\"confidence-bar\">\r\n                  <span class=\"confidence-label\">置信度：</span>\r\n                  <el-progress\r\n                    :percentage=\"report.rightEye.confidence\"\r\n                    :format=\"percentFormat\"\r\n                    :stroke-width=\"18\"\r\n                    :color=\"getConfidenceColor(report.rightEye.confidence)\"\r\n                  ></el-progress>\r\n                </div>\r\n              </div>\r\n              <div class=\"probability-matrix\">\r\n                <h4>疾病置信度矩阵：</h4>\r\n                <div class=\"matrix-table\">\r\n                  <el-table\r\n                    :data=\"getMatrixData(report.rightEye.probabilities)\"\r\n                    style=\"width: 100%\"\r\n                    border\r\n                    size=\"small\"\r\n                  >\r\n                    <el-table-column\r\n                      prop=\"disease\"\r\n                      label=\"疾病类型\"\r\n                      width=\"180\"\r\n                    ></el-table-column>\r\n                    <el-table-column prop=\"probability\" label=\"概率\">\r\n                      <template #default=\"scope\">\r\n                        <el-progress\r\n                          :percentage=\"scope.row.probability\"\r\n                          :stroke-width=\"10\"\r\n                          :show-text=\"true\"\r\n                          :color=\"getConfidenceColor(scope.row.probability)\"\r\n                        ></el-progress>\r\n                      </template>\r\n                    </el-table-column>\r\n                  </el-table>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </el-card>\r\n        </el-col>\r\n      </el-row>\r\n\r\n      <el-card class=\"final-diagnosis-card\">\r\n        <template #header>\r\n          <div class=\"final-diagnosis-header\">\r\n            <h2>综合诊断结果</h2>\r\n          </div>\r\n        </template>\r\n        <div class=\"final-diagnosis-content\">\r\n          <div class=\"final-result\">\r\n            <h3>最终诊断结论：</h3>\r\n            <div class=\"final-result-text\">{{ report.finalDiagnosis }}</div>\r\n          </div>\r\n          <div class=\"diagnosis-suggestion\">\r\n            <h3>诊断建议：</h3>\r\n            <div class=\"suggestion-text\">{{ report.suggestion }}</div>\r\n          </div>\r\n        </div>\r\n      </el-card>\r\n\r\n      <el-card class=\"notes-card\">\r\n        <template #header>\r\n          <div class=\"notes-header\">\r\n            <h2>医生备注</h2>\r\n          </div>\r\n        </template>\r\n        <div class=\"notes-content\">\r\n          <el-input\r\n            type=\"textarea\"\r\n            v-model=\"doctorNotes\"\r\n            :rows=\"4\"\r\n            placeholder=\"请输入医生备注...\"\r\n          ></el-input>\r\n          <div class=\"notes-actions\">\r\n            <el-button type=\"primary\" @click=\"saveNotes\">保存备注</el-button>\r\n          </div>\r\n        </div>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"ReportDetailView\",\r\n  data() {\r\n    return {\r\n      reportId: null,\r\n      doctorNotes: \"\",\r\n      diseaseCategories: [\r\n        \"糖尿病视网膜病变\",\r\n        \"青光眼\",\r\n        \"白内障\",\r\n        \"AMD\",\r\n        \"高血压视网膜病变\",\r\n        \"近视\",\r\n        \"其他异常\",\r\n        \"正常\",\r\n      ],\r\n      report: {\r\n        id: \"\",\r\n        time: \"\",\r\n        doctor: \"\",\r\n        leftEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\r\n        rightEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\r\n        leftEye: {\r\n          diagnosis: \"\",\r\n          confidence: 0,\r\n          probabilities: [],\r\n        },\r\n        rightEye: {\r\n          diagnosis: \"\",\r\n          confidence: 0,\r\n          probabilities: [],\r\n        },\r\n        finalDiagnosis: \"\",\r\n        suggestion: \"\",\r\n      },\r\n    };\r\n  },\r\n  methods: {\r\n    goBack() {\r\n      this.$router.go(-1);\r\n    },\r\n\r\n    exportReport() {\r\n      this.$message.success(\"报告已导出为PDF文件\");\r\n    },\r\n\r\n    printReport() {\r\n      window.print();\r\n    },\r\n\r\n    saveNotes() {\r\n      this.$message.success(\"医生备注已保存\");\r\n    },\r\n\r\n    percentFormat(percentage) {\r\n      return percentage + \"%\";\r\n    },\r\n\r\n    getConfidenceColor(confidence) {\r\n      if (confidence >= 80) {\r\n        return \"#67c23a\"; // 高置信度，绿色\r\n      } else if (confidence >= 60) {\r\n        return \"#e6a23c\"; // 中等置信度，黄色\r\n      } else {\r\n        return \"#f56c6c\"; // 低置信度，红色\r\n      }\r\n    },\r\n\r\n    getMatrixData(probabilities) {\r\n      if (!probabilities || probabilities.length === 0) {\r\n        return [];\r\n      }\r\n\r\n      return this.diseaseCategories.map((disease, index) => ({\r\n        disease,\r\n        probability: Math.round(probabilities[index] * 100),\r\n      }));\r\n    },\r\n\r\n    generateRandomProbabilities() {\r\n      // 生成随机概率分布\r\n      const probs = Array(this.diseaseCategories.length)\r\n        .fill(0)\r\n        .map(() => Math.random());\r\n      const sum = probs.reduce((a, b) => a + b, 0);\r\n      return probs.map((p) => p / sum);\r\n    },\r\n\r\n    getMaxProbabilityIndex(probabilities) {\r\n      return probabilities.indexOf(Math.max(...probabilities));\r\n    },\r\n\r\n    generateFinalDiagnosis(leftIndex, rightIndex) {\r\n      // 根据左右眼结果生成综合诊断\r\n      if (leftIndex === rightIndex) {\r\n        return `双眼${this.diseaseCategories[leftIndex]}`;\r\n      } else if (leftIndex === 7 || rightIndex === 7) {\r\n        // 7是\"正常\"的索引\r\n        const abnormalIndex = leftIndex === 7 ? rightIndex : leftIndex;\r\n        const abnormalSide = leftIndex === 7 ? \"右眼\" : \"左眼\";\r\n        return `${abnormalSide}${this.diseaseCategories[abnormalIndex]}，另眼正常`;\r\n      } else {\r\n        return `左眼${this.diseaseCategories[leftIndex]}，右眼${this.diseaseCategories[rightIndex]}`;\r\n      }\r\n    },\r\n\r\n    generateSuggestion(leftIndex, rightIndex) {\r\n      // 根据诊断结果生成建议\r\n      const suggestions = {\r\n        0: \"建议进行血糖控制，定期复查眼底，必要时考虑激光或抗VEGF治疗。\",\r\n        1: \"建议测量眼压，进行视野检查，必要时使用降眼压药物。\",\r\n        2: \"建议进行视力矫正，必要时考虑白内障手术。\",\r\n        3: \"建议定期监测黄斑区变化，必要时考虑抗VEGF治疗。\",\r\n        4: \"建议控制血压，定期复查眼底。\",\r\n        5: \"建议进行屈光矫正，控制近距离用眼时间。\",\r\n        6: \"建议进一步检查确定具体异常类型。\",\r\n        7: \"眼底未见明显异常，建议定期检查。\",\r\n      };\r\n\r\n      if (leftIndex === rightIndex) {\r\n        return suggestions[leftIndex];\r\n      } else {\r\n        return `左眼：${suggestions[leftIndex]}\\n右眼：${suggestions[rightIndex]}`;\r\n      }\r\n    },\r\n\r\n    loadReportData() {\r\n      // 模拟从后端加载报告数据\r\n      // 在实际应用中，这里应该是一个API请求\r\n\r\n      // 生成模拟数据\r\n      const leftEyeProbs = this.generateRandomProbabilities();\r\n      const rightEyeProbs = this.generateRandomProbabilities();\r\n\r\n      const leftMaxIndex = this.getMaxProbabilityIndex(leftEyeProbs);\r\n      const rightMaxIndex = this.getMaxProbabilityIndex(rightEyeProbs);\r\n\r\n      const date = new Date();\r\n\r\n      this.report = {\r\n        id: this.reportId,\r\n        time: date.toLocaleString(),\r\n        doctor: \"张医生\",\r\n        leftEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\r\n        rightEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\r\n        leftEye: {\r\n          diagnosis: this.diseaseCategories[leftMaxIndex],\r\n          confidence: Math.round(leftEyeProbs[leftMaxIndex] * 100),\r\n          probabilities: leftEyeProbs,\r\n        },\r\n        rightEye: {\r\n          diagnosis: this.diseaseCategories[rightMaxIndex],\r\n          confidence: Math.round(rightEyeProbs[rightMaxIndex] * 100),\r\n          probabilities: rightEyeProbs,\r\n        },\r\n        finalDiagnosis: this.generateFinalDiagnosis(\r\n          leftMaxIndex,\r\n          rightMaxIndex\r\n        ),\r\n        suggestion: this.generateSuggestion(leftMaxIndex, rightMaxIndex),\r\n      };\r\n    },\r\n  },\r\n  created() {\r\n    // 从路由参数获取报告ID\r\n    this.reportId = this.$route.params.id;\r\n    this.loadReportData();\r\n  },\r\n  mounted() {\r\n    // 检查登录状态\r\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\r\n    if (!isLoggedIn) {\r\n      this.$router.push(\"/login\");\r\n    }\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.report-detail-container {\r\n  padding: 20px;\r\n  background-color: #f5f7fa;\r\