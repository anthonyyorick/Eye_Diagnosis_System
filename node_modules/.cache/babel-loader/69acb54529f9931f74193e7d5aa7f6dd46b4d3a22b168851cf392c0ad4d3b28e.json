{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport AppLayout from \"@/components/AppLayout.vue\";\nimport * as echarts from \"echarts\";\nexport default {\n  name: \"AnalyticsView\",\n  components: {\n    AppLayout\n  },\n  data() {\n    return {\n      filterForm: {\n        timeRange: \"30days\",\n        department: [\"outpatient\"]\n      },\n      trendChartType: \"daily\",\n      charts: {\n        trendChart: null,\n        diseaseDistributionChart: null,\n        ageDistributionChart: null,\n        genderDistributionChart: null\n      },\n      anomalyCases: []\n    };\n  },\n  methods: {\n    updateCharts() {\n      this.updateTrendChart();\n      this.updateDiseaseDistributionChart();\n      this.updateAgeDistributionChart();\n      this.updateGenderDistributionChart();\n      this.updateAnomalyCases();\n    },\n    resetFilter() {\n      this.filterForm = {\n        timeRange: \"30days\",\n        department: [\"outpatient\"]\n      };\n      this.updateCharts();\n    },\n    percentFormat(percentage) {\n      return percentage + \"%\";\n    },\n    getConfidenceColor(confidence) {\n      if (confidence < 60) {\n        return \"#F56C6C\";\n      } else if (confidence < 80) {\n        return \"#E6A23C\";\n      } else {\n        return \"#67C23A\";\n      }\n    },\n    viewAnomalyDetail(row) {\n      this.$router.push(`/reports/detail/${row.id}`);\n    },\n    exportData(type) {\n      this.$message.success(`数据已导出为${type.toUpperCase()}格式`);\n    },\n    // 诊断趋势图表\n    updateTrendChart() {\n      if (!this.charts.trendChart) {\n        this.charts.trendChart = echarts.init(this.$refs.trendChart);\n      }\n\n      // 生成日期数据\n      const dates = [];\n      const diagnosisCounts = [];\n      const normalCounts = [];\n      const abnormalCounts = [];\n      let days = 30;\n      switch (this.filterForm.timeRange) {\n        case \"7days\":\n          days = 7;\n          break;\n        case \"30days\":\n          days = 30;\n          break;\n        case \"3months\":\n          days = 90;\n          break;\n        case \"1year\":\n          days = 365;\n          break;\n      }\n      const today = new Date();\n      for (let i = days - 1; i >= 0; i--) {\n        const date = new Date();\n        date.setDate(today.getDate() - i);\n        let dateStr;\n        if (this.trendChartType === \"daily\") {\n          dateStr = `${date.getMonth() + 1}/${date.getDate()}`;\n        } else if (this.trendChartType === \"weekly\") {\n          // 简化处理，实际应用中应该按周分组\n          dateStr = `第${Math.floor(i / 7) + 1}周`;\n        } else {\n          dateStr = `${date.getMonth() + 1}月`;\n        }\n        if (!dates.includes(dateStr)) {\n          dates.push(dateStr);\n\n          // 生成随机数据\n          const total = Math.floor(Math.random() * 50) + 10;\n          const normal = Math.floor(Math.random() * total);\n          const abnormal = total - normal;\n          diagnosisCounts.push(total);\n          normalCounts.push(normal);\n          abnormalCounts.push(abnormal);\n        }\n      }\n      const option = {\n        tooltip: {\n          trigger: \"axis\",\n          axisPointer: {\n            type: \"shadow\"\n          }\n        },\n        legend: {\n          data: [\"总诊断量\", \"正常\", \"异常\"]\n        },\n        grid: {\n          left: \"3%\",\n          right: \"4%\",\n          bottom: \"3%\",\n          containLabel: true\n        },\n        xAxis: {\n          type: \"category\",\n          data: dates\n        },\n        yAxis: {\n          type: \"value\"\n        },\n        series: [{\n          name: \"总诊断量\",\n          type: \"line\",\n          data: diagnosisCounts,\n          smooth: true,\n          lineStyle: {\n            width: 3\n          }\n        }, {\n          name: \"正常\",\n          type: \"bar\",\n          stack: \"total\",\n          data: normalCounts,\n          itemStyle: {\n            color: \"#67C23A\"\n          }\n        }, {\n          name: \"异常\",\n          type: \"bar\",\n          stack: \"total\",\n          data: abnormalCounts,\n          itemStyle: {\n            color: \"#F56C6C\"\n          }\n        }]\n      };\n      this.charts.trendChart.setOption(option);\n    },\n    // 疾病分布图表\n    updateDiseaseDistributionChart() {\n      if (!this.charts.diseaseDistributionChart) {\n        this.charts.diseaseDistributionChart = echarts.init(this.$refs.diseaseDistributionChart);\n      }\n      const diseaseCategories = [\"糖尿病视网膜病变\", \"青光眼\", \"白内障\", \"AMD\", \"高血压视网膜病变\", \"近视\", \"其他异常\", \"正常\"];\n\n      // 生成随机数据\n      const data = diseaseCategories.map(category => {\n        return {\n          value: Math.floor(Math.random() * 100) + 20,\n          name: category\n        };\n      });\n      const option = {\n        tooltip: {\n          trigger: \"item\",\n          formatter: \"{a} <br/>{b}: {c} ({d}%)\"\n        },\n        legend: {\n          orient: \"vertical\",\n          right: 10,\n          top: \"center\",\n          data: diseaseCategories\n        },\n        series: [{\n          name: \"疾病分布\",\n          type: \"pie\",\n          radius: [\"50%\", \"70%\"],\n          avoidLabelOverlap: false,\n          label: {\n            show: false,\n            position: \"center\"\n          },\n          emphasis: {\n            label: {\n              show: true,\n              fontSize: \"16\",\n              fontWeight: \"bold\"\n            }\n          },\n          labelLine: {\n            show: false\n          },\n          data: data\n        }]\n      };\n      this.charts.diseaseDistributionChart.setOption(option);\n    },\n    // 年龄分布图表\n    updateAgeDistributionChart() {\n      if (!this.charts.ageDistributionChart) {\n        this.charts.ageDistributionChart = echarts.init(this.$refs.ageDistributionChart);\n      }\n      const ageGroups = [\"0-18\", \"19-30\", \"31-45\", \"46-60\", \"61-75\", \"76+\"];\n\n      // 生成随机数据\n      const data = ageGroups.map(group => {\n        return Math.floor(Math.random() * 100) + 10;\n      });\n      const option = {\n        tooltip: {\n          trigger: \"axis\",\n          axisPointer: {\n            type: \"shadow\"\n          }\n        },\n        grid: {\n          left: \"3%\",\n          right: \"4%\",\n          bottom: \"3%\",\n          containLabel: true\n        },\n        xAxis: {\n          type: \"category\",\n          data: ageGroups\n        },\n        yAxis: {\n          type: \"value\",\n          name: \"患者数量\"\n        },\n        series: [{\n          name: \"患者数量\",\n          type: \"bar\",\n          data: data,\n          itemStyle: {\n            color: function (params) {\n              const colorList = [\"#91c7ae\", \"#749f83\", \"#ca8622\", \"#bda29a\", \"#6e7074\", \"#546570\"];\n              return colorList[params.dataIndex];\n            }\n          }\n        }]\n      };\n      this.charts.ageDistributionChart.setOption(option);\n    },\n    // 性别分布图表\n    updateGenderDistributionChart() {\n      if (!this.charts.genderDistributionChart) {\n        this.charts.genderDistributionChart = echarts.init(this.$refs.genderDistributionChart);\n      }\n\n      // 生成随机数据\n      const maleCount = Math.floor(Math.random() * 200) + 100;\n      const femaleCount = Math.floor(Math.random() * 200) + 100;\n      const option = {\n        tooltip: {\n          trigger: \"item\",\n          formatter: \"{a} <br/>{b}: {c} ({d}%)\"\n        },\n        legend: {\n          orient: \"horizontal\",\n          bottom: \"bottom\",\n          data: [\"男\", \"女\"]\n        },\n        color: [\"#409EFF\", \"#FF6B6B\"],\n        series: [{\n          name: \"性别分布\",\n          type: \"pie\",\n          radius: \"55%\",\n          center: [\"50%\", \"45%\"],\n          data: [{\n            value: maleCount,\n            name: \"男\"\n          }, {\n            value: femaleCount,\n            name: \"女\"\n          }],\n          emphasis: {\n            itemStyle: {\n              shadowBlur: 10,\n              shadowOffsetX: 0,\n              shadowColor: \"rgba(0, 0, 0, 0.5)\"\n            }\n          }\n        }]\n      };\n      this.charts.genderDistributionChart.setOption(option);\n    },\n    // 更新异常病例数据\n    updateAnomalyCases() {\n      // 生成模拟异常病例数据\n      this.anomalyCases = [];\n      for (let i = 0; i < 5; i++) {\n        const date = new Date();\n        date.setDate(date.getDate() - Math.floor(Math.random() * 30));\n        const leftConfidence = Math.floor(Math.random() * 30) + 40; // 40-70之间\n        const rightConfidence = Math.floor(Math.random() * 30) + 40;\n        const diseaseOptions = [\"糖尿病视网膜病变\", \"青光眼\", \"白内障\", \"AMD\", \"高血压视网膜病变\", \"近视\", \"其他异常\", \"正常\"];\n        const leftDiagnosis = diseaseOptions[Math.floor(Math.random() * diseaseOptions.length)];\n        const rightDiagnosis = diseaseOptions[Math.floor(Math.random() * diseaseOptions.length)];\n        let anomalyReason;\n        if (leftConfidence < 60 && rightConfidence < 60) {\n          anomalyReason = \"双眼诊断置信度低\";\n        } else if (leftConfidence < 60) {\n          anomalyReason = \"左眼诊断置信度低\";\n        } else if (rightConfidence < 60) {\n          anomalyReason = \"右眼诊断置信度低\";\n        } else if (leftDiagnosis !== rightDiagnosis && leftDiagnosis !== \"正常\" && rightDiagnosis !== \"正常\") {\n          anomalyReason = \"左右眼诊断结果差异大\";\n        }\n        this.anomalyCases.push({\n          id: `PT2023${2000 + i}`,\n          time: date.toLocaleString(),\n          leftEye: {\n            diagnosis: leftDiagnosis,\n            confidence: leftConfidence\n          },\n          rightEye: {\n            diagnosis: rightDiagnosis,\n            confidence: rightConfidence\n          },\n          anomalyReason: anomalyReason\n        });\n      }\n    }\n  },\n  mounted() {\n    // 检查登录状态\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\n    if (!isLoggedIn) {\n      this.$router.push(\"/login\");\n    }\n\n    // 初始化图表\n    this.$nextTick(() => {\n      this.updateCharts();\n\n      // 响应窗口大小变化\n      window.addEventListener(\"resize\", () => {\n        for (const key in this.charts) {\n          if (this.charts[key]) {\n            this.charts[key].resize();\n          }\n        }\n      });\n    });\n  },\n  beforeUnmount() {\n    // 移除事件监听\n    window.removeEventListener(\"resize\", () => {});\n\n    // 销毁图表实例\n    for (const key in this.charts) {\n      if (this.charts[key]) {\n        this.charts[key].dispose();\n      }\n    }\n  }\n};","map":{"version":3,"names":["AppLayout","echarts","name","components","data","filterForm","timeRange","department","trendChartType","charts","trendChart","diseaseDistributionChart","ageDistributionChart","genderDistributionChart","anomalyCases","methods","updateCharts","updateTrendChart","updateDiseaseDistributionChart","updateAgeDistributionChart","updateGenderDistributionChart","updateAnomalyCases","resetFilter","percentFormat","percentage","getConfidenceColor","confidence","viewAnomalyDetail","row","$router","push","id","exportData","type","$message","success","toUpperCase","init","$refs","dates","diagnosisCounts","normalCounts","abnormalCounts","days","today","Date","i","date","setDate","getDate","dateStr","getMonth","Math","floor","includes","total","random","normal","abnormal","option","tooltip","trigger","axisPointer","legend","grid","left","right","bottom","containLabel","xAxis","yAxis","series","smooth","lineStyle","width","stack","itemStyle","color","setOption","diseaseCategories","map","category","value","formatter","orient","top","radius","avoidLabelOverlap","label","show","position","emphasis","fontSize","fontWeight","labelLine","ageGroups","group","params","colorList","dataIndex","maleCount","femaleCount","center","shadowBlur","shadowOffsetX","shadowColor","leftConfidence","rightConfidence","diseaseOptions","leftDiagnosis","length","rightDiagnosis","anomalyReason","time","toLocaleString","leftEye","diagnosis","rightEye","mounted","isLoggedIn","localStorage","getItem","$nextTick","window","addEventListener","key","resize","beforeUnmount","removeEventListener","dispose"],"sources":["E:\\Apollo\\Eye-Diagnose-System\\src\\views\\AnalyticsView.vue"],"sourcesContent":["<template>\r\n  <app-layout active-menu=\"/analytics\">\r\n    <div class=\"analytics-container\">\r\n      <div class=\"analytics-header\">\r\n        <h1 class=\"page-title\">数据分析中心</h1>\r\n        <div class=\"export-actions\">\r\n          <el-button\r\n            type=\"primary\"\r\n            icon=\"el-icon-download\"\r\n            @click=\"exportData('csv')\"\r\n            >导出CSV</el-button\r\n          >\r\n          <el-button\r\n            type=\"success\"\r\n            icon=\"el-icon-document\"\r\n            @click=\"exportData('pdf')\"\r\n            >导出PDF</el-button\r\n          >\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"filter-section\">\r\n        <el-form :inline=\"true\" :model=\"filterForm\" class=\"filter-form\">\r\n          <el-form-item label=\"时间范围\">\r\n            <el-select\r\n              v-model=\"filterForm.timeRange\"\r\n              placeholder=\"选择时间范围\"\r\n              @change=\"updateCharts\"\r\n            >\r\n              <el-option label=\"最近7天\" value=\"7days\"></el-option>\r\n              <el-option label=\"最近30天\" value=\"30days\"></el-option>\r\n              <el-option label=\"最近3个月\" value=\"3months\"></el-option>\r\n              <el-option label=\"最近1年\" value=\"1year\"></el-option>\r\n            </el-select>\r\n          </el-form-item>\r\n          <el-form-item label=\"科室\">\r\n            <el-select\r\n              v-model=\"filterForm.department\"\r\n              placeholder=\"选择科室\"\r\n              multiple\r\n              @change=\"updateCharts\"\r\n            >\r\n              <el-option label=\"眼科门诊\" value=\"outpatient\"></el-option>\r\n              <el-option label=\"眼科住院\" value=\"inpatient\"></el-option>\r\n              <el-option label=\"专家门诊\" value=\"expert\"></el-option>\r\n            </el-select>\r\n          </el-form-item>\r\n          <el-form-item>\r\n            <el-button type=\"primary\" @click=\"updateCharts\">应用筛选</el-button>\r\n            <el-button @click=\"resetFilter\">重置</el-button>\r\n          </el-form-item>\r\n        </el-form>\r\n      </div>\r\n\r\n      <el-row :gutter=\"20\" class=\"chart-row\">\r\n        <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n          <el-card class=\"chart-card\">\r\n            <template #header>\r\n              <div class=\"chart-header\">\r\n                <h3 class=\"section-title\">诊断趋势分析</h3>\r\n                <el-radio-group\r\n                  v-model=\"trendChartType\"\r\n                  size=\"small\"\r\n                  @change=\"updateTrendChart\"\r\n                >\r\n                  <el-radio-button label=\"daily\">日</el-radio-button>\r\n                  <el-radio-button label=\"weekly\">周</el-radio-button>\r\n                  <el-radio-button label=\"monthly\">月</el-radio-button>\r\n                </el-radio-group>\r\n              </div>\r\n            </template>\r\n            <div ref=\"trendChart\" class=\"chart-container\"></div>\r\n          </el-card>\r\n        </el-col>\r\n        <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n          <el-card class=\"chart-card\">\r\n            <template #header>\r\n              <div class=\"chart-header\">\r\n                <h3 class=\"section-title\">疾病分布分析</h3>\r\n              </div>\r\n            </template>\r\n            <div ref=\"diseaseDistributionChart\" class=\"chart-container\"></div>\r\n          </el-card>\r\n        </el-col>\r\n      </el-row>\r\n\r\n      <el-row :gutter=\"20\" class=\"chart-row\">\r\n        <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n          <el-card class=\"chart-card\">\r\n            <template #header>\r\n              <div class=\"chart-header\">\r\n                <h3 class=\"section-title\">患者年龄分布</h3>\r\n              </div>\r\n            </template>\r\n            <div ref=\"ageDistributionChart\" class=\"chart-container\"></div>\r\n          </el-card>\r\n        </el-col>\r\n        <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n          <el-card class=\"chart-card\">\r\n            <template #header>\r\n              <div class=\"chart-header\">\r\n                <h3 class=\"section-title\">患者性别分布</h3>\r\n              </div>\r\n            </template>\r\n            <div ref=\"genderDistributionChart\" class=\"chart-container\"></div>\r\n          </el-card>\r\n        </el-col>\r\n      </el-row>\r\n\r\n      <el-card class=\"anomaly-card\">\r\n        <template #header>\r\n          <div class=\"anomaly-header\">\r\n            <h3 class=\"section-title\">异常病例分析</h3>\r\n            <el-tooltip\r\n              content=\"置信度低于60%或诊断结果不一致的病例\"\r\n              placement=\"top\"\r\n            >\r\n              <i class=\"el-icon-question\"></i>\r\n            </el-tooltip>\r\n          </div>\r\n        </template>\r\n        <el-table :data=\"anomalyCases\" style=\"width: 100%\" border>\r\n          <el-table-column prop=\"id\" label=\"ID\" width=\"120\"></el-table-column>\r\n          <el-table-column\r\n            prop=\"time\"\r\n            label=\"诊断时间\"\r\n            width=\"180\"\r\n          ></el-table-column>\r\n          <el-table-column\r\n            prop=\"leftEye.diagnosis\"\r\n            label=\"左眼诊断\"\r\n            width=\"150\"\r\n          ></el-table-column>\r\n          <el-table-column\r\n            prop=\"rightEye.diagnosis\"\r\n            label=\"右眼诊断\"\r\n            width=\"150\"\r\n          ></el-table-column>\r\n          <el-table-column label=\"置信度\" width=\"180\">\r\n            <template #default=\"scope\">\r\n              <div>\r\n                <el-progress\r\n                  :percentage=\"scope.row.leftEye.confidence\"\r\n                  :format=\"percentFormat\"\r\n                  :stroke-width=\"10\"\r\n                  :color=\"getConfidenceColor(scope.row.leftEye.confidence)\"\r\n                ></el-progress>\r\n                <el-progress\r\n                  :percentage=\"scope.row.rightEye.confidence\"\r\n                  :format=\"percentFormat\"\r\n                  :stroke-width=\"10\"\r\n                  :color=\"getConfidenceColor(scope.row.rightEye.confidence)\"\r\n                ></el-progress>\r\n              </div>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column\r\n            prop=\"anomalyReason\"\r\n            label=\"异常原因\"\r\n          ></el-table-column>\r\n          <el-table-column label=\"操作\" width=\"120\">\r\n            <template #default=\"scope\">\r\n              <el-button\r\n                size=\"small\"\r\n                type=\"primary\"\r\n                @click=\"viewAnomalyDetail(scope.row)\"\r\n                >查看</el-button\r\n              >\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n      </el-card>\r\n    </div>\r\n  </app-layout>\r\n</template>\r\n\r\n<script>\r\nimport AppLayout from \"@/components/AppLayout.vue\";\r\nimport * as echarts from \"echarts\";\r\n\r\nexport default {\r\n  name: \"AnalyticsView\",\r\n  components: {\r\n    AppLayout,\r\n  },\r\n  data() {\r\n    return {\r\n      filterForm: {\r\n        timeRange: \"30days\",\r\n        department: [\"outpatient\"],\r\n      },\r\n      trendChartType: \"daily\",\r\n      charts: {\r\n        trendChart: null,\r\n        diseaseDistributionChart: null,\r\n        ageDistributionChart: null,\r\n        genderDistributionChart: null,\r\n      },\r\n      anomalyCases: [],\r\n    };\r\n  },\r\n  methods: {\r\n    updateCharts() {\r\n      this.updateTrendChart();\r\n      this.updateDiseaseDistributionChart();\r\n      this.updateAgeDistributionChart();\r\n      this.updateGenderDistributionChart();\r\n      this.updateAnomalyCases();\r\n    },\r\n\r\n    resetFilter() {\r\n      this.filterForm = {\r\n        timeRange: \"30days\",\r\n        department: [\"outpatient\"],\r\n      };\r\n      this.updateCharts();\r\n    },\r\n\r\n    percentFormat(percentage) {\r\n      return percentage + \"%\";\r\n    },\r\n\r\n    getConfidenceColor(confidence) {\r\n      if (confidence < 60) {\r\n        return \"#F56C6C\";\r\n      } else if (confidence < 80) {\r\n        return \"#E6A23C\";\r\n      } else {\r\n        return \"#67C23A\";\r\n      }\r\n    },\r\n\r\n    viewAnomalyDetail(row) {\r\n      this.$router.push(`/reports/detail/${row.id}`);\r\n    },\r\n\r\n    exportData(type) {\r\n      this.$message.success(`数据已导出为${type.toUpperCase()}格式`);\r\n    },\r\n\r\n    // 诊断趋势图表\r\n    updateTrendChart() {\r\n      if (!this.charts.trendChart) {\r\n        this.charts.trendChart = echarts.init(this.$refs.trendChart);\r\n      }\r\n\r\n      // 生成日期数据\r\n      const dates = [];\r\n      const diagnosisCounts = [];\r\n      const normalCounts = [];\r\n      const abnormalCounts = [];\r\n\r\n      let days = 30;\r\n      switch (this.filterForm.timeRange) {\r\n        case \"7days\":\r\n          days = 7;\r\n          break;\r\n        case \"30days\":\r\n          days = 30;\r\n          break;\r\n        case \"3months\":\r\n          days = 90;\r\n          break;\r\n        case \"1year\":\r\n          days = 365;\r\n          break;\r\n      }\r\n\r\n      const today = new Date();\r\n      for (let i = days - 1; i >= 0; i--) {\r\n        const date = new Date();\r\n        date.setDate(today.getDate() - i);\r\n\r\n        let dateStr;\r\n        if (this.trendChartType === \"daily\") {\r\n          dateStr = `${date.getMonth() + 1}/${date.getDate()}`;\r\n        } else if (this.trendChartType === \"weekly\") {\r\n          // 简化处理，实际应用中应该按周分组\r\n          dateStr = `第${Math.floor(i / 7) + 1}周`;\r\n        } else {\r\n          dateStr = `${date.getMonth() + 1}月`;\r\n        }\r\n\r\n        if (!dates.includes(dateStr)) {\r\n          dates.push(dateStr);\r\n\r\n          // 生成随机数据\r\n          const total = Math.floor(Math.random() * 50) + 10;\r\n          const normal = Math.floor(Math.random() * total);\r\n          const abnormal = total - normal;\r\n\r\n          diagnosisCounts.push(total);\r\n          normalCounts.push(normal);\r\n          abnormalCounts.push(abnormal);\r\n        }\r\n      }\r\n\r\n      const option = {\r\n        tooltip: {\r\n          trigger: \"axis\",\r\n          axisPointer: {\r\n            type: \"shadow\",\r\n          },\r\n        },\r\n        legend: {\r\n          data: [\"总诊断量\", \"正常\", \"异常\"],\r\n        },\r\n        grid: {\r\n          left: \"3%\",\r\n          right: \"4%\",\r\n          bottom: \"3%\",\r\n          containLabel: true,\r\n        },\r\n        xAxis: {\r\n          type: \"category\",\r\n          data: dates,\r\n        },\r\n        yAxis: {\r\n          type: \"value\",\r\n        },\r\n        series: [\r\n          {\r\n            name: \"总诊断量\",\r\n            type: \"line\",\r\n            data: diagnosisCounts,\r\n            smooth: true,\r\n            lineStyle: {\r\n              width: 3,\r\n            },\r\n          },\r\n          {\r\n            name: \"正常\",\r\n            type: \"bar\",\r\n            stack: \"total\",\r\n            data: normalCounts,\r\n            itemStyle: {\r\n              color: \"#67C23A\",\r\n            },\r\n          },\r\n          {\r\n            name: \"异常\",\r\n            type: \"bar\",\r\n            stack: \"total\",\r\n            data: abnormalCounts,\r\n            itemStyle: {\r\n              color: \"#F56C6C\",\r\n            },\r\n          },\r\n        ],\r\n      };\r\n\r\n      this.charts.trendChart.setOption(option);\r\n    },\r\n\r\n    // 疾病分布图表\r\n    updateDiseaseDistributionChart() {\r\n      if (!this.charts.diseaseDistributionChart) {\r\n        this.charts.diseaseDistributionChart = echarts.init(\r\n          this.$refs.diseaseDistr