{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport AppLayout from \"@/components/AppLayout.vue\";\nexport default {\n  name: \"ProfileView\",\n  components: {\n    AppLayout\n  },\n  data() {\n    // 确认密码的验证规则\n    const validateConfirmPassword = (rule, value, callback) => {\n      if (value !== this.passwordForm.newPassword) {\n        callback(new Error(\"两次输入的密码不一致\"));\n      } else {\n        callback();\n      }\n    };\n    return {\n      activeTab: \"info\",\n      userInfo: {\n        username: \"abc\",\n        realName: \"张医生\",\n        title: \"主任医师\",\n        department: \"眼科\",\n        phone: \"13800138000\",\n        email: \"doctor@hospital.com\",\n        avatar: \"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\"\n      },\n      rules: {\n        realName: [{\n          required: true,\n          message: \"请输入真实姓名\",\n          trigger: \"blur\"\n        }, {\n          min: 2,\n          max: 20,\n          message: \"长度在 2 到 20 个字符\",\n          trigger: \"blur\"\n        }],\n        title: [{\n          required: true,\n          message: \"请选择职称\",\n          trigger: \"change\"\n        }],\n        department: [{\n          required: true,\n          message: \"请输入科室\",\n          trigger: \"blur\"\n        }],\n        phone: [{\n          required: true,\n          message: \"请输入手机号码\",\n          trigger: \"blur\"\n        }, {\n          pattern: /^1[3-9]\\d{9}$/,\n          message: \"请输入正确的手机号码\",\n          trigger: \"blur\"\n        }],\n        email: [{\n          required: true,\n          message: \"请输入邮箱\",\n          trigger: \"blur\"\n        }, {\n          type: \"email\",\n          message: \"请输入正确的邮箱地址\",\n          trigger: \"blur\"\n        }]\n      },\n      passwordForm: {\n        currentPassword: \"\",\n        newPassword: \"\",\n        confirmPassword: \"\"\n      },\n      passwordRules: {\n        currentPassword: [{\n          required: true,\n          message: \"请输入当前密码\",\n          trigger: \"blur\"\n        }],\n        newPassword: [{\n          required: true,\n          message: \"请输入新密码\",\n          trigger: \"blur\"\n        }, {\n          min: 6,\n          message: \"密码长度不能小于6个字符\",\n          trigger: \"blur\"\n        }],\n        confirmPassword: [{\n          required: true,\n          message: \"请再次输入新密码\",\n          trigger: \"blur\"\n        }, {\n          validator: validateConfirmPassword,\n          trigger: \"blur\"\n        }]\n      },\n      settingsForm: {\n        systemNotification: true,\n        diagnosisNotification: true,\n        anomalyNotification: true,\n        language: \"zh-CN\",\n        themeColor: \"#409EFF\",\n        tablePageSize: 20\n      },\n      feedbackForm: {\n        type: \"\",\n        content: \"\",\n        contact: \"\"\n      },\n      feedbackRules: {\n        type: [{\n          required: true,\n          message: \"请选择反馈类型\",\n          trigger: \"change\"\n        }],\n        content: [{\n          required: true,\n          message: \"请输入反馈内容\",\n          trigger: \"blur\"\n        }, {\n          min: 10,\n          message: \"反馈内容不能少于10个字符\",\n          trigger: \"blur\"\n        }]\n      }\n    };\n  },\n  methods: {\n    saveUserInfo() {\n      this.$refs.userForm.validate(valid => {\n        if (valid) {\n          this.$message.success(\"个人信息保存成功\");\n        } else {\n          return false;\n        }\n      });\n    },\n    resetForm(formName) {\n      this.$refs[formName].resetFields();\n    },\n    changePassword() {\n      this.$refs.passwordForm.validate(valid => {\n        if (valid) {\n          // 模拟验证当前密码\n          if (this.passwordForm.currentPassword !== \"123456\") {\n            this.$message.error(\"当前密码不正确\");\n            return;\n          }\n          this.$message.success(\"密码修改成功，请重新登录\");\n          setTimeout(() => {\n            localStorage.removeItem(\"isLoggedIn\");\n            this.$router.push(\"/login\");\n          }, 1500);\n        } else {\n          return false;\n        }\n      });\n    },\n    saveSettings() {\n      this.$message.success(\"系统设置保存成功\");\n      // 实际应用中这里应该将设置保存到本地存储或后端\n    },\n    resetSettings() {\n      this.settingsForm = {\n        systemNotification: true,\n        diagnosisNotification: true,\n        anomalyNotification: true,\n        language: \"zh-CN\",\n        themeColor: \"#409EFF\",\n        tablePageSize: 20\n      };\n      this.$message.info(\"已恢复默认设置\");\n    },\n    submitFeedback() {\n      this.$refs.feedbackForm.validate(valid => {\n        if (valid) {\n          this.$message.success(\"感谢您的反馈，我们会尽快处理\");\n          this.resetForm(\"feedbackForm\");\n        } else {\n          return false;\n        }\n      });\n    }\n  },\n  mounted() {\n    // 检查登录状态\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\n    if (!isLoggedIn) {\n      this.$router.push(\"/login\");\n    }\n  }\n};","map":{"version":3,"names":["AppLayout","name","components","data","validateConfirmPassword","rule","value","callback","passwordForm","newPassword","Error","activeTab","userInfo","username","realName","title","department","phone","email","avatar","rules","required","message","trigger","min","max","pattern","type","currentPassword","confirmPassword","passwordRules","validator","settingsForm","systemNotification","diagnosisNotification","anomalyNotification","language","themeColor","tablePageSize","feedbackForm","content","contact","feedbackRules","methods","saveUserInfo","$refs","userForm","validate","valid","$message","success","resetForm","formName","resetFields","changePassword","error","setTimeout","localStorage","removeItem","$router","push","saveSettings","resetSettings","info","submitFeedback","mounted","isLoggedIn","getItem"],"sources":["E:\\Apollo\\Eye-Diagnose-System\\src\\views\\ProfileView.vue"],"sourcesContent":["<template>\r\n  <app-layout active-menu=\"/profile\">\r\n    <div class=\"profile-container\">\r\n      <h1 class=\"page-title\">个人中心</h1>\r\n\r\n      <el-tabs v-model=\"activeTab\" type=\"border-card\">\r\n        <el-tab-pane label=\"个人信息\" name=\"info\">\r\n          <div class=\"info-section\">\r\n            <div class=\"avatar-section\">\r\n              <el-avatar :size=\"100\" :src=\"userInfo.avatar\"></el-avatar>\r\n              <el-button type=\"primary\" size=\"small\" class=\"change-avatar-btn\"\r\n                >更换头像</el-button\r\n              >\r\n            </div>\r\n\r\n            <el-form\r\n              :model=\"userInfo\"\r\n              :rules=\"rules\"\r\n              ref=\"userForm\"\r\n              label-width=\"100px\"\r\n              class=\"user-form\"\r\n            >\r\n              <el-form-item label=\"用户名\" prop=\"username\">\r\n                <el-input v-model=\"userInfo.username\" disabled></el-input>\r\n              </el-form-item>\r\n              <el-form-item label=\"真实姓名\" prop=\"realName\">\r\n                <el-input v-model=\"userInfo.realName\"></el-input>\r\n              </el-form-item>\r\n              <el-form-item label=\"职称\" prop=\"title\">\r\n                <el-select v-model=\"userInfo.title\" placeholder=\"请选择职称\">\r\n                  <el-option label=\"主任医师\" value=\"主任医师\"></el-option>\r\n                  <el-option label=\"副主任医师\" value=\"副主任医师\"></el-option>\r\n                  <el-option label=\"主治医师\" value=\"主治医师\"></el-option>\r\n                  <el-option label=\"住院医师\" value=\"住院医师\"></el-option>\r\n                </el-select>\r\n              </el-form-item>\r\n              <el-form-item label=\"科室\" prop=\"department\">\r\n                <el-input v-model=\"userInfo.department\"></el-input>\r\n              </el-form-item>\r\n              <el-form-item label=\"手机号码\" prop=\"phone\">\r\n                <el-input v-model=\"userInfo.phone\"></el-input>\r\n              </el-form-item>\r\n              <el-form-item label=\"邮箱\" prop=\"email\">\r\n                <el-input v-model=\"userInfo.email\"></el-input>\r\n              </el-form-item>\r\n              <el-form-item>\r\n                <el-button type=\"primary\" @click=\"saveUserInfo\"\r\n                  >保存信息</el-button\r\n                >\r\n                <el-button @click=\"resetForm('userForm')\">重置</el-button>\r\n              </el-form-item>\r\n            </el-form>\r\n          </div>\r\n        </el-tab-pane>\r\n\r\n        <el-tab-pane label=\"修改密码\" name=\"password\">\r\n          <div class=\"password-section\">\r\n            <el-form\r\n              :model=\"passwordForm\"\r\n              :rules=\"passwordRules\"\r\n              ref=\"passwordForm\"\r\n              label-width=\"100px\"\r\n              class=\"password-form\"\r\n            >\r\n              <el-form-item label=\"当前密码\" prop=\"currentPassword\">\r\n                <el-input\r\n                  v-model=\"passwordForm.currentPassword\"\r\n                  type=\"password\"\r\n                  show-password\r\n                ></el-input>\r\n              </el-form-item>\r\n              <el-form-item label=\"新密码\" prop=\"newPassword\">\r\n                <el-input\r\n                  v-model=\"passwordForm.newPassword\"\r\n                  type=\"password\"\r\n                  show-password\r\n                ></el-input>\r\n              </el-form-item>\r\n              <el-form-item label=\"确认新密码\" prop=\"confirmPassword\">\r\n                <el-input\r\n                  v-model=\"passwordForm.confirmPassword\"\r\n                  type=\"password\"\r\n                  show-password\r\n                ></el-input>\r\n              </el-form-item>\r\n              <el-form-item>\r\n                <el-button type=\"primary\" @click=\"changePassword\"\r\n                  >修改密码</el-button\r\n                >\r\n                <el-button @click=\"resetForm('passwordForm')\">重置</el-button>\r\n              </el-form-item>\r\n            </el-form>\r\n          </div>\r\n        </el-tab-pane>\r\n\r\n        <el-tab-pane label=\"系统设置\" name=\"settings\">\r\n          <div class=\"settings-section\">\r\n            <h3 class=\"settings-title\">通知设置</h3>\r\n            <el-form\r\n              :model=\"settingsForm\"\r\n              label-width=\"200px\"\r\n              class=\"settings-form\"\r\n            >\r\n              <el-form-item label=\"接收系统更新通知\">\r\n                <el-switch\r\n                  v-model=\"settingsForm.systemNotification\"\r\n                ></el-switch>\r\n              </el-form-item>\r\n              <el-form-item label=\"接收诊断完成通知\">\r\n                <el-switch\r\n                  v-model=\"settingsForm.diagnosisNotification\"\r\n                ></el-switch>\r\n              </el-form-item>\r\n              <el-form-item label=\"接收异常病例提醒\">\r\n                <el-switch\r\n                  v-model=\"settingsForm.anomalyNotification\"\r\n                ></el-switch>\r\n              </el-form-item>\r\n\r\n              <h3 class=\"settings-title\">界面设置</h3>\r\n              <el-form-item label=\"语言\">\r\n                <el-select\r\n                  v-model=\"settingsForm.language\"\r\n                  placeholder=\"请选择语言\"\r\n                >\r\n                  <el-option label=\"简体中文\" value=\"zh-CN\"></el-option>\r\n                  <el-option label=\"English\" value=\"en-US\"></el-option>\r\n                </el-select>\r\n              </el-form-item>\r\n              <el-form-item label=\"主题色\">\r\n                <el-color-picker\r\n                  v-model=\"settingsForm.themeColor\"\r\n                ></el-color-picker>\r\n              </el-form-item>\r\n              <el-form-item label=\"表格默认每页显示行数\">\r\n                <el-select\r\n                  v-model=\"settingsForm.tablePageSize\"\r\n                  placeholder=\"请选择\"\r\n                >\r\n                  <el-option label=\"10行\" :value=\"10\"></el-option>\r\n                  <el-option label=\"20行\" :value=\"20\"></el-option>\r\n                  <el-option label=\"50行\" :value=\"50\"></el-option>\r\n                  <el-option label=\"100行\" :value=\"100\"></el-option>\r\n                </el-select>\r\n              </el-form-item>\r\n\r\n              <el-form-item>\r\n                <el-button type=\"primary\" @click=\"saveSettings\"\r\n                  >保存设置</el-button\r\n                >\r\n                <el-button @click=\"resetSettings\">恢复默认</el-button>\r\n              </el-form-item>\r\n            </el-form>\r\n          </div>\r\n        </el-tab-pane>\r\n\r\n        <el-tab-pane label=\"帮助与反馈\" name=\"help\">\r\n          <div class=\"help-section\">\r\n            <h3 class=\"help-title\">常见问题</h3>\r\n            <el-collapse>\r\n              <el-collapse-item title=\"如何上传眼底图像？\" name=\"1\">\r\n                <div>\r\n                  在\"即时诊断中心\"页面，您可以选择单图诊断或批量诊断模式。\r\n                  对于单图诊断，分别上传左右眼图像；对于批量诊断，系统会自动配对左右眼图像。\r\n                </div>\r\n              </el-collapse-item>\r\n              <el-collapse-item title=\"如何导出诊断报告？\" name=\"2\">\r\n                <div>\r\n                  在诊断完成后，点击\"导出报告\"按钮，系统将生成PDF格式的报告供您下载。\r\n                  您也可以在\"病例报告\"页面找到历史报告并导出。\r\n                </div>\r\n              </el-collapse-item>\r\n              <el-collapse-item title=\"系统支持哪些眼疾的识别？\" name=\"3\">\r\n                <div>\r\n                  目前系统支持以下眼疾的识别：糖尿病视网膜病变、青光眼、白内障、AMD（年龄相关性黄斑变性）、\r\n                  高血压视网膜病变、近视、其他异常，以及正常眼底的判断。\r\n                </div>\r\n              </el-collapse-item>\r\n            </el-collapse>\r\n\r\n            <h3 class=\"feedback-title\">问题反馈</h3>\r\n            <el-form\r\n              :model=\"feedbackForm\"\r\n              :rules=\"feedbackRules\"\r\n              ref=\"feedbackForm\"\r\n              class=\"feedback-form\"\r\n            >\r\n              <el-form-item label=\"反馈类型\" prop=\"type\">\r\n                <el-select\r\n                  v-model=\"feedbackForm.type\"\r\n                  placeholder=\"请选择反馈类型\"\r\n                >\r\n                  <el-option label=\"功能建议\" value=\"suggestion\"></el-option>\r\n                  <el-option label=\"系统错误\" value=\"error\"></el-option>\r\n                  <el-option label=\"诊断问题\" value=\"diagnosis\"></el-option>\r\n                  <el-option label=\"其他\" value=\"other\"></el-option>\r\n                </el-select>\r\n              </el-form-item>\r\n              <el-form-item label=\"反馈内容\" prop=\"content\">\r\n                <el-input\r\n                  type=\"textarea\"\r\n                  v-model=\"feedbackForm.content\"\r\n                  :rows=\"5\"\r\n                  placeholder=\"请详细描述您遇到的问题或建议...\"\r\n                ></el-input>\r\n              </el-form-item>\r\n              <el-form-item label=\"联系方式\" prop=\"contact\">\r\n                <el-input\r\n                  v-model=\"feedbackForm.contact\"\r\n                  placeholder=\"选填，便于我们联系您解决问题\"\r\n                ></el-input>\r\n              </el-form-item>\r\n              <el-form-item>\r\n                <el-button type=\"primary\" @click=\"submitFeedback\"\r\n                  >提交反馈</el-button\r\n                >\r\n                <el-button @click=\"resetForm('feedbackForm')\">重置</el-button>\r\n              </el-form-item>\r\n            </el-form>\r\n\r\n            <div class=\"contact-info\">\r\n              <h3>联系我们</h3>\r\n              <p>技术支持邮箱：support@eyediagnosis.com</p>\r\n              <p>客服电话：400-123-4567（工作日 9:00-18:00）</p>\r\n            </div>\r\n          </div>\r\n        </el-tab-pane>\r\n      </el-tabs>\r\n    </div>\r\n  </app-layout>\r\n</template>\r\n\r\n<script>\r\nimport AppLayout from \"@/components/AppLayout.vue\";\r\n\r\nexport default {\r\n  name: \"ProfileView\",\r\n  components: {\r\n    AppLayout,\r\n  },\r\n  data() {\r\n    // 确认密码的验证规则\r\n    const validateConfirmPassword = (rule, value, callback) => {\r\n      if (value !== this.passwordForm.newPassword) {\r\n        callback(new Error(\"两次输入的密码不一致\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n\r\n    return {\r\n      activeTab: \"info\",\r\n      userInfo: {\r\n        username: \"abc\",\r\n        realName: \"张医生\",\r\n        title: \"主任医师\",\r\n        department: \"眼科\",\r\n        phone: \"13800138000\",\r\n        email: \"doctor@hospital.com\",\r\n        avatar:\r\n          \"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\",\r\n      },\r\n      rules: {\r\n        realName: [\r\n          { required: true, message: \"请输入真实姓名\", trigger: \"blur\" },\r\n          {\r\n            min: 2,\r\n            max: 20,\r\n            message: \"长度在 2 到 20 个字符\",\r\n            trigger: \"blur\",\r\n          },\r\n        ],\r\n        title: [{ required: true, message: \"请选择职称\", trigger: \"change\" }],\r\n        department: [\r\n          { required: true, message: \"请输入科室\", trigger: \"blur\" },\r\n        ],\r\n        phone: [\r\n          { required: true, message: \"请输入手机号码\", trigger: \"blur\" },\r\n          {\r\n            pattern: /^1[3-9]\\d{9}$/,\r\n            message: \"请输入正确的手机号码\",\r\n            trigger: \"blur\",\r\n          },\r\n        ],\r\n        email: [\r\n          { required: true, message: \"请输入邮箱\", trigger: \"blur\" },\r\n          { type: \"email\", message: \"请输入正确的邮箱地址\", trigger: \"blur\" },\r\n        ],\r\n      },\r\n      passwordForm: {\r\n        currentPassword: \"\",\r\n        newPassword: \"\",\r\n        confirmPassword: \"\",\r\n      },\r\n      passwordRules: {\r\n        currentPassword: [\r\n          { required: true, message: \"请输入当前密码\", trigger: \"blur\" },\r\n        ],\r\n        newPassword: [\r\n          { required: true, message: \"请输入新密码\", trigger: \"blur\" },\r\n          { min: 6, message: \"密码长度不能小于6个字符\", trigger: \"blur\" },\r\n        ],\r\n        confirmPassword: [\r\n          { required: true, message: \"请再次输入新密码\", trigger: \"blur\" },\r\n          { validator: validateConfirmPassword, trigger: \"blur\" },\r\n        ],\r\n      },\r\n      settingsForm: {\r\n        systemNotification: true,\r\n        diagnosisNotification: true,\r\n        anomalyNotification: true,\r\n        language: \"zh-CN\",\r\n        themeColor: \"#409EFF\",\r\n        tablePageSize: 20,\r\n      },\r\n      feedbackForm: {\r\n        type: \"\",\r\n        content: \"\",\r\n        contact: \"\",\r\n      },\r\n      feedbackRules: {\r\n        type: [\r\n          { required: true, message: \"请选择反馈类型\", trigger: \"change\" },\r\n        ],\r\n        content: [\r\n          { required: true, message: \"请输入反馈内容\", trigger: \"blur\" },\r\n          { min: 10, message: \"反馈内容不能少于10个字符\", trigger: \"blur\" },\r\n        ],\r\n      },\r\n    };\r\n  },\r\n  methods: {\r\n    saveUserInfo() {\r\n      this.$refs.userForm.validate((valid) => {\r\n        if (valid) {\r\n          this.$message.success(\"个人信息保存成功\");\r\n        } else {\r\n          return false;\r\n        }\r\n      });\r\n    },\r\n\r\n    resetForm(formName) {\r\n      this.$refs[formName].resetFields();\r\n    },\r\n\r\n    changePassword() {\r\n      this.$refs.passwordForm.validate((valid) => {\r\n        if (valid) {\r\n          // 模拟验证当前密码\r\n          if (this.passwordForm.currentPassword !== \"123456\") {\r\n            this.$message.error(\"当前密码不正确\");\r\n            return;\r\n          }\r\n\r\n          this.$message.success(\"密码修改成功，请重新登录\");\r\n          setTimeout(() => {\r\n            localStorage.removeItem(\"isLoggedIn\");\r\n            this.$router.push(\"/login\");\r\n          }, 1500);\r\n        } else {\r\n          return false;\r\n        }\r\n      });\r\n    },\r\n\r\n    saveSettings() {\r\n      this.$message.success(\"系统设置保存成功\");\r\n      // 实际应用中这里应该将设置保存到本地存储或后端\r\n    },\r\n\r\n    resetSettings() {\r\n      this.settingsForm = {\r\n        systemNotification: true,\r\n        diagnosisNotification: true,\r\n        anomalyNotification: true,\r\n        language: \"zh-CN\",\r\n        themeColor: \"#409EFF\",\r\n        tablePageSize: 20,\r\n      };\r\n      this.$message.info(\"已恢复默认设置\");\r\n    },\r\n\r\n    submitFeedback() {\r\n      this.$refs.feedbackForm.validate((valid) => {\r\n        if (valid) {\r\n          this.$message.success(\"感谢您的反馈，我们会尽快处理\");\r\n          this.resetForm(\"feedbackForm\");\r\n        } else {\r\n          return false;\r\n        }\r\n      });\r\n    },\r\n  },\r\n  mounted() {\r\n    // 检查登录状态\r\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\r\n    if (!isLoggedIn) {\r\n      this.$router.push(\"/login\");\r\n    }\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.profile-container {\r\n  /* padding: 20px; */\r\n  background-color: #f5f7fa;\r\n  min-height: calc(100vh - 60px);\r\n}\r\n\r\n.profile-container el-tab-pane {\r\n  background: linear-gradient(-30deg, rgb(107, 175, 240), rgb(245, 137, 227));\r\n}\r\n\r\n.page-title {\r\n  font-size: 24px;\r\n  margin-bottom: 20px;\r\n  color: #303133;\r\n  margin-top: -5px;\r\n}\r\n\r\n/* 个人信息区域 */\r\n.info-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  padding: 20px;\r\n}\r\n\r\n.avatar-section {\r\n  height: 150px;\r\n  margin-top: -10px;\r\n  padding-top: 20px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  margin-bottom: 30px;\r\n  background: linear-gradient(135deg, #a1c4fd, #c2e9fb);\r\n  border-radius: 10px;\r\n}\r\n\r\n.change-avatar-btn {\r\n  margin-top: 10px;\r\n}\r\n\r\n.user-form {\r\n  max-width: 600px;\r\n}\r\n\r\n/* 密码修改区域 */\r\n.password-section {\r\n  padding: 20px;\r\n}\r\n\r\n.password-form {\r\n  max-width: 500px;\r\n}\r\n\r\n/* 系统设置区域 */\r\n.settings-section {\r\n  padding: 20px;\r\n}\r\n\r\n.settings-title {\r\n  margin: 20px 0 15px;\r\n  padding-bottom: 10px;\r\n  border-bottom: 1px solid #ebeef5;\r\n  color: #303133;\r\n}\r\n\r\n.settings-title {\r\n  position: relative;\r\n  padding-left: 13px;\r\n  margin: 24px 0px;\r\n}\r\n\r\n.settin