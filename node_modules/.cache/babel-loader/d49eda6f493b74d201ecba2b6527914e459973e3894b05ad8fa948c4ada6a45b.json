{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport AppLayout from \"@/components/AppLayout.vue\";\nimport { View as ViewIcon, Upload as UploadIcon, Clock as ClockIcon, Calendar } from \"@element-plus/icons-vue\";\nexport default {\n  name: \"DashboardView\",\n  components: {\n    AppLayout,\n    ViewIcon,\n    UploadIcon,\n    ClockIcon,\n    Calendar\n  },\n  data() {\n    return {\n      stats: {\n        todayDiagnosis: 286,\n        diagnosisTrend: 12.5,\n        totalDiagnosis: 15769,\n        totalDiagnosisTrend: 8.2,\n        totalCases: 28456,\n        totalCasesTrend: 15.3,\n        newPatients: 342,\n        newPatientsTrend: -5.8,\n        diagnosisChartData: [30, 40, 35, 50, 49, 60, 70, 91, 125, 160, 180, 210, 220, 182, 191, 234, 290, 330, 310, 286],\n        totalDiagnosisChartData: [1000, 1200, 1500, 2000, 3000, 3500, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12000, 13000, 14000, 15000, 15500, 15769],\n        totalCasesChartData: [800, 1000, 1500, 3000, 4000, 5000, 6000, 8000, 10000, 12000, 14000, 16000, 18000, 20000, 22000, 24000, 26000, 27000, 28000, 28456],\n        newPatientsChartData: [20, 32, 41, 50, 60, 70, 80, 90, 100, 110, 120, 130, 140, 150, 160, 170, 180, 190, 200, 342]\n      },\n      caseTags: [{\n        name: \"糖尿病视网膜病变\",\n        count: 156,\n        size: 18,\n        type: \"danger\"\n      }, {\n        name: \"青光眼\",\n        count: 98,\n        size: 16,\n        type: \"danger\"\n      }, {\n        name: \"白内障\",\n        count: 124,\n        size: 17,\n        type: \"warning\"\n      }, {\n        name: \"AMD\",\n        count: 76,\n        size: 15,\n        type: \"danger\"\n      }, {\n        name: \"高血压视网膜病变\",\n        count: 85,\n        size: 16,\n        type: \"warning\"\n      }, {\n        name: \"近视\",\n        count: 210,\n        size: 20,\n        type: \"info\"\n      }, {\n        name: \"其他异常\",\n        count: 45,\n        size: 14,\n        type: \"\"\n      }, {\n        name: \"正常\",\n        count: 192,\n        size: 19,\n        type: \"success\"\n      }],\n      typicalCases: [{\n        id: \"5\",\n        diagnosis: \"糖尿病视网膜病变\",\n        image: \"https://pic3.zhimg.com/100/v2-32577c3202d56d08d1a897d402b000fe_qhd.jpg\",\n        time: \"2023-06-15\",\n        status: \"已确诊\",\n        statusType: \"danger\"\n      }, {\n        id: \"30\",\n        diagnosis: \"青光眼\",\n        image: \"https://pic4.zhimg.com/100/v2-113776afcd6e82ed437c1418a858de73_r.jpg\",\n        time: \"2023-06-14\",\n        status: \"待复查\",\n        statusType: \"warning\"\n      }, {\n        id: \"1\",\n        diagnosis: \"正常\",\n        image: \"https://picx.zhimg.com/100/v2-f2c50c067ae00c9b43f986154bb67571_qhd.jpg\",\n        time: \"2023-06-13\",\n        status: \"已确认\",\n        statusType: \"success\"\n      }, {\n        id: \"43\",\n        diagnosis: \"AMD\",\n        image: \"https://pic4.zhimg.com/100/v2-5302a9dbdbb19f1dfaa95b558d118627_qhd.jpg\",\n        time: \"2023-06-12\",\n        status: \"已确诊\",\n        statusType: \"danger\"\n      }, {\n        id: \"24\",\n        diagnosis: \"白内障\",\n        image: \"https://pic1.zhimg.com/100/v2-d04bdd5e33b48f27f74e7740195948f0_qhd.jpg\",\n        time: \"2023-06-11\",\n        status: \"待复查\",\n        statusType: \"warning\"\n      }, {\n        id: \"11\",\n        diagnosis: \"高血压视网膜病变\",\n        image: \"https://pic2.zhimg.com/100/v2-639282668941b1c31fc42d778d02fc1d_qhd.jpg\",\n        time: \"2023-06-10\",\n        status: \"已确诊\",\n        statusType: \"danger\"\n      }],\n      complianceDocs: [{\n        title: \"眼底图像采集规范V2.1\",\n        description: \"最新版眼底图像采集标准与操作指南\"\n      }, {\n        title: \"医疗数据保密协议\",\n        description: \"患者数据处理与保密规范\"\n      }, {\n        title: \"诊断报告标准模板\",\n        description: \"标准化眼底疾病诊断报告模板\"\n      }],\n      references: [{\n        title: \"基于深度学习的糖尿病视网膜病变自动检测\",\n        authors: \"张三, 李四, 王五\",\n        journal: \"中华眼科杂志, 2023\"\n      }, {\n        title: \"眼底图像分析在青光眼早期诊断中的应用\",\n        authors: \"刘一, 陈二\",\n        journal: \"临床眼科杂志, 2022\"\n      }, {\n        title: \"人工智能辅助眼底疾病诊断的研究进展\",\n        authors: \"赵六, 孙七\",\n        journal: \"国际眼科学杂志, 2023\"\n      }],\n      dateStr: \"\",\n      timeStr: \"\",\n      weekDays: [\"星期日\", \"星期一\", \"星期二\", \"星期三\", \"星期四\", \"星期五\", \"星期六\"],\n      timerID: null\n    };\n  },\n  methods: {\n    navigateTo(path) {\n      this.$router.push(path);\n    },\n    updateDateTime() {\n      const now = new Date();\n      // 格式化日期：年月日 星期几\n      const year = now.getFullYear();\n      const month = (now.getMonth() + 1).toString().padStart(2, \"0\");\n      const day = now.getDate().toString().padStart(2, \"0\");\n      const weekDay = this.weekDays[now.getDay()];\n      this.dateStr = `${year}年${month}月${day}日 ${weekDay}`;\n\n      // 格式化时间：时:分:秒\n      const hours = now.getHours().toString().padStart(2, \"0\");\n      const minutes = now.getMinutes().toString().padStart(2, \"0\");\n      const seconds = now.getSeconds().toString().padStart(2, \"0\");\n      this.timeStr = `${hours}:${minutes}:${seconds}`;\n    },\n    initCharts() {\n      this.initTrendChart(\"todayDiagnosisChart\", this.stats.diagnosisChartData, \"#409EFF\");\n      this.initTrendChart(\"totalDiagnosisChart\", this.stats.totalDiagnosisChartData, \"#409EFF\");\n      this.initTrendChart(\"totalCasesChart\", this.stats.totalCasesChartData, \"#409EFF\");\n      this.initTrendChart(\"newPatientsChart\", this.stats.newPatientsChartData, this.stats.newPatientsTrend > 0 ? \"#67C23A\" : \"#F56C6C\");\n    },\n    initTrendChart(refName, data, color) {\n      const chartDom = this.$refs[refName];\n      const myChart = this.$echarts.init(chartDom);\n      const option = {\n        grid: {\n          left: 0,\n          right: 0,\n          top: 0,\n          bottom: 0\n        },\n        xAxis: {\n          type: \"category\",\n          show: false,\n          boundaryGap: false\n        },\n        yAxis: {\n          type: \"value\",\n          show: false\n        },\n        series: [{\n          data: data,\n          type: \"line\",\n          smooth: true,\n          symbol: \"none\",\n          areaStyle: {\n            color: {\n              type: \"linear\",\n              x: 0,\n              y: 0,\n              x2: 0,\n              y2: 1,\n              colorStops: [{\n                offset: 0,\n                color: color // 渐变起始颜色\n              }, {\n                offset: 1,\n                color: \"rgba(255, 255, 255, 0.1)\" // 渐变结束颜色\n              }]\n            }\n          },\n          lineStyle: {\n            color: color\n          }\n        }]\n      };\n      myChart.setOption(option);\n\n      // 保存图表实例以便在窗口大小变化时重新渲染\n      if (!this.charts) {\n        this.charts = {};\n      }\n      this.charts[refName] = myChart;\n    },\n    handleResize() {\n      if (this.charts) {\n        Object.values(this.charts).forEach(chart => {\n          chart.resize();\n        });\n      }\n    }\n  },\n  mounted() {\n    // 检查登录状态\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\n    if (!isLoggedIn) {\n      this.$router.push(\"/login\");\n    }\n\n    // 初始化当前时间\n    this.updateDateTime();\n\n    // 初始化图表\n    this.$nextTick(() => {\n      this.initCharts();\n\n      // 添加窗口大小变化监听\n      window.addEventListener(\"resize\", this.handleResize);\n    });\n\n    // 启动时间更新\n    this.timerID = setInterval(this.updateDateTime, 1000);\n  },\n  beforeUnmount() {\n    // 移除窗口大小变化监听\n    window.removeEventListener(\"resize\", this.handleResize);\n\n    // 销毁图表实例\n    if (this.charts) {\n      Object.values(this.charts).forEach(chart => {\n        chart.dispose();\n      });\n    }\n\n    // 清理定时器\n    clearInterval(this.timerID);\n  }\n};","map":{"version":3,"names":["AppLayout","View","ViewIcon","Upload","UploadIcon","Clock","ClockIcon","Calendar","name","components","data","stats","todayDiagnosis","diagnosisTrend","totalDiagnosis","totalDiagnosisTrend","totalCases","totalCasesTrend","newPatients","newPatientsTrend","diagnosisChartData","totalDiagnosisChartData","totalCasesChartData","newPatientsChartData","caseTags","count","size","type","typicalCases","id","diagnosis","image","time","status","statusType","complianceDocs","title","description","references","authors","journal","dateStr","timeStr","weekDays","timerID","methods","navigateTo","path","$router","push","updateDateTime","now","Date","year","getFullYear","month","getMonth","toString","padStart","day","getDate","weekDay","getDay","hours","getHours","minutes","getMinutes","seconds","getSeconds","initCharts","initTrendChart","refName","color","chartDom","$refs","myChart","$echarts","init","option","grid","left","right","top","bottom","xAxis","show","boundaryGap","yAxis","series","smooth","symbol","areaStyle","x","y","x2","y2","colorStops","offset","lineStyle","setOption","charts","handleResize","Object","values","forEach","chart","resize","mounted","isLoggedIn","localStorage","getItem","$nextTick","window","addEventListener","setInterval","beforeUnmount","removeEventListener","dispose","clearInterval"],"sources":["E:\\Apollo\\Eye-Diagnose-System\\src\\views\\DashboardView.vue"],"sourcesContent":["<template>\r\n  <app-layout active-menu=\"/dashboard\">\r\n    <div class=\"dashboard-container\">\r\n      <!-- 系统时间区域 -->\r\n      <div class=\"system-time-section\">\r\n        <div class=\"time-display\">\r\n          <div class=\"time-icon\">\r\n            <el-icon><Calendar /></el-icon>\r\n          </div>\r\n          <div class=\"time-info\">\r\n            <div class=\"date-display\">{{ dateStr }}</div>\r\n            <div class=\"time-display-text\">{{ timeStr }}</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 系统概览区域 -->\r\n      <div class=\"overview-section\">\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"6\">\r\n            <el-card\r\n              class=\"stat-card\"\r\n              :body-style=\"{ backgroundColor: '#E6F7FF' }\"\r\n            >\r\n              <div class=\"stat-content\">\r\n                <div class=\"stat-left\">\r\n                  <div class=\"stat-title\">今日诊断次数</div>\r\n                  <div class=\"stat-value\">{{ stats.todayDiagnosis }}</div>\r\n                  <div class=\"stat-trend\">\r\n                    <span :class=\"stats.diagnosisTrend > 0 ? 'up' : 'down'\">\r\n                      {{ stats.diagnosisTrend > 0 ? \"+\" : \"\"\r\n                      }}{{ stats.diagnosisTrend }}%\r\n                    </span>\r\n                    较昨日\r\n                  </div>\r\n                </div>\r\n                <div class=\"stat-chart\" ref=\"todayDiagnosisChart\"></div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"6\">\r\n            <el-card\r\n              class=\"stat-card\"\r\n              :body-style=\"{ backgroundColor: '#E6FFFB' }\"\r\n            >\r\n              <div class=\"stat-content\">\r\n                <div class=\"stat-left\">\r\n                  <div class=\"stat-title\">累计诊断量</div>\r\n                  <div class=\"stat-value\">{{ stats.totalDiagnosis }}</div>\r\n                  <div class=\"stat-trend\">\r\n                    <span class=\"up\">+{{ stats.totalDiagnosisTrend }}%</span>\r\n                    较上月\r\n                  </div>\r\n                </div>\r\n                <div class=\"stat-chart\" ref=\"totalDiagnosisChart\"></div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"6\">\r\n            <el-card\r\n              class=\"stat-card\"\r\n              :body-style=\"{ backgroundColor: '#FFF7E6' }\"\r\n            >\r\n              <div class=\"stat-content\">\r\n                <div class=\"stat-left\">\r\n                  <div class=\"stat-title\">病例总数</div>\r\n                  <div class=\"stat-value\">{{ stats.totalCases }}</div>\r\n                  <div class=\"stat-trend\">\r\n                    <span class=\"up\">+{{ stats.totalCasesTrend }}%</span>\r\n                    较上月\r\n                  </div>\r\n                </div>\r\n                <div class=\"stat-chart\" ref=\"totalCasesChart\"></div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"6\">\r\n            <el-card\r\n              class=\"stat-card\"\r\n              :body-style=\"{ backgroundColor: '#F6FFED' }\"\r\n            >\r\n              <div class=\"stat-content\">\r\n                <div class=\"stat-left\">\r\n                  <div class=\"stat-title\">今日新增患者</div>\r\n                  <div class=\"stat-value\">{{ stats.newPatients }}</div>\r\n                  <div class=\"stat-trend\">\r\n                    <span :class=\"stats.newPatientsTrend > 0 ? 'up' : 'down'\">\r\n                      {{ stats.newPatientsTrend > 0 ? \"+\" : \"\"\r\n                      }}{{ stats.newPatientsTrend }}%\r\n                    </span>\r\n                    较昨日\r\n                  </div>\r\n                </div>\r\n                <div class=\"stat-chart\" ref=\"newPatientsChart\"></div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n\r\n      <!-- 快速操作区域 -->\r\n      <div class=\"quick-actions-section\">\r\n        <h2 class=\"section-title\">快速操作</h2>\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"8\">\r\n            <el-card class=\"action-card\" @click=\"navigateTo('/diagnosis')\">\r\n              <div class=\"action-icon\">\r\n                <el-icon class=\"custom-icon\"><ViewIcon /></el-icon>\r\n              </div>\r\n              <div class=\"action-title\">单图诊断</div>\r\n              <div class=\"action-desc\">上传左右眼图像进行单次诊断</div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"8\">\r\n            <el-card\r\n              class=\"action-card\"\r\n              @click=\"navigateTo('/diagnosis?tab=batch')\"\r\n            >\r\n              <div class=\"action-icon\">\r\n                <el-icon class=\"custom-icon\"><UploadIcon /></el-icon>\r\n              </div>\r\n              <div class=\"action-title\">批量诊断</div>\r\n              <div class=\"action-desc\">上传多组眼底图像进行批量处理</div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"8\">\r\n            <el-card class=\"action-card\" @click=\"navigateTo('/reports')\">\r\n              <div class=\"action-icon\">\r\n                <el-icon class=\"custom-icon\"><ClockIcon /></el-icon>\r\n              </div>\r\n              <div class=\"action-title\">历史记录</div>\r\n              <div class=\"action-desc\">查看历史诊断记录和报告</div>\r\n            </el-card>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n\r\n      <!-- 病例展示区域 -->\r\n      <div class=\"cases-section\">\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"8\">\r\n            <h2 class=\"section-title\">病例标签</h2>\r\n            <el-card class=\"tag-cloud-card\">\r\n              <div class=\"tag-cloud\">\r\n                <el-tag\r\n                  v-for=\"tag in caseTags\"\r\n                  :key=\"tag.name\"\r\n                  :type=\"tag.type\"\r\n                  effect=\"plain\"\r\n                  :style=\"{ fontSize: tag.size + 'px' }\"\r\n                  class=\"case-tag\"\r\n                >\r\n                  {{ tag.name }} ({{ tag.count }})\r\n                </el-tag>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"16\">\r\n            <h2 class=\"section-title\">典型病例</h2>\r\n            <el-row :gutter=\"20\">\r\n              <el-col\r\n                :xs=\"24\"\r\n                :sm=\"12\"\r\n                :lg=\"8\"\r\n                v-for=\"(item, index) in typicalCases\"\r\n                :key=\"index\"\r\n              >\r\n                <el-card class=\"case-card\" shadow=\"hover\">\r\n                  <div class=\"case-image\">\r\n                    <img :src=\"item.image\" alt=\"眼底图像\" />\r\n                  </div>\r\n                  <div class=\"case-info\">\r\n                    <div class=\"case-title\">{{ item.diagnosis }}</div>\r\n                    <div class=\"case-meta\">\r\n                      <span class=\"case-id\">ID: {{ item.id }}</span>\r\n                      <span class=\"case-time\">{{ item.time }}</span>\r\n                    </div>\r\n                    <el-tag size=\"small\" :type=\"item.statusType\">{{\r\n                      item.status\r\n                    }}</el-tag>\r\n                  </div>\r\n                </el-card>\r\n              </el-col>\r\n            </el-row>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n\r\n      <!-- 资源中心 -->\r\n      <div class=\"resources-section\">\r\n        <h2 class=\"section-title\">资源中心</h2>\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"12\">\r\n            <el-card class=\"resource-card\">\r\n              <template #header>\r\n                <div class=\"resource-header\">\r\n                  <span>合规文档下载中心</span>\r\n                  <el-button type=\"text\">查看全部</el-button>\r\n                </div>\r\n              </template>\r\n              <div class=\"resource-list\">\r\n                <div\r\n                  v-for=\"(doc, index) in complianceDocs\"\r\n                  :key=\"index\"\r\n                  class=\"resource-item\"\r\n                >\r\n                  <div class=\"resource-info\">\r\n                    <div class=\"resource-title\">{{ doc.title }}</div>\r\n                    <div class=\"resource-desc\">{{ doc.description }}</div>\r\n                  </div>\r\n                  <el-button type=\"primary\" size=\"small\" icon=\"el-icon-download\"\r\n                    >下载</el-button\r\n                  >\r\n                </div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\">\r\n            <el-card class=\"resource-card\">\r\n              <template #header>\r\n                <div class=\"resource-header\">\r\n                  <span>医学参考文献库</span>\r\n                  <el-button type=\"text\">查看全部</el-button>\r\n                </div>\r\n              </template>\r\n              <div class=\"resource-list\">\r\n                <div\r\n                  v-for=\"(ref, index) in references\"\r\n                  :key=\"index\"\r\n                  class=\"resource-item\"\r\n                >\r\n                  <div class=\"resource-info\">\r\n                    <div class=\"resource-title\">{{ ref.title }}</div>\r\n                    <div class=\"resource-desc\">\r\n                      {{ ref.authors }} - {{ ref.journal }}\r\n                    </div>\r\n                  </div>\r\n                  <el-button type=\"primary\" size=\"small\" icon=\"el-icon-view\"\r\n                    >查看</el-button\r\n                  >\r\n                </div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n    </div>\r\n  </app-layout>\r\n</template>\r\n\r\n<script>\r\nimport AppLayout from \"@/components/AppLayout.vue\";\r\nimport {\r\n  View as ViewIcon,\r\n  Upload as UploadIcon,\r\n  Clock as ClockIcon,\r\n  Calendar,\r\n} from \"@element-plus/icons-vue\";\r\n\r\nexport default {\r\n  name: \"DashboardView\",\r\n  components: {\r\n    AppLayout,\r\n    ViewIcon,\r\n    UploadIcon,\r\n    ClockIcon,\r\n    Calendar,\r\n  },\r\n  data() {\r\n    return {\r\n      stats: {\r\n        todayDiagnosis: 286,\r\n        diagnosisTrend: 12.5,\r\n        totalDiagnosis: 15769,\r\n        totalDiagnosisTrend: 8.2,\r\n        totalCases: 28456,\r\n        totalCasesTrend: 15.3,\r\n        newPatients: 342,\r\n        newPatientsTrend: -5.8,\r\n        diagnosisChartData: [\r\n          30, 40, 35, 50, 49, 60, 70, 91, 125, 160, 180, 210, 220, 182, 191,\r\n          234, 290, 330, 310, 286,\r\n        ],\r\n        totalDiagnosisChartData: [\r\n          1000, 1200, 1500, 2000, 3000, 3500, 4000, 5000, 6000, 7000, 8000,\r\n          9000, 10000, 11000, 12000, 13000, 14000, 15000, 15500, 15769,\r\n        ],\r\n        totalCasesChartData: [\r\n          800, 1000, 1500, 3000, 4000, 5000, 6000, 8000, 10000, 12000, 14000,\r\n          16000, 18000, 20000, 22000, 24000, 26000, 27000, 28000, 28456,\r\n        ],\r\n        newPatientsChartData: [\r\n          20, 32, 41, 50, 60, 70, 80, 90, 100, 110, 120, 130, 140, 150, 160,\r\n          170, 180, 190, 200, 342,\r\n        ],\r\n      },\r\n      caseTags: [\r\n        { name: \"糖尿病视网膜病变\", count: 156, size: 18, type: \"danger\" },\r\n        { name: \"青光眼\", count: 98, size: 16, type: \"danger\" },\r\n        { name: \"白内障\", count: 124, size: 17, type: \"warning\" },\r\n        { name: \"AMD\", count: 76, size: 15, type: \"danger\" },\r\n        { name: \"高血压视网膜病变\", count: 85, size: 16, type: \"warning\" },\r\n        { name: \"近视\", count: 210, size: 20, type: \"info\" },\r\n        { name: \"其他异常\", count: 45, size: 14, type: \"\" },\r\n        { name: \"正常\", count: 192, size: 19, type: \"success\" },\r\n      ],\r\n      typicalCases: [\r\n        {\r\n          id: \"5\",\r\n          diagnosis: \"糖尿病视网膜病变\",\r\n          image:\r\n            \"https://pic3.zhimg.com/100/v2-32577c3202d56d08d1a897d402b000fe_qhd.jpg\",\r\n          time: \"2023-06-15\",\r\n          status: \"已确诊\",\r\n          statusType: \"danger\",\r\n        },\r\n        {\r\n          id: \"30\",\r\n          diagnosis: \"青光眼\",\r\n          image:\