{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport AppLayout from \"@/components/AppLayout.vue\";\nimport request from \"@/utils/axios\"; // 导入axios实例\n\nexport default {\n  name: \"ReportsView\",\n  components: {\n    AppLayout\n  },\n  data() {\n    return {\n      activeTab: \"list\",\n      loading: false,\n      reports: [],\n      selectedReports: [],\n      filterForm: {\n        dateRange: [],\n        diseaseType: \"\",\n        confidenceRange: [0, 100]\n      },\n      diseaseOptions: [{\n        value: \"糖尿病视网膜病变\",\n        label: \"糖尿病视网膜病变\"\n      }, {\n        value: \"青光眼\",\n        label: \"青光眼\"\n      }, {\n        value: \"白内障\",\n        label: \"白内障\"\n      }, {\n        value: \"AMD\",\n        label: \"AMD\"\n      }, {\n        value: \"高血压视网膜病变\",\n        label: \"高血压视网膜病变\"\n      }, {\n        value: \"近视\",\n        label: \"近视\"\n      }, {\n        value: \"其他异常\",\n        label: \"其他异常\"\n      }, {\n        value: \"正常\",\n        label: \"正常\"\n      }],\n      pageSize: 10,\n      currentPage: 1,\n      tableHeight: 500,\n      totalReports: 0,\n      queryParams: {\n        beginTime: \"\",\n        endTime: \"\",\n        diagnosisType: \"\",\n        page: 1,\n        pageSize: 10\n      }\n    };\n  },\n  computed: {\n    filteredReports() {\n      return this.reports;\n    },\n    groupedReports() {\n      // 按日期分组报告\n      const groups = {};\n      this.reports.forEach(report => {\n        const date = new Date(report.diagnosisTime).toLocaleDateString();\n        if (!groups[date]) {\n          groups[date] = [];\n        }\n        groups[date].push(report);\n      });\n\n      // 按日期降序排序\n      return Object.keys(groups).sort((a, b) => new Date(b) - new Date(a)).reduce((obj, key) => {\n        obj[key] = groups[key];\n        return obj;\n      }, {});\n    }\n  },\n  methods: {\n    formatConfidence(val) {\n      return val + \"%\";\n    },\n    async applyFilter() {\n      this.currentPage = 1;\n      this.loading = true;\n\n      // 设置查询参数\n      if (this.filterForm.dateRange && this.filterForm.dateRange.length === 2) {\n        // 格式化日期为API所需的格式（YYYY-MM-DD）\n        const startDate = new Date(this.filterForm.dateRange[0]);\n        const endDate = new Date(this.filterForm.dateRange[1]);\n        this.queryParams.beginTime = startDate.toISOString().split(\"T\")[0];\n        this.queryParams.endTime = endDate.toISOString().split(\"T\")[0];\n      } else {\n        this.queryParams.beginTime = \"\";\n        this.queryParams.endTime = \"\";\n      }\n      this.queryParams.diagnosisType = this.filterForm.diseaseType || \"\";\n      this.queryParams.page = this.currentPage;\n      this.queryParams.pageSize = this.pageSize;\n      await this.fetchDiagnosisRecords();\n    },\n    resetFilter() {\n      this.filterForm = {\n        dateRange: [],\n        diseaseType: \"\",\n        confidenceRange: [0, 100]\n      };\n      this.currentPage = 1;\n\n      // 重置查询参数\n      this.queryParams = {\n        beginTime: \"\",\n        endTime: \"\",\n        diagnosisType: \"\",\n        page: 1,\n        pageSize: this.pageSize\n      };\n      this.fetchDiagnosisRecords();\n    },\n    handleSelectionChange(selection) {\n      this.selectedReports = selection;\n    },\n    async handleSizeChange(size) {\n      this.pageSize = size;\n      this.queryParams.pageSize = size;\n      this.currentPage = 1;\n      this.queryParams.page = 1;\n      await this.fetchDiagnosisRecords();\n    },\n    async handleCurrentChange(page) {\n      this.currentPage = page;\n      this.queryParams.page = page;\n      await this.fetchDiagnosisRecords();\n    },\n    viewReportDetail(report) {\n      this.$router.push(`/reports/detail/${report.patientId}`);\n    },\n    exportReport(report) {\n      this.$message.success(`报告 ${report.id} 已导出为PDF文件`);\n    },\n    batchExport() {\n      this.$message.success(`已导出 ${this.selectedReports.length} 份报告`);\n    },\n    batchArchive() {\n      this.$confirm(\"确定要归档选中的报告吗?\", \"提示\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\"\n      }).then(() => {\n        this.$message.success(`已归档 ${this.selectedReports.length} 份报告`);\n        // 从列表中移除已归档的报告\n        const ids = this.selectedReports.map(report => report.id);\n        this.reports = this.reports.filter(report => !ids.includes(report.id));\n        this.selectedReports = [];\n      }).catch(() => {\n        // 取消操作\n      });\n    },\n    getTagType(diagnosis) {\n      // 根据诊断结果返回不同的标签类型\n      switch (diagnosis) {\n        case \"正常\":\n          return \"success\";\n        case \"糖尿病视网膜病变\":\n        case \"青光眼\":\n        case \"AMD\":\n          return \"danger\";\n        case \"白内障\":\n        case \"高血压视网膜病变\":\n          return \"warning\";\n        case \"近视\":\n          return \"info\";\n        default:\n          return \"\";\n      }\n    },\n    // 调整表格高度\n    adjustTableHeight() {\n      this.tableHeight = window.innerHeight - 350; // 根据页面其他元素高度调整\n    },\n    // 获取诊断记录数据\n    async fetchDiagnosisRecords() {\n      this.loading = true;\n      try {\n        const response = await request({\n          method: \"get\",\n          url: \"/diagnosisrecord/show/page\",\n          params: this.queryParams\n        });\n        if (response.code === 1) {\n          // 更新数据\n          this.reports = this.formatReports(response.data.records || []);\n          this.totalReports = response.data.total || 0;\n        } else {\n          this.$message.error(response.msg || \"获取诊断记录失败\");\n        }\n      } catch (error) {\n        console.error(\"获取诊断记录出错:\", error);\n        this.$message.error(\"获取诊断记录失败，请稍后重试\");\n      } finally {\n        this.loading = false;\n      }\n    },\n    // 格式化报告数据，增加计算属性和UI所需字段\n    formatReports(records) {\n      return records.map(record => {\n        // 处理置信度，将0-1范围转换为0-100\n        const leftConfidence = record.leftConfidence ? Math.round(record.leftConfidence * 100) : 0;\n        const rightConfidence = record.rightConfidence ? Math.round(record.rightConfidence * 100) : 0;\n        return {\n          ...record,\n          leftEye: {\n            diagnosis: record.leftResult || \"\",\n            confidence: leftConfidence\n          },\n          rightEye: {\n            diagnosis: record.rightResult || \"\",\n            confidence: rightConfidence\n          },\n          finalDiagnosis: record.finalResult || \"\",\n          time: record.diagnosisTime // 保持兼容性\n        };\n      });\n    }\n  },\n  async mounted() {\n    // 检查登录状态\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\n    if (!isLoggedIn) {\n      this.$router.push(\"/login\");\n    }\n\n    // 调整表格高度\n    this.adjustTableHeight();\n    window.addEventListener(\"resize\", this.adjustTableHeight);\n\n    // 初始化时获取数据\n    await this.fetchDiagnosisRecords();\n  },\n  beforeUnmount() {\n    window.removeEventListener(\"resize\", this.adjustTableHeight);\n  }\n};","map":{"version":3,"names":["AppLayout","request","name","components","data","activeTab","loading","reports","selectedReports","filterForm","dateRange","diseaseType","confidenceRange","diseaseOptions","value","label","pageSize","currentPage","tableHeight","totalReports","queryParams","beginTime","endTime","diagnosisType","page","computed","filteredReports","groupedReports","groups","forEach","report","date","Date","diagnosisTime","toLocaleDateString","push","Object","keys","sort","a","b","reduce","obj","key","methods","formatConfidence","val","applyFilter","length","startDate","endDate","toISOString","split","fetchDiagnosisRecords","resetFilter","handleSelectionChange","selection","handleSizeChange","size","handleCurrentChange","viewReportDetail","$router","patientId","exportReport","$message","success","id","batchExport","batchArchive","$confirm","confirmButtonText","cancelButtonText","type","then","ids","map","filter","includes","catch","getTagType","diagnosis","adjustTableHeight","window","innerHeight","response","method","url","params","code","formatReports","records","total","error","msg","console","record","leftConfidence","Math","round","rightConfidence","leftEye","leftResult","confidence","rightEye","rightResult","finalDiagnosis","finalResult","time","mounted","isLoggedIn","localStorage","getItem","addEventListener","beforeUnmount","removeEventListener"],"sources":["E:\\Apollo\\Eye-Diagnose-System\\src\\views\\ReportsView.vue"],"sourcesContent":["<template>\r\n  <app-layout active-menu=\"/reports\">\r\n    <div class=\"reports-container\">\r\n      <h1 class=\"page-title\">病例报告管理</h1>\r\n\r\n      <div class=\"filter-section\">\r\n        <el-form :inline=\"true\" :model=\"filterForm\" class=\"filter-form\">\r\n          <el-form-item label=\"日期范围\">\r\n            <el-date-picker\r\n              v-model=\"filterForm.dateRange\"\r\n              type=\"daterange\"\r\n              range-separator=\"至\"\r\n              start-placeholder=\"开始日期\"\r\n              end-placeholder=\"结束日期\"\r\n              format=\"YYYY-MM-DD\"\r\n              value-format=\"YYYY-MM-DD\"\r\n              :default-time=\"['00:00:00', '23:59:59']\"\r\n            ></el-date-picker>\r\n          </el-form-item>\r\n          <el-form-item label=\"疾病类型\">\r\n            <el-select\r\n              v-model=\"filterForm.diseaseType\"\r\n              placeholder=\"请选择\"\r\n              clearable\r\n            >\r\n              <el-option\r\n                v-for=\"item in diseaseOptions\"\r\n                :key=\"item.value\"\r\n                :label=\"item.label\"\r\n                :value=\"item.value\"\r\n              ></el-option>\r\n            </el-select>\r\n          </el-form-item>\r\n\r\n          <el-form-item>\r\n            <el-button type=\"primary\" @click=\"applyFilter\">应用筛选</el-button>\r\n            <el-button @click=\"resetFilter\">重置</el-button>\r\n          </el-form-item>\r\n        </el-form>\r\n      </div>\r\n\r\n      <div class=\"reports-section\">\r\n        <el-tabs v-model=\"activeTab\" type=\"card\">\r\n          <el-tab-pane label=\"列表视图\" name=\"list\">\r\n            <el-table\r\n              :data=\"filteredReports\"\r\n              style=\"width: 100%\"\r\n              border\r\n              :height=\"tableHeight\"\r\n              v-loading=\"loading\"\r\n              @selection-change=\"handleSelectionChange\"\r\n            >\r\n              <el-table-column type=\"selection\" width=\"55\"></el-table-column>\r\n              <el-table-column\r\n                prop=\"id\"\r\n                label=\"ID\"\r\n                width=\"120\"\r\n                sortable\r\n              ></el-table-column>\r\n              <el-table-column\r\n                prop=\"diagnosisTime\"\r\n                label=\"诊断时间\"\r\n                width=\"180\"\r\n                sortable\r\n              ></el-table-column>\r\n              <el-table-column\r\n                prop=\"leftEye.diagnosis\"\r\n                label=\"左眼诊断\"\r\n                width=\"180\"\r\n              ></el-table-column>\r\n              <el-table-column\r\n                prop=\"rightEye.diagnosis\"\r\n                label=\"右眼诊断\"\r\n                width=\"180\"\r\n              ></el-table-column>\r\n              <el-table-column\r\n                prop=\"finalDiagnosis\"\r\n                label=\"综合诊断\"\r\n              ></el-table-column>\r\n              <el-table-column label=\"置信度\" width=\"180\">\r\n                <template #default=\"scope\">\r\n                  <div>\r\n                    <div>左眼: {{ scope.row.leftEye.confidence }}%</div>\r\n                    <div>右眼: {{ scope.row.rightEye.confidence }}%</div>\r\n                  </div>\r\n                </template>\r\n              </el-table-column>\r\n              <el-table-column label=\"操作\" width=\"200\" fixed=\"right\">\r\n                <template #default=\"scope\">\r\n                  <el-button\r\n                    size=\"small\"\r\n                    type=\"primary\"\r\n                    @click=\"viewReportDetail(scope.row)\"\r\n                    >查看</el-button\r\n                  >\r\n                  <el-button\r\n                    size=\"small\"\r\n                    type=\"success\"\r\n                    @click=\"exportReport(scope.row)\"\r\n                    >导出</el-button\r\n                  >\r\n                </template>\r\n              </el-table-column>\r\n            </el-table>\r\n            <div class=\"pagination-container\">\r\n              <el-pagination\r\n                background\r\n                layout=\"total, sizes, prev, pager, next, jumper\"\r\n                :total=\"totalReports\"\r\n                :page-size=\"pageSize\"\r\n                :page-sizes=\"[10, 20, 50, 100]\"\r\n                @size-change=\"handleSizeChange\"\r\n                @current-change=\"handleCurrentChange\"\r\n              ></el-pagination>\r\n            </div>\r\n          </el-tab-pane>\r\n\r\n          <el-tab-pane label=\"时间轴视图\" name=\"timeline\">\r\n            <div class=\"timeline-container\">\r\n              <el-timeline>\r\n                <el-timeline-item\r\n                  v-for=\"(group, date) in groupedReports\"\r\n                  :key=\"date\"\r\n                  :timestamp=\"date\"\r\n                  placement=\"top\"\r\n                >\r\n                  <el-card>\r\n                    <h4>{{ date }} ({{ group.length }}份报告)</h4>\r\n                    <div class=\"timeline-reports\">\r\n                      <div\r\n                        v-for=\"report in group\"\r\n                        :key=\"report.id\"\r\n                        class=\"timeline-report-item\"\r\n                        @click=\"viewReportDetail(report)\"\r\n                      >\r\n                        <div class=\"report-id\">ID: {{ report.id }}</div>\r\n                        <div class=\"report-diagnosis\">\r\n                          {{ report.finalDiagnosis }}\r\n                        </div>\r\n                        <div class=\"report-tags\">\r\n                          <el-tag\r\n                            size=\"small\"\r\n                            :type=\"getTagType(report.leftEye.diagnosis)\"\r\n                          >\r\n                            左眼: {{ report.leftEye.diagnosis }}\r\n                          </el-tag>\r\n                          <el-tag\r\n                            size=\"small\"\r\n                            :type=\"getTagType(report.rightEye.diagnosis)\"\r\n                          >\r\n                            右眼: {{ report.rightEye.diagnosis }}\r\n                          </el-tag>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </el-card>\r\n                </el-timeline-item>\r\n              </el-timeline>\r\n            </div>\r\n          </el-tab-pane>\r\n        </el-tabs>\r\n      </div>\r\n\r\n      <div class=\"batch-actions\">\r\n        <el-button\r\n          type=\"primary\"\r\n          @click=\"batchExport\"\r\n          :disabled=\"selectedReports.length === 0\"\r\n        >\r\n          批量导出 ({{ selectedReports.length }})\r\n        </el-button>\r\n        <el-button\r\n          type=\"danger\"\r\n          @click=\"batchArchive\"\r\n          :disabled=\"selectedReports.length === 0\"\r\n        >\r\n          批量归档 ({{ selectedReports.length }})\r\n        </el-button>\r\n      </div>\r\n    </div>\r\n  </app-layout>\r\n</template>\r\n\r\n<script>\r\nimport AppLayout from \"@/components/AppLayout.vue\";\r\nimport request from \"@/utils/axios\"; // 导入axios实例\r\n\r\nexport default {\r\n  name: \"ReportsView\",\r\n  components: {\r\n    AppLayout,\r\n  },\r\n  data() {\r\n    return {\r\n      activeTab: \"list\",\r\n      loading: false,\r\n      reports: [],\r\n      selectedReports: [],\r\n      filterForm: {\r\n        dateRange: [],\r\n        diseaseType: \"\",\r\n        confidenceRange: [0, 100],\r\n      },\r\n      diseaseOptions: [\r\n        { value: \"糖尿病视网膜病变\", label: \"糖尿病视网膜病变\" },\r\n        { value: \"青光眼\", label: \"青光眼\" },\r\n        { value: \"白内障\", label: \"白内障\" },\r\n        { value: \"AMD\", label: \"AMD\" },\r\n        { value: \"高血压视网膜病变\", label: \"高血压视网膜病变\" },\r\n        { value: \"近视\", label: \"近视\" },\r\n        { value: \"其他异常\", label: \"其他异常\" },\r\n        { value: \"正常\", label: \"正常\" },\r\n      ],\r\n      pageSize: 10,\r\n      currentPage: 1,\r\n      tableHeight: 500,\r\n      totalReports: 0,\r\n      queryParams: {\r\n        beginTime: \"\",\r\n        endTime: \"\",\r\n        diagnosisType: \"\",\r\n        page: 1,\r\n        pageSize: 10,\r\n      },\r\n    };\r\n  },\r\n  computed: {\r\n    filteredReports() {\r\n      return this.reports;\r\n    },\r\n    groupedReports() {\r\n      // 按日期分组报告\r\n      const groups = {};\r\n\r\n      this.reports.forEach((report) => {\r\n        const date = new Date(report.diagnosisTime).toLocaleDateString();\r\n        if (!groups[date]) {\r\n          groups[date] = [];\r\n        }\r\n        groups[date].push(report);\r\n      });\r\n\r\n      // 按日期降序排序\r\n      return Object.keys(groups)\r\n        .sort((a, b) => new Date(b) - new Date(a))\r\n        .reduce((obj, key) => {\r\n          obj[key] = groups[key];\r\n          return obj;\r\n        }, {});\r\n    },\r\n  },\r\n  methods: {\r\n    formatConfidence(val) {\r\n      return val + \"%\";\r\n    },\r\n\r\n    async applyFilter() {\r\n      this.currentPage = 1;\r\n      this.loading = true;\r\n\r\n      // 设置查询参数\r\n      if (this.filterForm.dateRange && this.filterForm.dateRange.length === 2) {\r\n        // 格式化日期为API所需的格式（YYYY-MM-DD）\r\n        const startDate = new Date(this.filterForm.dateRange[0]);\r\n        const endDate = new Date(this.filterForm.dateRange[1]);\r\n\r\n        this.queryParams.beginTime = startDate.toISOString().split(\"T\")[0];\r\n        this.queryParams.endTime = endDate.toISOString().split(\"T\")[0];\r\n      } else {\r\n        this.queryParams.beginTime = \"\";\r\n        this.queryParams.endTime = \"\";\r\n      }\r\n\r\n      this.queryParams.diagnosisType = this.filterForm.diseaseType || \"\";\r\n      this.queryParams.page = this.currentPage;\r\n      this.queryParams.pageSize = this.pageSize;\r\n\r\n      await this.fetchDiagnosisRecords();\r\n    },\r\n\r\n    resetFilter() {\r\n      this.filterForm = {\r\n        dateRange: [],\r\n        diseaseType: \"\",\r\n        confidenceRange: [0, 100],\r\n      };\r\n      this.currentPage = 1;\r\n\r\n      // 重置查询参数\r\n      this.queryParams = {\r\n        beginTime: \"\",\r\n        endTime: \"\",\r\n        diagnosisType: \"\",\r\n        page: 1,\r\n        pageSize: this.pageSize,\r\n      };\r\n\r\n      this.fetchDiagnosisRecords();\r\n    },\r\n\r\n    handleSelectionChange(selection) {\r\n      this.selectedReports = selection;\r\n    },\r\n\r\n    async handleSizeChange(size) {\r\n      this.pageSize = size;\r\n      this.queryParams.pageSize = size;\r\n      this.currentPage = 1;\r\n      this.queryParams.page = 1;\r\n      await this.fetchDiagnosisRecords();\r\n    },\r\n\r\n    async handleCurrentChange(page) {\r\n      this.currentPage = page;\r\n      this.queryParams.page = page;\r\n      await this.fetchDiagnosisRecords();\r\n    },\r\n\r\n    viewReportDetail(report) {\r\n      this.$router.push(`/reports/detail/${report.patientId}`);\r\n    },\r\n\r\n    exportReport(report) {\r\n      this.$message.success(`报告 ${report.id} 已导出为PDF文件`);\r\n    },\r\n\r\n    batchExport() {\r\n      this.$message.success(`已导出 ${this.selectedReports.length} 份报告`);\r\n    },\r\n\r\n    batchArchive() {\r\n      this.$confirm(\"确定要归档选中的报告吗?\", \"提示\", {\r\n        confirmButtonText: \"确定\",\r\n        cancelButtonText: \"取消\",\r\n        type: \"warning\",\r\n      })\r\n        .then(() => {\r\n          this.$message.success(`已归档 ${this.selectedReports.length} 份报告`);\r\n          // 从列表中移除已归档的报告\r\n          const ids = this.selectedReports.map((report) => report.id);\r\n          this.reports = this.reports.filter(\r\n            (report) => !ids.includes(report.id)\r\n          );\r\n          this.selectedReports = [];\r\n        })\r\n        .catch(() => {\r\n          // 取消操作\r\n        });\r\n    },\r\n\r\n    getTagType(diagnosis) {\r\n      // 根据诊断结果返回不同的标签类型\r\n      switch (diagnosis) {\r\n        case \"正常\":\r\n          return \"success\";\r\n        case \"糖尿病视网膜病变\":\r\n        case \"青光眼\":\r\n        case \"AMD\":\r\n          return \"danger\";\r\n        case \"白内障\":\r\n        case \"高血压视网膜病变\":\r\n          return \"warning\";\r\n        case \"近视\":\r\n          return \"info\";\r\n        default:\r\n          return \"\";\r\n      }\r\n    },\r\n\r\n    // 调整表格高度\r\n    adjustTableHeight() {\r\n      this.tableHeight = window.innerHeight - 350; // 根据页面其他元素高度调整\r\n    },\r\n\r\n    // 获取诊断记录数据\r\n    async fetchDiagnosisRecords() {\r\n      this.loading = true;\r\n      try {\r\n        const response = await request({\r\n          method: \"get\",\r\n          url: \"/diagnosisrecord/show/page\",\r\n          params: this.queryParams,\r\n        });\r\n\r\n        if (response.code === 1) {\r\n          // 更新数据\r\n          this.reports = this.formatReports(response.data.records || []);\r\n          this.totalReports = response.data.total || 0;\r\n        } else {\r\n          this.$message.error(response.msg || \"获取诊断记录失败\");\r\n        }\r\n      } catch (error) {\r\n        console.error(\"获取诊断记录出错:\", error);\r\n        this.$message.error(\"获取诊断记录失败，请稍后重试\");\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n\r\n    // 格式化报告数据，增加计算属性和UI所需字段\r\n    formatReports(records) {\r\n      return records.map((record) => {\r\n        // 处理置信度，将0-1范围转换为0-100\r\n        const leftConfidence = record.leftConfidence\r\n          ? Math.round(record.leftConfidence * 100)\r\n          : 0;\r\n        const rightConfidence = record.rightConfidence\r\n          ? Math.round(record.rightConfidence * 100)\r\n          : 0;\r\n\r\n        return {\r\n          ...record,\r\n          leftEye: {\r\n            diagnosis: record.leftResult || \"\",\r\n            confidence: leftConfidence,\r\n          },\r\n          rightEye: {\r\n            diagnosis: record.rightResult || \"\",\r\n            confidence: rightConfidence,\r\n          },\r\n          finalDiagnosis: record.finalResult || \"\",\r\n          time: record.diagnosisTime, // 保持兼容性\r\n        };\r\n      });\r\n    },\r\n  },\r\n  async mounted() {\r\n    // 检查登录状态\r\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\r\n    if (!isLoggedIn) {\r\n      this.$router.push(\"/login\");\r\n    }\r\n\r\n    // 调整表格高度\r\n    this.adjustTableHeight();\r\n    window.addEventListener(\"resize\", this.adjustTableHeight);\r\n\r\n    // 初始化时获取数据\r\n    await this.fetchDiagnosisRecords();\r\n  },\r\n  beforeUnmount() {\r\n    window.removeEventListener(\"resize\", this.adjustTableHeight);\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.reports-container {\r\n  padding: 20px;\r\n  background-color: #f5f7fa;\r\n  min-height: calc(100vh - 60px);\r\n}\r\n\r\n.page-title {\r\n  font-size: 24px;\r\n  margin-bottom: 20px;\r\n  color: #303133;\r\n  margin-top: -20px;\r\n}\r\n\r\n/* 筛选区域样式 */\r\n.filter-section {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 4px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.filter-form {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n}\r\n\r\n.filter-form :deep(.el-select) {\r\n  width: 150px;\r\n}\r\n\r\n