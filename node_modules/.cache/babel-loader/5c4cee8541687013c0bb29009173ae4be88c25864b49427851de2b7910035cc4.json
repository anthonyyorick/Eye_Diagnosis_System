ight=\"40\" fill=\"%23000\"/><rect x=\"148\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"152\" y=\"10\" width=\"3\" height=\"40\" fill=\"%23000\"/><rect x=\"158\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"161\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"165\" y=\"10\" width=\"4\" height=\"40\" fill=\"%23000\"/><rect x=\"171\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"174\" y=\"10\" width=\"3\" height=\"40\" fill=\"%23000\"/><rect x=\"180\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/></svg>');\r\n  background-repeat: no-repeat;\r\n  background-position: center;\r\n}\r\n\r\n/* 报告元数据 */\r\n.report-meta {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  margin-bottom: 20px;\r\n  font-size: 14px;\r\n  color: #606266;\r\n}\r\n\r\n/* 患者信息区域 */\r\n.patient-info-section {\r\n  margin-bottom: 25px;\r\n  border: 1px solid #ebeef5;\r\n  border-radius: 4px;\r\n  padding: 15px;\r\n  background-color: #f8f9fa;\r\n}\r\n\r\n.section-subtitle {\r\n  margin-top: 0;\r\n  margin-bottom: 15px;\r\n  font-size: 18px;\r\n  color: #2c3e50;\r\n  padding-bottom: 8px;\r\n  border-bottom: 1px solid #dcdfe6;\r\n}\r\n\r\n.patient-info-grid {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.info-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 20px;\r\n}\r\n\r\n.info-item {\r\n  min-width: 120px;\r\n  flex: 1;\r\n}\r\n\r\n.info-label {\r\n  font-weight: 600;\r\n  color: #606266;\r\n}\r\n\r\n.info-value {\r\n  color: #303133;\r\n}\r\n\r\n/* 眼底图像区域 */\r\n.eye-images-section {\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.eye-images-grid {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 20px;\r\n}\r\n\r\n.eye-image-container {\r\n  flex: 1;\r\n  text-align: center;\r\n  position: relative;\r\n}\r\n\r\n.eye-image {\r\n  width: 100%;\r\n  max-height: 200px;\r\n  object-fit: contain;\r\n  border: 1px solid #dcdfe6;\r\n  border-radius: 4px;\r\n}\r\n\r\n.eye-label {\r\n  position: absolute;\r\n  bottom: 10px;\r\n  left: 10px;\r\n  background-color: rgba(0, 0, 0, 0.6);\r\n  color: white;\r\n  padding: 4px 8px;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n}\r\n\r\n/* 诊断结果区域 */\r\n.diagnosis-section {\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.diagnosis-grid {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 20px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.diagnosis-item {\r\n  flex: 1;\r\n  padding: 15px;\r\n  border-radius: 4px;\r\n  background-color: #f8f9fa;\r\n  border: 1px solid #ebeef5;\r\n}\r\n\r\n.diagnosis-title {\r\n  margin-top: 0;\r\n  margin-bottom: 10px;\r\n  font-size: 16px;\r\n  color: #606266;\r\n}\r\n\r\n.diagnosis-value {\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  color: #303133;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.confidence-bar {\r\n  margin-top: 10px;\r\n}\r\n\r\n.confidence-label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n  font-size: 14px;\r\n  color: #606266;\r\n}\r\n\r\n.final-diagnosis {\r\n  padding: 15px;\r\n  border-radius: 4px;\r\n  background-color: #f0f9eb;\r\n  border: 1px solid #e1f3d8;\r\n}\r\n\r\n.final-diagnosis-value {\r\n  font-size: 20px;\r\n  font-weight: 600;\r\n  color: #67c23a;\r\n}\r\n\r\n/* 治疗建议区域 */\r\n.treatment-section {\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.treatment-content {\r\n  padding: 15px;\r\n  border-radius: 4px;\r\n  background-color: #f8f9fa;\r\n  border: 1px solid #ebeef5;\r\n}\r\n\r\n.treatment-actions {\r\n  margin-top: 10px;\r\n  text-align: right;\r\n}\r\n\r\n/* 医生签名区域 */\r\n.doctor-signature {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  margin-top: 30px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.signature-text {\r\n  line-height: 2;\r\n  color: #606266;\r\n}\r\n\r\n.hospital-stamp {\r\n  width: 100px;\r\n  height: 100px;\r\n  border: 1px dashed #dcdfe6;\r\n  border-radius: 50%;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  color: #909399;\r\n  font-size: 14px;\r\n}\r\n\r\n/* 