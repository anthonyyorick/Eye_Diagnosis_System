"exportData('pdf')\"\r\n          >导出PDF</el-button\r\n        >\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"filter-section\">\r\n      <el-form :inline=\"true\" :model=\"filterForm\" class=\"filter-form\">\r\n        <el-form-item label=\"时间范围\">\r\n          <el-select\r\n            v-model=\"filterForm.timeRange\"\r\n            placeholder=\"选择时间范围\"\r\n            @change=\"updateCharts\"\r\n          >\r\n            <el-option label=\"最近7天\" value=\"7days\"></el-option>\r\n            <el-option label=\"最近30天\" value=\"30days\"></el-option>\r\n            <el-option label=\"最近3个月\" value=\"3months\"></el-option>\r\n            <el-option label=\"最近1年\" value=\"1year\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"科室\">\r\n          <el-select\r\n            v-model=\"filterForm.department\"\r\n            placeholder=\"选择科室\"\r\n            multiple\r\n            @change=\"updateCharts\"\r\n          >\r\n            <el-option label=\"眼科门诊\" value=\"outpatient\"></el-option>\r\n            <el-option label=\"眼科住院\" value=\"inpatient\"></el-option>\r\n            <el-option label=\"专家门诊\" value=\"expert\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button type=\"primary\" @click=\"updateCharts\">应用筛选</el-button>\r\n          <el-button @click=\"resetFilter\">重置</el-button>\r\n        </el-form-item>\r\n      </el-form>\r\n    </div>\r\n\r\n    <el-row :gutter=\"20\" class=\"chart-row\">\r\n      <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n        <el-card class=\"chart-card\">\r\n          <template #header>\r\n            <div class=\"chart-header\">\r\n              <h3>诊断趋势分析</h3>\r\n              <el-radio-group\r\n                v-model=\"trendChartType\"\r\n                size=\"small\"\r\n                @change=\"updateTrendChart\"\r\n              >\r\n                <el-radio-button label=\"daily\">日</el-radio-button>\r\n                <el-radio-button label=\"weekly\">周</el-radio-button>\r\n                <el-radio-button label=\"monthly\">月</el-radio-button>\r\n              </el-radio-group>\r\n            </div>\r\n          </template>\r\n          <div ref=\"trendChart\" class=\"chart-container\"></div>\r\n        </el-card>\r\n      </el-col>\r\n      <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n        <el-card class=\"chart-card\">\r\n          <template #header>\r\n            <div class=\"chart-header\">\r\n              <h3>疾病分布分析</h3>\r\n            </div>\r\n          </template>\r\n          <div ref=\"diseaseDistributionChart\" class=\"chart-container\"></div>\r\n        </el-card>\r\n      </el-col>\r\n    </el-row>\r\n\r\n    <el-row :gutter=\"20\" class=\"chart-row\">\r\n      <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n        <el-card class=\"chart-card\">\r\n          <template #header>\r\n            <div class=\"chart-header\">\r\n              <h3>患者年龄分布</h3>\r\n            </div>\r\n          </template>\r\n          <div ref=\"ageDistributionChart\" class=\"chart-container\"></div>\r\n        </el-card>\r\n      </el-col>\r\n      <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n        <el-card class=\"chart-card\">\r\n          <template #header>\r\n            <div class=\"chart-header\">\r\n              <h3>患者性别分布</h3>\r\n            </div>\r\n          </template>\r\n          <div ref=\"genderDistributionChart\" class=\"chart-container\"></div>\r\n        </el-card>\r\n      </el-col>\r\n    </el-row>\r\n\r\n    <el-card class=\"anomaly-card\">\r\n      <template #header>\r\n        <div class=\"anomaly-header\">\r\n          <h3>异常病例分析</h3>\r\n          <el-tooltip\r\n            content=\"置信度低于60%或诊断结果不一致的病例\"\r\n            placement=\"top\"\r\n          >\r\n            <i class=\"el-icon-question\"></i>\r\n          </el-tooltip>\r\n        </div>\r\n      </template>\r\n      <el-table :data=\"anomalyCases\" style=\"width: 100%\" border>\r\n        <el-table-column prop=\"id\" label=\"ID\" width=\"120\"></el-table-column>\r\n        <el-table-column\r\n          prop=\"time\"\r\n          label=\"诊断时间\"\r\n          width=\"180\"\r\n        ></el-table-column>\r\n        <el-table-column\r\n          prop=\"leftEye.diagnosis\"\r\n          label=\"左眼诊断\"\r\n          width=\"150\"\r\n        ></el-table-column>\r\n        <el-table-column\r\n          prop=\"rightEye.diagnosis\"\r\n          label=\"右眼诊断\"\r\n          width=\"150\"\r\n        ></el-table-column>\r\n        <el-table-column label=\"置信度\" width=\"180\">\r\n          <template #default=\"scope\">\r\n            <div>\r\n              <el-progress\r\n                :percentage=\"scope.row.leftEye.confidence\"\r\n                :format=\"percentFormat\"\r\n                :stroke-width=\"10\"\r\n                :color=\"getConfidenceColor(scope.row.leftEye.confidence)\"\r\n              ></el-progress>\r\n              <el-progress\r\n                :percentage=\"scope.row.rightEye.confidence\"\r\n                :format=\"percentFormat\"\r\n                :stroke-width=\"10\"\r\n                :color=\"getConfidenceColor(scope.row.rightEye.confidence)\"\r\n              ></el-progress>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column\r\n          prop=\"anomalyReason\"\r\n          label=\"异常原因\"\r\n        ></el-table-column>\r\n        <el-table-column label=\"操作\" width=\"120\">\r\n          <template #default=\"scope\">\r\n            <el-button\r\n              size=\"small\"\r\n              type=\"primary\"\r\n              @click=\"viewAnomalyDetail(scope.row)\"\r\n              >查看</el-button\r\n            >\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport * as echarts from \"echarts\";\r\n\r\nexport default {\r\n  name: \"AnalyticsView\",\r\n  data() {\r\n    return {\r\n      filterForm: {\r\n        timeRange: \"30days\",\r\n        department: [\"outpatient\"],\r\n      },\r\n      trendChartType: \"daily\",\r\n      charts: {\r\n        trendChart: null,\r\n        diseaseDistributionChart: null,\r\n        ageDistributionChart: null,\r\n        genderDistributionChart: null,\r\n      },\r\n      anomalyCases: [],\r\n    };\r\n  },\r\n  methods: {\r\n    updateCharts() {\r\n      this.updateTrendChart();\r\n      this.updateDiseaseDistributionChart();\r\n      this.updateAgeDistributionChart();\r\n      this.updateGenderDistributionChart();\r\n      this.updateAnomalyCases();\r\n    },\r\n\r\n    resetFilter() {\r\n      this.filterForm = {\r\n        timeRange: \"30days\",\r\n        department: [\"outpatient\"],\r\n      };\r\n      this.updateCharts();\r\n    },\r\n\r\n    percentFormat(percentage) {\r\n      return percentage + \"%\";\r\n    },\r\n\r\n    getConfidenceColor(confidence) {\r\n      if (confidence < 60) {\r\n        return \"#F56C6C\";\r\n      } else if (confidence < 80) {\r\n        return \"#E6A23C\";\r\n      } else {\r\n        return \"#67C23A\";\r\n      }\r\n    },\r\n\r\n    viewAnomalyDetail(row) {\r\n      this.$router.push(`/reports/detail/${row.id}`);\r\n    },\r\n\r\n    exportData(type) {\r\n      this.$message.success(`数据已导出为${type.toUpperCase()}格式`);\r\n    },\r\n\r\n    // 诊断趋势图表\r\n    updateTrendChart() {\r\n      if (!this.charts.trendChart) {\r\n        this.charts.trendChart = echarts.init(this.$refs.trendChart);\r\n      }\r\n\r\n      // 生成日期数据\r\n      const dates = [];\r\n      const diagnosisCounts = [];\r\n      const normalCounts = [];\r\n      const abnormalCounts = [];\r\n\r\n      let days = 30;\r\n      switch (this.filterForm.timeRange) {\r\n        case \"7days\":\r\n          days = 7;\r\n          break;\r\n        case \"30days\":\r\n          days = 30;\r\n          break;\r\n        case \"3months\":\r\n          days = 90;\r\n          break;\r\n        case \"1year\":\r\n          days = 365;\r\n          break;\r\n      }\r\n\r\n      const today = new Date();\r\n      for (let i = days - 1; i >= 0; i--) {\r\n        const date = new Date();\r\n        date.setDate(today.getDate() - i);\r\n\r\n        let dateStr;\r\n        if (this.trendChartType === \"daily\") {\r\n          dateStr = `${date.getMonth() + 1}/${date.getDate()}`;\r\n        } else if (this.trendChartType === \"weekly\") {\r\n          // 简化处理，实际应用中应该按周分组\r\n          dateStr = `第${Math.floor(i / 7) + 1}周`;\r\n        } else {\r\n          dateStr = `${date.getMonth() + 1}月`;\r\n        }\r\n\r\n        if (!dates.includes(dateStr)) {\r\n          dates.push(dateStr);\r\n\r\n          // 生成随机数据\r\n          const total = Math.floor(Math.random() * 50) + 10;\r\n          const normal = Math.floor(Math.random() * total);\r\n          const abnormal = total - normal;\r\n\r\n          diagnosisCounts.push(total);\r\n          normalCounts.push(normal);\r\n          abnormalCounts.push(abnormal);\r\n        }\r\n      }\r\n\r\n      const option = {\r\n        tooltip: {\r\n          trigger: \"axis\",\r\n          axisPointer: {\r\n            type: \"shadow\",\r\n          },\r\n        },\r\n        legend: {\r\n          data: [\"总诊断量\", \"正常\", \"异常\"],\r\n        },\r\n        grid: {\r\n          left: \"3%\",\r\n          right: \"4%\",\r\n          bottom: \"3%\",\r\n          containLabel: true,\r\n        },\r\n        xAxis: {\r\n          type: \"category\",\r\n          data: dates,\r\n        },\r\n        yAxis: {\r\n          type: \"value\",\r\n        },\r\n        series: [\r\n          {\r\n            name: \"总诊断量\",\r\n            type: \"line\",\r\n            data: diagnosisCounts,\r\n            smooth: true,\r\n            lineStyle: {\r\n              width: 3,\r\n            },\r\n          },\r\n          {\r\n            name: \"正常\",\r\n            type: \"bar\",\r\n            stack: \"total\",\r\n            data: normalCounts,\r\n            itemStyle: {\r\n              color: \"#67C23A\",\r\n            },\r\n          },\r\n          {\r\n            name: \"异常\",\r\n            type: \"bar\",\r\n            stack: \"total\",\r\n            data: abnormalCounts,\r\n            itemStyle: {\r\n              color: \"#F56C6C\",\r\n            },\r\n          },\r\n        ],\r\n      };\r\n\r\n      this.charts.trendChart.setOption(option);\r\n    },\r\n\r\n    // 疾病分布图表\r\n    updateDiseaseDistributionChart() {\r\n      if (!this.charts.diseaseDistributionChart) {\r\n        this.charts.diseaseDistributionChart = echarts.init(\r\n          this.$refs.diseaseDistributionChart\r\n        );\r\n      }\r\n\r\n      const diseaseCategories = [\r\n        \"糖尿病视网膜病变\",\r\n        \"青光眼\",\r\n        \"白内障\",\r\n        \"AMD\",\r\n        \"高血压视网膜病变\",\r\n        \"近视\",\r\n        \"其他异常\",\r\n        \"正常\",\r\n      ];\r\n\r\n      // 生成随机数据\r\n      const data = diseaseCategories.map((category) => {\r\n        return {\r\n          value: Math.floor(Math.random() * 100) + 20,\r\n          name: category,\r\n        };\r\n      });\r\n\r\n      const option = {\r\n        tooltip: {\r\n          trigger: \"item\",\r\n          formatter: \"{a} <br/>{b}: {c} ({d}%)\",\r\n        },\r\n        legend: {\r\n          orient: \"vertical\",\r\n          right: 10,\r\n          top: \"center\",\r\n          data: diseaseCategories,\r\n        },\r\n        series: [\r\n          {\r\n            name: \"疾病分布\",\r\n            type: \"pie\",\r\n            radius: [\"50%\", \"70%\"],\r\n            avoidLabelOverlap: false,\r\n            label: {\r\n              show: false,\r\n              position: \"center\",\r\n            },\r\n            emphasis: {\r\n              label: {\r\n                show: true,\r\n                fontSize: \"16\",\r\n                fontWeight: \"bold\",\r\n              },\r\n            },\r\n            labelLine: {\r\n              show: false,\r\n            },\r\n            data: data,\r\n          },\r\n        ],\r\n      };\r\n\r\n      this.charts.diseaseDistributionChart.setOption(option);\r\n    },\r\n\r\n    // 年龄分布图表\r\n    updateAgeDistributionChart() {\r\n      if (!this.charts.ageDistributionChart) {\r\n        this.charts.ageDistributionChart = echarts.init(\r\n          this.$refs.ageDistributionChart\r\n        );\r\n      }\r\n\r\n      const ageGroups = [\"0-18\", \"19-30\", \"31-45\", \"46-60\", \"61-75\", \"76+\"];\r\n\r\n      // 生成随机数据\r\n      const data = ageGroups.map((group) => {\r\n        return Math.floor(Math.random() * 100) + 10;\r\n      });\r\n\r\n      const option = {\r\n        tooltip: {\r\n          trigger: \"axis\",\r\n          axisPointer: {\r\n            type: \"shadow\",\r\n          },\r\n        },\r\n        grid: {\r\n          left: \"3%\",\r\n          right: \"4%\",\r\n          bottom: \"3%\",\r\n          containLabel: true,\r\n        },\r\n        xAxis: {\r\n          type: \"category\",\r\n          data: ageGroups,\r\n        },\r\n        yAxis: {\r\n          type: \"value\",\r\n          name: \"患者数量\",\r\n        },\r\n        series: [\r\n          {\r\n            name: \"患者数量\",\r\n            type: \"bar\",\r\n            data: data,\r\n            itemStyle: {\r\n              color: function (params) {\r\n                const colorList = [\r\n                  \"#91c7ae\",\r\n                  \"#749f83\",\r\n                  \"#ca8622\",\r\n                  \"#bda29a\",\r\n                  \"#6e7074\",\r\n                  \"#546570\",\r\n                ];\r\n                return colorList[params.dataIndex];\r\n              },\r\n            },\r\n          },\r\n        ],\r\n      };\r\n\r\n      this.charts.ageDistributionChart.setOption(option);\r\n    },\r\n\r\n    // 性别分布图表\r\n    updateGenderDistributionChart() {\r\n      if (!this.charts.genderDistributionChart) {\r\n        this.charts.genderDistributionChart = echarts.init(\r\n          this.$refs.genderDistributionChart\r\n        );\r\n      }\r\n\r\n      // 生成随机数据\r\n      const maleCount = Math.floor(Math.random() * 200) + 100;\r\n      const femaleCount = Math.floor(Math.random() * 200) + 100;\r\n\r\n      const option = {\r\n        tooltip: {\r\n          trigger: \"item\",\r\n          formatter: \"{a} <br/>{b}: {c} ({d}%)\",\r\n        },\r\n        legend: {\r\n          orient: \"horizontal\",\r\n          bottom: \"bottom\",\r\n          data: [\"男\", \"女\"],\r\n        },\r\n        color: [\"#409EFF\", \"#FF6B6B\"],\r\n        series: [\r\n          {\r\n            name: \"性别分布\",\r\n            type: \"pie\",\r\n            radius: \"55%\",\r\n            center: [\"50%\", \"45%\"],\r\n            data: [\r\n              { value: maleCount, name: \"男\" },\r\n              { value: femaleCount, name: \"女\" },\r\n            ],\r\n            emphasis: {\r\n              itemStyle: {\r\n                shadowBlur: 10,\r\n                shadowOffsetX: 0,\r\n                shadowColor: \"rgba(0, 0, 0, 0.5)\",\r\n              },\r\n            },\r\n          },\r\n        ],\r\n      };\r\n\r\n      this.charts.genderDistributionChart.setOption(option);\r\n    },\r\n\r\n    // 更新异常病例数据\r\n    updateAnomalyCases() {\r\n      // 生成模拟异常病例数据\r\n      this.anomalyCases = [];\r\n\r\n      for (let i = 0; i < 5; i++) {\r\n        const date = new Date();\r\n        date.setDate(date.getDate() - Math.floor(Math.random() * 30));\r\n\r\n        const leftConfidence = Math.floor(Math.random() * 30) + 40; // 40-70之间\r\n        const rightConfidence = Math.floor(Math.random() * 30) + 40;\r\n\r\n        const diseaseOptions = [\r\n          \"糖尿病视网膜病变\",\r\n          \"青光眼\",\r\n          \"白内障\",\r\n          \"AMD\",\r\n          \"高血压视网膜病变\",\r\n          \"近视\",\r\n          \"其他异常\",\r\n          \"正常\",\r\n        ];\r\n\r\n        const leftDiagnosis =\r\n          diseaseOptions[Math.floor(Math.random() * diseaseOptions.length)];\r\n        const rightDiagnosis =\r\n          diseaseOptions[Math.floor(Math.random() * diseaseOptions.length)];\r\n\r\n        let anomalyReason;\r\n        if (leftConfidence < 60 && rightConfidence < 60) {\r\n          anomalyReason = \"双眼诊断置信度低\";\r\n        } else if (leftConfidence < 60) {\r\n          anomalyReason = \"左眼诊断置信度低\";\r\n        } else if (rightConfidence < 60) {\r\n          anomalyReason = \"右眼诊断置信度低\";\r\n        } else if (\r\n          leftDiagnosis !== rightDiagnosis &&\r\n          leftDiagnosis !== \"正常\" &&\r\n          rightDiagnosis !== \"正常\"\r\n        ) {\r\n          anomalyReason = \"左右眼诊断结果差异大\";\r\n        }\r\n\r\n        this.anomalyCases.push({\r\n          id: `PT2023${2000 + i}`,\r\n          time: date.toLocaleString(),\r\n          leftEye: {\r\n            diagnosis: leftDiagnosis,\r\n            confidence: leftConfidence,\r\n          },\r\n          rightEye: {\r\n            diagnosis: rightDiagnosis,\r\n            confidence: rightConfidence,\r\n          },\r\n          anomalyReason: anomalyReason,\r\n        });\r\n      }\r\n    },\r\n  },\r\n  mounted() {\r\n    // 检查登录状态\r\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\r\n    if (!isLoggedIn) {\r\n      this.$router.push(\"/login\");\r\n    }\r\n\r\n    // 初始化图表\r\n    this.$nextTick(() => {\r\n      this.updateCharts();\r\n\r\n      // 响应窗口大小变化\r\n      window.addEventListener(\"resize\", () => {\r\n        for (const key in this.charts) {\r\n          if (this.charts[key]) {\r\n            this.charts[key].resize();\r\n          }\r\n        }\r\n      });\r\n    });\r\n  },\r\n  beforeUnmount() {\r\n    // 移除事件监听\r\n    window.removeEventListener(\"resize\", () => {});\r\n\r\n    // 销毁图表实例\r\n    for (const key in this.charts) {\r\n      if (this.charts[key]) {\r\n        this.charts[key].dispose();\r\n      }\r\n    }\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.analytics-container {\r\n  