{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { Bell } from \"@element-plus/icons-vue\";\nexport default {\n  name: \"AppLayout\",\n  components: {\n    Bell\n  },\n  props: {\n    activeMenu: {\n      type: String,\n      default: \"/dashboard\"\n    }\n  },\n  data() {\n    return {\n      userAvatar: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n      showNotification: false,\n      unreadNotifications: 2,\n      systemNotices: [{\n        title: \"系统更新通知\",\n        content: \"系统将于2023年6月20日凌晨2:00-4:00进行版本更新，请提前做好准备。\",\n        time: \"2023-06-15 10:30\"\n      }, {\n        title: \"新功能上线\",\n        content: \"批量诊断功能已上线，支持同时处理多达50组眼底图像，欢迎使用！\",\n        time: \"2023-06-12 14:15\"\n      }]\n    };\n  },\n  methods: {\n    handleCommand(command) {\n      if (command === \"profile\") {\n        this.$router.push(\"/profile\");\n      } else if (command === \"settings\") {\n        this.$router.push(\"/profile?tab=settings\");\n      } else if (command === \"logout\") {\n        localStorage.removeItem(\"isLoggedIn\");\n        this.$router.push(\"/login\");\n      }\n    },\n    toggleNotification() {\n      this.showNotification = !this.showNotification;\n      if (this.showNotification) {\n        this.unreadNotifications = 0;\n      }\n    }\n  }\n};","map":{"version":3,"names":["Bell","name","components","props","activeMenu","type","String","default","data","userAvatar","showNotification","unreadNotifications","systemNotices","title","content","time","methods","handleCommand","command","$router","push","localStorage","removeItem","toggleNotification"],"sources":["E:\\Apollo\\Eye-Diagnose-System\\src\\components\\AppLayout.vue"],"sourcesContent":["<template>\r\n  <div class=\"app-container\">\r\n    <!-- 顶部导航栏 -->\r\n    <el-header class=\"app-header\">\r\n      <div class=\"logo\">\r\n        <img src=\"../assets/logo.png\" alt=\"Logo\" class=\"logo-image\" />\r\n        <span class=\"logo-text\">DeepEye-眼底图像眼疾智能识别系统</span>\r\n      </div>\r\n      <el-menu\r\n        mode=\"horizontal\"\r\n        :default-active=\"activeMenu\"\r\n        class=\"main-menu\"\r\n        background-color=\"#304156\"\r\n        text-color=\"#fff\"\r\n        active-text-color=\"#409EFF\"\r\n        router\r\n      >\r\n        <el-menu-item index=\"/dashboard\">首页</el-menu-item>\r\n        <el-menu-item index=\"/diagnosis\">即时诊断中心</el-menu-item>\r\n        <el-menu-item index=\"/reports\">病例报告</el-menu-item>\r\n        <el-menu-item index=\"/analytics\">数据分析</el-menu-item>\r\n      </el-menu>\r\n      <div class=\"header-right\">\r\n        <!-- 修复通知图标 -->\r\n        <el-badge\r\n          :value=\"unreadNotifications\"\r\n          class=\"notification-badge\"\r\n          v-if=\"unreadNotifications > 0\"\r\n        >\r\n          <el-button\r\n            type=\"text\"\r\n            class=\"notification-button\"\r\n            @click=\"toggleNotification\"\r\n          >\r\n            <el-icon><Bell /></el-icon>\r\n          </el-button>\r\n        </el-badge>\r\n        <el-button\r\n          v-else\r\n          type=\"text\"\r\n          class=\"notification-button\"\r\n          @click=\"toggleNotification\"\r\n        >\r\n          <el-icon><Bell /></el-icon>\r\n        </el-button>\r\n\r\n        <!-- 现有的用户头像和下拉菜单 -->\r\n        <el-dropdown trigger=\"click\" @command=\"handleCommand\">\r\n          <span class=\"el-dropdown-link\">\r\n            <el-avatar :size=\"40\" :src=\"userAvatar\"></el-avatar>\r\n          </span>\r\n          <template #dropdown>\r\n            <el-dropdown-menu>\r\n              <el-dropdown-item command=\"profile\">个人中心</el-dropdown-item>\r\n              <el-dropdown-item command=\"settings\">系统设置</el-dropdown-item>\r\n              <el-dropdown-item divided command=\"logout\"\r\n                >退出登录</el-dropdown-item\r\n              >\r\n            </el-dropdown-menu>\r\n          </template>\r\n        </el-dropdown>\r\n      </div>\r\n    </el-header>\r\n\r\n    <!-- 主体内容 -->\r\n    <el-main class=\"app-main\">\r\n      <slot></slot>\r\n    </el-main>\r\n\r\n    <!-- 底部 -->\r\n    <el-footer class=\"app-footer\">\r\n      <div class=\"footer-content\">\r\n        <div class=\"footer-links\">\r\n          <a href=\"#\">关于我们</a>\r\n          <a href=\"#\">使用帮助</a>\r\n          <a href=\"#\">隐私政策</a>\r\n          <a href=\"#\">联系我们</a>\r\n        </div>\r\n        <div class=\"footer-copyright\">\r\n          © 2025 眼底图像眼疾智能识别系统 - 版权所有\r\n        </div>\r\n      </div>\r\n    </el-footer>\r\n\r\n    <!-- 通知抽屉 -->\r\n    <el-drawer\r\n      v-model=\"showNotification\"\r\n      title=\"系统通知\"\r\n      direction=\"rtl\"\r\n      size=\"350px\"\r\n      :with-header=\"true\"\r\n    >\r\n      <div class=\"notification-content\">\r\n        <div\r\n          class=\"notification-item\"\r\n          v-for=\"(notice, index) in systemNotices\"\r\n          :key=\"index\"\r\n        >\r\n          <div class=\"notification-title\">{{ notice.title }}</div>\r\n          <div class=\"notification-text\">{{ notice.content }}</div>\r\n          <div class=\"notification-time\">{{ notice.time }}</div>\r\n        </div>\r\n        <div v-if=\"systemNotices.length === 0\" class=\"empty-notification\">\r\n          暂无通知\r\n        </div>\r\n      </div>\r\n    </el-drawer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Bell } from \"@element-plus/icons-vue\";\r\n\r\nexport default {\r\n  name: \"AppLayout\",\r\n  components: {\r\n    Bell,\r\n  },\r\n  props: {\r\n    activeMenu: {\r\n      type: String,\r\n      default: \"/dashboard\",\r\n    },\r\n  },\r\n  data() {\r\n    return {\r\n      userAvatar: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\r\n      showNotification: false,\r\n      unreadNotifications: 2,\r\n      systemNotices: [\r\n        {\r\n          title: \"系统更新通知\",\r\n          content:\r\n            \"系统将于2023年6月20日凌晨2:00-4:00进行版本更新，请提前做好准备。\",\r\n          time: \"2023-06-15 10:30\",\r\n        },\r\n        {\r\n          title: \"新功能上线\",\r\n          content:\r\n            \"批量诊断功能已上线，支持同时处理多达50组眼底图像，欢迎使用！\",\r\n          time: \"2023-06-12 14:15\",\r\n        },\r\n      ],\r\n    };\r\n  },\r\n  methods: {\r\n    handleCommand(command) {\r\n      if (command === \"profile\") {\r\n        this.$router.push(\"/profile\");\r\n      } else if (command === \"settings\") {\r\n        this.$router.push(\"/profile?tab=settings\");\r\n      } else if (command === \"logout\") {\r\n        localStorage.removeItem(\"isLoggedIn\");\r\n        this.$router.push(\"/login\");\r\n      }\r\n    },\r\n    toggleNotification() {\r\n      this.showNotification = !this.showNotification;\r\n      if (this.showNotification) {\r\n        this.unreadNotifications = 0;\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.app-container {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.app-header {\r\n  background-color: white;\r\n  color: black;\r\n  /* font-weight: bold; */\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0 20px;\r\n  height: 60px !important;\r\n  position: fixed;\r\n  width: 100%;\r\n  z-index: 1000;\r\n  top: 0;\r\n}\r\n\r\n.logo {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.logo-image {\r\n  height: 40px;\r\n  width: 40px;\r\n  margin-right: 10px;\r\n  border-radius: 50%;\r\n}\r\n\r\n.logo-text {\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n}\r\n\r\n.main-menu {\r\n  border-bottom: none;\r\n  flex: 1;\r\n  margin-left: 30px;\r\n}\r\n\r\n.header-right {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.el-dropdown-link {\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.app-main {\r\n  padding: 80px 20px 20px;\r\n  flex: 1;\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.app-footer {\r\n  background-color: #304156;\r\n  color: #a7b1c2;\r\n  padding: 20px;\r\n  text-align: center;\r\n}\r\n\r\n.footer-content {\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.footer-links {\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.footer-links a {\r\n  color: #a7b1c2;\r\n  margin: 0 10px;\r\n  text-decoration: none;\r\n}\r\n\r\n.footer-links a:hover {\r\n  color: white;\r\n}\r\n\r\n.footer-copyright {\r\n  font-size: 12px;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .app-header {\r\n    flex-direction: column;\r\n    height: auto !important;\r\n    padding: 10px;\r\n  }\r\n\r\n  .logo {\r\n    margin-bottom: 10px;\r\n  }\r\n\r\n  .main-menu {\r\n    margin-left: 0;\r\n    width: 100%;\r\n  }\r\n\r\n  .header-right {\r\n    margin-top: 10px;\r\n    margin-left: 0;\r\n  }\r\n\r\n  .app-main {\r\n    padding-top: 160px;\r\n  }\r\n}\r\n\r\n.notification-badge {\r\n  margin-right: 15px;\r\n}\r\n\r\n.notification-button {\r\n  font-size: 20px;\r\n  color: #606266;\r\n}\r\n\r\n.notification-button:hover {\r\n  color: #409eff;\r\n}\r\n\r\n.notification-content {\r\n  padding: 0 15px;\r\n}\r\n\r\n.notification-item {\r\n  padding: 15px 0;\r\n  border-bottom: 1px solid #ebeef5;\r\n}\r\n\r\n.notification-item:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.notification-title {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: #303133;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.notification-text {\r\n  font-size: 12px;\r\n  color: #606266;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.notification-time {\r\n  font-size: 12px;\r\n  color: #909399;\r\n  text-align: right;\r\n}\r\n\r\n.empty-notification {\r\n  padding: 30px 0;\r\n  text-align: center;\r\n  color: #909399;\r\n  font-size: 14px;\r\n}\r\n</style>\r\n"],"mappings":";AA+GA,SAASA,IAAG,QAAS,yBAAyB;AAE9C,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,UAAU,EAAE,uDAAuD;MACnEC,gBAAgB,EAAE,KAAK;MACvBC,mBAAmB,EAAE,CAAC;MACtBC,aAAa,EAAE,CACb;QACEC,KAAK,EAAE,QAAQ;QACfC,OAAO,EACL,0CAA0C;QAC5