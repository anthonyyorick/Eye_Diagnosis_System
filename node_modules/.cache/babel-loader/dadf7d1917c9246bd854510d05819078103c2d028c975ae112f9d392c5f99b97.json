{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"DashboardView\",\n  data() {\n    return {\n      activeMenu: \"/dashboard\",\n      userAvatar: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n      stats: {\n        todayDiagnosis: 28,\n        diagnosisTrend: 12,\n        totalDiagnosis: 1458,\n        totalDiagnosisTrend: 8,\n        totalCases: 876,\n        totalCasesTrend: 5,\n        newPatients: 15,\n        newPatientsTrend: -3\n      },\n      caseTags: [{\n        name: \"糖尿病视网膜病变\",\n        count: 156,\n        type: \"danger\",\n        size: 16\n      }, {\n        name: \"青光眼\",\n        count: 124,\n        type: \"warning\",\n        size: 15\n      }, {\n        name: \"白内障\",\n        count: 98,\n        type: \"\",\n        size: 14\n      }, {\n        name: \"AMD\",\n        count: 87,\n        type: \"info\",\n        size: 14\n      }, {\n        name: \"高血压视网膜病变\",\n        count: 76,\n        type: \"danger\",\n        size: 13\n      }, {\n        name: \"近视\",\n        count: 65,\n        type: \"\",\n        size: 13\n      }, {\n        name: \"正常\",\n        count: 210,\n        type: \"success\",\n        size: 17\n      }, {\n        name: \"其他异常\",\n        count: 60,\n        type: \"info\",\n        size: 12\n      }],\n      typicalCases: [{\n        id: \"PT20230001\",\n        diagnosis: \"糖尿病视网膜病变\",\n        image: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        time: \"2023-06-15\",\n        status: \"已确诊\",\n        statusType: \"danger\"\n      }, {\n        id: \"PT20230015\",\n        diagnosis: \"青光眼\",\n        image: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        time: \"2023-06-14\",\n        status: \"待复查\",\n        statusType: \"warning\"\n      }, {\n        id: \"PT20230023\",\n        diagnosis: \"正常\",\n        image: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        time: \"2023-06-13\",\n        status: \"已确认\",\n        statusType: \"success\"\n      }, {\n        id: \"PT20230028\",\n        diagnosis: \"AMD\",\n        image: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        time: \"2023-06-12\",\n        status: \"已确诊\",\n        statusType: \"danger\"\n      }, {\n        id: \"PT20230035\",\n        diagnosis: \"白内障\",\n        image: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        time: \"2023-06-11\",\n        status: \"待复查\",\n        statusType: \"warning\"\n      }, {\n        id: \"PT20230042\",\n        diagnosis: \"高血压视网膜病变\",\n        image: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        time: \"2023-06-10\",\n        status: \"已确诊\",\n        statusType: \"danger\"\n      }],\n      complianceDocs: [{\n        title: \"眼底图像采集规范V2.1\",\n        description: \"最新版眼底图像采集标准与操作指南\"\n      }, {\n        title: \"医疗数据保密协议\",\n        description: \"患者数据处理与保密规范\"\n      }, {\n        title: \"诊断报告标准模板\",\n        description: \"标准化眼底疾病诊断报告模板\"\n      }],\n      references: [{\n        title: \"基于深度学习的糖尿病视网膜病变自动检测\",\n        authors: \"张三, 李四, 王五\",\n        journal: \"中华眼科杂志, 2023\"\n      }, {\n        title: \"眼底图像分析在青光眼早期诊断中的应用\",\n        authors: \"刘一, 陈二\",\n        journal: \"临床眼科杂志, 2022\"\n      }, {\n        title: \"人工智能辅助眼底疾病诊断的研究进展\",\n        authors: \"赵六, 孙七\",\n        journal: \"国际眼科学杂志, 2023\"\n      }],\n      systemNotices: [{\n        title: \"系统更新通知\",\n        content: \"系统将于2023年6月20日凌晨2:00-4:00进行版本更新，请提前做好准备。\",\n        time: \"2023-06-15 10:30\"\n      }, {\n        title: \"新功能上线\",\n        content: \"批量诊断功能已上线，支持同时处理多达50组眼底图像，欢迎使用！\",\n        time: \"2023-06-12 14:15\"\n      }],\n      showNotification: false,\n      unreadNotifications: 2\n    };\n  },\n  methods: {\n    handleCommand(command) {\n      if (command === \"profile\") {\n        this.$router.push(\"/profile\");\n      } else if (command === \"settings\") {\n        this.$router.push(\"/settings\");\n      } else if (command === \"logout\") {\n        this.logout();\n      }\n    },\n    logout() {\n      localStorage.removeItem(\"isLoggedIn\");\n      this.$message.success(\"已安全退出系统\");\n      this.$router.push(\"/login\");\n    },\n    navigateTo(path) {\n      this.$router.push(path);\n    },\n    toggleNotification() {\n      this.showNotification = !this.showNotification;\n      if (this.showNotification) {\n        this.unreadNotifications = 0;\n      }\n    },\n    closeNotification() {\n      this.showNotification = false;\n    }\n  },\n  mounted() {\n    // 检查登录状态\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\n    if (!isLoggedIn) {\n      this.$router.push(\"/login\");\n    }\n  }\n};","map":{"version":3,"names":["name","data","activeMenu","userAvatar","stats","todayDiagnosis","diagnosisTrend","totalDiagnosis","totalDiagnosisTrend","totalCases","totalCasesTrend","newPatients","newPatientsTrend","caseTags","count","type","size","typicalCases","id","diagnosis","image","time","status","statusType","complianceDocs","title","description","references","authors","journal","systemNotices","content","showNotification","unreadNotifications","methods","handleCommand","command","$router","push","logout","localStorage","removeItem","$message","success","navigateTo","path","toggleNotification","closeNotification","mounted","isLoggedIn","getItem"],"sources":["E:\\Apollo\\Eye-Diagnose-System\\src\\views\\DashboardView.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard-container\">\r\n    <!-- 顶部导航栏 -->\r\n    <el-header class=\"header\">\r\n      <div class=\"logo\">\r\n        <img src=\"\" alt=\"Logo\" />\r\n        <span>眼底图像眼疾智能识别系统</span>\r\n      </div>\r\n      <el-menu\r\n        mode=\"horizontal\"\r\n        :default-active=\"activeMenu\"\r\n        class=\"main-menu\"\r\n        background-color=\"#304156\"\r\n        text-color=\"#fff\"\r\n        active-text-color=\"#409EFF\"\r\n        router\r\n      >\r\n        <el-menu-item index=\"/dashboard\">首页</el-menu-item>\r\n        <el-menu-item index=\"/diagnosis\">即时诊断中心</el-menu-item>\r\n        <el-menu-item index=\"/reports\">病例报告</el-menu-item>\r\n        <el-menu-item index=\"/analytics\">数据分析</el-menu-item>\r\n      </el-menu>\r\n      <div class=\"user-info\">\r\n        <el-dropdown trigger=\"click\" @command=\"handleCommand\">\r\n          <span class=\"el-dropdown-link\">\r\n            <el-avatar :size=\"40\" :src=\"userAvatar\"></el-avatar>\r\n          </span>\r\n          <template #dropdown>\r\n            <el-dropdown-menu>\r\n              <el-dropdown-item command=\"profile\">个人中心</el-dropdown-item>\r\n              <el-dropdown-item command=\"settings\">系统设置</el-dropdown-item>\r\n              <el-dropdown-item divided command=\"logout\"\r\n                >退出登录</el-dropdown-item\r\n              >\r\n            </el-dropdown-menu>\r\n          </template>\r\n        </el-dropdown>\r\n      </div>\r\n    </el-header>\r\n\r\n    <el-main class=\"main-content\">\r\n      <!-- 系统概览区域 -->\r\n      <div class=\"overview-section\">\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"6\">\r\n            <el-card class=\"stat-card\">\r\n              <div class=\"stat-icon\">\r\n                <i class=\"el-icon-data-analysis\"></i>\r\n              </div>\r\n              <div class=\"stat-info\">\r\n                <div class=\"stat-title\">今日诊断次数</div>\r\n                <div class=\"stat-value\">{{ stats.todayDiagnosis }}</div>\r\n                <div class=\"stat-trend\">\r\n                  <span :class=\"stats.diagnosisTrend > 0 ? 'up' : 'down'\">\r\n                    {{ stats.diagnosisTrend > 0 ? \"+\" : \"\"\r\n                    }}{{ stats.diagnosisTrend }}%\r\n                  </span>\r\n                  较昨日\r\n                </div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"6\">\r\n            <el-card class=\"stat-card\">\r\n              <div class=\"stat-icon\">\r\n                <i class=\"el-icon-collection\"></i>\r\n              </div>\r\n              <div class=\"stat-info\">\r\n                <div class=\"stat-title\">累计诊断量</div>\r\n                <div class=\"stat-value\">{{ stats.totalDiagnosis }}</div>\r\n                <div class=\"stat-trend\">\r\n                  <span class=\"up\">+{{ stats.totalDiagnosisTrend }}%</span>\r\n                  较上月\r\n                </div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"6\">\r\n            <el-card class=\"stat-card\">\r\n              <div class=\"stat-icon\">\r\n                <i class=\"el-icon-document\"></i>\r\n              </div>\r\n              <div class=\"stat-info\">\r\n                <div class=\"stat-title\">病例总数</div>\r\n                <div class=\"stat-value\">{{ stats.totalCases }}</div>\r\n                <div class=\"stat-trend\">\r\n                  <span class=\"up\">+{{ stats.totalCasesTrend }}%</span>\r\n                  较上月\r\n                </div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"6\">\r\n            <el-card class=\"stat-card\">\r\n              <div class=\"stat-icon\">\r\n                <i class=\"el-icon-user\"></i>\r\n              </div>\r\n              <div class=\"stat-info\">\r\n                <div class=\"stat-title\">今日新增患者</div>\r\n                <div class=\"stat-value\">{{ stats.newPatients }}</div>\r\n                <div class=\"stat-trend\">\r\n                  <span :class=\"stats.newPatientsTrend > 0 ? 'up' : 'down'\">\r\n                    {{ stats.newPatientsTrend > 0 ? \"+\" : \"\"\r\n                    }}{{ stats.newPatientsTrend }}%\r\n                  </span>\r\n                  较昨日\r\n                </div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n\r\n      <!-- 快速操作区域 -->\r\n      <div class=\"quick-actions-section\">\r\n        <h2 class=\"section-title\">快速操作</h2>\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"8\">\r\n            <el-card\r\n              class=\"action-card\"\r\n              @click=\"navigateTo('/diagnosis/single')\"\r\n            >\r\n              <div class=\"action-icon\">\r\n                <i class=\"el-icon-picture-outline\"></i>\r\n              </div>\r\n              <div class=\"action-title\">单图诊断</div>\r\n              <div class=\"action-desc\">上传左右眼图像进行单次诊断</div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"8\">\r\n            <el-card\r\n              class=\"action-card\"\r\n              @click=\"navigateTo('/diagnosis/batch')\"\r\n            >\r\n              <div class=\"action-icon\">\r\n                <i class=\"el-icon-files\"></i>\r\n              </div>\r\n              <div class=\"action-title\">批量诊断</div>\r\n              <div class=\"action-desc\">上传多组眼底图像进行批量处理</div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"8\">\r\n            <el-card class=\"action-card\" @click=\"navigateTo('/reports')\">\r\n              <div class=\"action-icon\">\r\n                <i class=\"el-icon-time\"></i>\r\n              </div>\r\n              <div class=\"action-title\">历史记录</div>\r\n              <div class=\"action-desc\">查看历史诊断记录和报告</div>\r\n            </el-card>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n\r\n      <!-- 病例展示区域 -->\r\n      <div class=\"cases-section\">\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"8\">\r\n            <h2 class=\"section-title\">病例标签</h2>\r\n            <el-card class=\"tag-cloud-card\">\r\n              <div class=\"tag-cloud\">\r\n                <el-tag\r\n                  v-for=\"tag in caseTags\"\r\n                  :key=\"tag.name\"\r\n                  :type=\"tag.type\"\r\n                  effect=\"plain\"\r\n                  :style=\"{ fontSize: tag.size + 'px' }\"\r\n                  class=\"case-tag\"\r\n                >\r\n                  {{ tag.name }} ({{ tag.count }})\r\n                </el-tag>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"16\">\r\n            <h2 class=\"section-title\">典型病例</h2>\r\n            <el-row :gutter=\"20\">\r\n              <el-col\r\n                :xs=\"24\"\r\n                :sm=\"12\"\r\n                :lg=\"8\"\r\n                v-for=\"(item, index) in typicalCases\"\r\n                :key=\"index\"\r\n              >\r\n                <el-card class=\"case-card\" shadow=\"hover\">\r\n                  <div class=\"case-image\">\r\n                    <img :src=\"item.image\" alt=\"眼底图像\" />\r\n                  </div>\r\n                  <div class=\"case-info\">\r\n                    <div class=\"case-title\">{{ item.diagnosis }}</div>\r\n                    <div class=\"case-meta\">\r\n                      <span class=\"case-id\">ID: {{ item.id }}</span>\r\n                      <span class=\"case-time\">{{ item.time }}</span>\r\n                    </div>\r\n                    <el-tag size=\"small\" :type=\"item.statusType\">{{\r\n                      item.status\r\n                    }}</el-tag>\r\n                  </div>\r\n                </el-card>\r\n              </el-col>\r\n            </el-row>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n\r\n      <!-- 资源中心 -->\r\n      <div class=\"resources-section\">\r\n        <h2 class=\"section-title\">资源中心</h2>\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"12\">\r\n            <el-card class=\"resource-card\">\r\n              <template #header>\r\n                <div class=\"resource-header\">\r\n                  <span>合规文档下载中心</span>\r\n                  <el-button type=\"text\">查看全部</el-button>\r\n                </div>\r\n              </template>\r\n              <div class=\"resource-list\">\r\n                <div\r\n                  v-for=\"(doc, index) in complianceDocs\"\r\n                  :key=\"index\"\r\n                  class=\"resource-item\"\r\n                >\r\n                  <div class=\"resource-info\">\r\n                    <div class=\"resource-title\">{{ doc.title }}</div>\r\n                    <div class=\"resource-desc\">{{ doc.description }}</div>\r\n                  </div>\r\n                  <el-button type=\"primary\" size=\"small\" icon=\"el-icon-download\"\r\n                    >下载</el-button\r\n                  >\r\n                </div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\">\r\n            <el-card class=\"resource-card\">\r\n              <template #header>\r\n                <div class=\"resource-header\">\r\n                  <span>医学参考文献库</span>\r\n                  <el-button type=\"text\">查看全部</el-button>\r\n                </div>\r\n              </template>\r\n              <div class=\"resource-list\">\r\n                <div\r\n                  v-for=\"(ref, index) in references\"\r\n                  :key=\"index\"\r\n                  class=\"resource-item\"\r\n                >\r\n                  <div class=\"resource-info\">\r\n                    <div class=\"resource-title\">{{ ref.title }}</div>\r\n                    <div class=\"resource-desc\">\r\n                      {{ ref.authors }} - {{ ref.journal }}\r\n                    </div>\r\n                  </div>\r\n                  <el-button type=\"primary\" size=\"small\" icon=\"el-icon-view\"\r\n                    >查看</el-button\r\n                  >\r\n                </div>\r\n              </div>\r\n            </el-card>\r\n         