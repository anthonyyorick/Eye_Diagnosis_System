  <h1 class=\"page-title\">数据分析中心</h1>\r\n        <div class=\"export-actions\">\r\n          <el-button\r\n            type=\"primary\"\r\n            icon=\"el-icon-download\"\r\n            @click=\"exportData('csv')\"\r\n            >导出CSV</el-button\r\n          >\r\n          <el-button\r\n            type=\"success\"\r\n            icon=\"el-icon-document\"\r\n            @click=\"exportData('pdf')\"\r\n            >导出PDF</el-button\r\n          >\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 添加顶部统计指标 -->\r\n      <el-row :gutter=\"20\" class=\"chart-row\">\r\n        <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"8\">\r\n          <el-card class=\"chart-card gauge-card\">\r\n            <template #header>\r\n              <div class=\"chart-header\">\r\n                <h3>今日医疗总收入</h3>\r\n              </div>\r\n            </template>\r\n            <div ref=\"revenueGaugeChart\" class=\"gauge-container\"></div>\r\n          </el-card>\r\n        </el-col>\r\n        <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"8\">\r\n          <el-card class=\"chart-card gauge-card\">\r\n            <template #header>\r\n              <div class=\"chart-header\">\r\n                <h3>今日医疗总人次</h3>\r\n              </div>\r\n            </template>\r\n            <div ref=\"patientGaugeChart\" class=\"gauge-container\"></div>\r\n          </el-card>\r\n        </el-col>\r\n        <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"8\">\r\n          <el-card class=\"chart-card\">\r\n            <template #header>\r\n              <div class=\"chart-header\">\r\n                <h3>患者流量分布</h3>\r\n              </div>\r\n            </template>\r\n            <div ref=\"patientFlowChart\" class=\"gauge-container\"></div>\r\n          </el-card>\r\n        </el-col>\r\n      </el-row>\r\n\r\n      <el-row :gutter=\"20\" class=\"chart-row\">\r\n        <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n          <el-card class=\"chart-card\">\r\n            <template #header>\r\n              <div class=\"chart-header\">\r\n                <h3>门诊人次变化趋势</h3>\r\n              </div>\r\n            </template>\r\n            <div ref=\"visitTrendChart\" class=\"chart-container\"></div>\r\n          </el-card>\r\n        </el-col>\r\n        <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n          <el-card class=\"chart-card\">\r\n            <template #header>\r\n              <div class=\"chart-header\">\r\n                <h3>平均等待/诊疗时间</h3>\r\n              </div>\r\n            </template>\r\n            <div ref=\"waitingTimeChart\" class=\"chart-container\"></div>\r\n          </el-card>\r\n        </el-col>\r\n      </el-row>\r\n\r\n      <!-- 继续保留原有的图表 -->\r\n      <el-row :gutter=\"20\" class=\"chart-row\"> // ... existing code ... </el-row>\r\n\r\n      <!-- 新增科室排行和百分比显示区域 -->\r\n      <el-row :gutter=\"20\" class=\"chart-row\">\r\n        <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n          <el-card class=\"chart-card\">\r\n            <template #header>\r\n              <div class=\"chart-header\">\r\n                <h3>门诊收入TOP5</h3>\r\n              </div>\r\n            </template>\r\n            <div ref=\"deptRevenueChart\" class=\"chart-container\"></div>\r\n          </el-card>\r\n        </el-col>\r\n        <el-col :xs=\"24\" :sm=\"24\" :md=\"12\" :lg=\"12\">\r\n          <el-card class=\"chart-card\">\r\n            <template #header>\r\n              <div class=\"chart-header\">\r\n                <h3>健康人次TOP5</h3>\r\n              </div>\r\n            </template>\r\n            <div ref=\"deptVisitChart\" class=\"chart-container\"></div>\r\n          </el-card>\r\n        </el-col>\r\n      </el-row>\r\n\r\n      <el-card class=\"progress-card\">\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"6\" :lg=\"6\">\r\n            <div class=\"progress-item\">\r\n              <h4>门诊占比</h4>\r\n              <div ref=\"outpatientProgress\" class=\"progress-chart\"></div>\r\n              <div class=\"progress-value\">20%</div>\r\n            </div>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"6\" :lg=\"6\">\r\n            <div class=\"progress-item\">\r\n              <h4>住院占比</h4>\r\n              <div ref=\"inpatientProgress\" class=\"progress-chart\"></div>\r\n              <div class=\"progress-value\">10%</div>\r\n            </div>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"6\" :lg=\"6\">\r\n            <div class=\"progress-item\">\r\n              <h4>抗菌药占比</h4>\r\n              <div ref=\"antibioticProgress\" class=\"progress-chart\"></div>\r\n              <div class=\"progress-value\">6%</div>\r\n            </div>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"6\" :lg=\"6\">\r\n            <div class=\"progress-item\">\r\n              <h4>医院收入</h4>\r\n              <div ref=\"hospitalRevenueProgress\" class=\"progress-chart\"></div>\r\n              <div class=\"progress-value\">19%</div>\r\n            </div>\r\n          </el-col>\r\n        </el-row>\r\n      </el-card>\r\n\r\n      <!-- 保留原有的异常病例分析 -->\r\n      <el-card class=\"anomaly-card\"> // ... existing code ... </el-card>\r\n    </div>\r\n  </app-layout>\r\n</template>\r\n\r\n<script>\r\nimport AppLayout from \"@/components/AppLayout.vue\";\r\nimport * as echarts from \"echarts\";\r\n\r\nexport default {\r\n  name: \"AnalyticsView\",\r\n  components: {\r\n    AppLayout,\r\n  },\r\n  data() {\r\n    return {\r\n      filterForm: {\r\n        timeRange: \"30days\",\r\n        department: [\"outpatient\"],\r\n      },\r\n      trendChartType: \"daily\",\r\n      charts: {\r\n        trendChart: null,\r\n        diseaseDistributionChart: null,\r\n        ageDistributionChart: null,\r\n        genderDistributionChart: null,\r\n        revenueGaugeChart: null,\r\n        patientGaugeChart: null,\r\n        patientFlowChart: null,\r\n        visitTrendChart: null,\r\n        waitingTimeChart: null,\r\n        deptRevenueChart: null,\r\n        deptVisitChart: null,\r\n        outpatientProgress: null,\r\n        inpatientProgress: null,\r\n        antibioticProgress: null,\r\n        hospitalRevenueProgress: null,\r\n      },\r\n      anomalyCases: [],\r\n    };\r\n  },\r\n  methods: {\r\n    updateCharts() {\r\n      this.updateTrendChart();\r\n      this.updateDiseaseDistributionChart();\r\n      this.updateAgeDistributionChart();\r\n      this.updateGenderDistributionChart();\r\n      this.updateAnomalyCases();\r\n\r\n      // 新增图表的更新方法\r\n      this.updateRevenueGaugeChart();\r\n      this.updatePatientGaugeChart();\r\n      this.updatePatientFlowChart();\r\n      this.updateVisitTrendChart();\r\n      this.updateWaitingTimeChart();\r\n      this.updateDeptRevenueChart();\r\n      this.updateDeptVisitChart();\r\n      this.updateProgressCharts();\r\n    },\r\n\r\n    // ... existing methods ...\r\n\r\n    // 新增图表初始化方法\r\n    updateRevenueGaugeChart() {\r\n      if (!this.charts.revenueGaugeChart) {\r\n        this.charts.revenueGaugeChart = echarts.init(\r\n          this.$refs.revenueGaugeChart\r\n        );\r\n      }\r\n\r\n      const option = {\r\n        series: [\r\n          {\r\n            type: \"gauge\",\r\n            startAngle: 90,\r\n            endAngle: -270,\r\n            pointer: {\r\n              show: false,\r\n            },\r\n            progress: {\r\n              show: true,\r\n              overlap: false,\r\n              roundCap: true,\r\n              clip: false,\r\n              itemStyle: {\r\n                color: \"#409EFF\",\r\n              },\r\n            },\r\n            axisLine: {\r\n              lineStyle: {\r\n                width: 20,\r\n                color: [[1, \"#E1E1E1\"]],\r\n              },\r\n            },\r\n            splitLine: {\r\n              show: false,\r\n            },\r\n            axisTick: {\r\n              show: false,\r\n            },\r\n            axisLabel: {\r\n              show: false,\r\n            },\r\n            data: [\r\n              {\r\n                value: 70,\r\n                name: \"万元\",\r\n                title: {\r\n                  offsetCenter: [\"0%\", \"0%\"],\r\n                },\r\n                detail: {\r\n                  offsetCenter: [\"0%\", \"0%\"],\r\n                },\r\n              },\r\n            ],\r\n            title: {\r\n              fontSize: 14,\r\n            },\r\n            detail: {\r\n              width: 80,\r\n              height: 14,\r\n              fontSize: 28,\r\n              color: \"#fff\",\r\n              backgroundColor: \"auto\",\r\n              formatter: \"{value}\",\r\n              borderRadius: 3,\r\n            },\r\n          },\r\n        ],\r\n      };\r\n\r\n      this.charts.revenueGaugeChart.setOption(option);\r\n    },\r\n\r\n    updatePatientGaugeChart() {\r\n      if (!this.charts.patientGaugeChart) {\r\n        this.charts.patientGaugeChart = echarts.init(\r\n          this.$refs.patientGaugeChart\r\n        );\r\n      }\r\n\r\n      const option = {\r\n        series: [\r\n          {\r\n            type: \"gauge\",\r\n            startAngle: 90,\r\n            endAngle: -270,\r\n            pointer: {\r\n              show: false,\r\n            },\r\n            progress: {\r\n              show: true,\r\n              overlap: false,\r\n              roundCap: true,\r\n              clip: false,\r\n              itemStyle: {\r\n                color: \"#67C23A\",\r\n              },\r\n            },\r\n            axisLine: {\r\n              lineStyle: {\r\n                width: 20,\r\n                color: [[1, \"#E1E1E1\"]],\r\n              },\r\n            },\r\n            splitLine: {\r\n              show: false,\r\n            },\r\n            axisTick: {\r\n              show: false,\r\n            },\r\n            axisLabel: {\r\n              show: false,\r\n            },\r\n           