");\r\n\r\n      // 更新住院占比仪表盘\r\n      if (!this.charts.inpatientProgress) {\r\n        this.charts.inpatientProgress = echarts.init(\r\n          this.$refs.inpatientProgress\r\n        );\r\n      }\r\n      this.initProgressChart(this.charts.inpatientProgress, 10, \"#2E9CDB\");\r\n\r\n      // 更新抗菌药占比仪表盘\r\n      if (!this.charts.antibioticProgress) {\r\n        this.charts.antibioticProgress = echarts.init(\r\n          this.$refs.antibioticProgress\r\n        );\r\n      }\r\n      this.initProgressChart(this.charts.antibioticProgress, 6, \"#13CEF6\");\r\n\r\n      // 更新医院收入仪表盘\r\n      if (!this.charts.hospitalRevenueProgress) {\r\n        this.charts.hospitalRevenueProgress = echarts.init(\r\n          this.$refs.hospitalRevenueProgress\r\n        );\r\n      }\r\n      this.initProgressChart(\r\n        this.charts.hospitalRevenueProgress,\r\n        19,\r\n        \"#8C61FF\"\r\n      );\r\n    },\r\n\r\n    initProgressChart(chart, value, color) {\r\n      const option = {\r\n        series: [\r\n          {\r\n            type: \"gauge\",\r\n            startAngle: 180,\r\n            endAngle: 0,\r\n            min: 0,\r\n            max: 100,\r\n            splitNumber: 10,\r\n            axisLine: {\r\n              lineStyle: {\r\n                width: 6,\r\n                color: [\r\n                  [value / 100, color],\r\n                  [1, \"#E1E1E1\"],\r\n                ],\r\n              },\r\n            },\r\n            pointer: {\r\n              show: false,\r\n            },\r\n            axisTick: {\r\n              show: false,\r\n            },\r\n            splitLine: {\r\n              show: false,\r\n            },\r\n            axisLabel: {\r\n              show: false,\r\n            },\r\n            detail: {\r\n              show: false,\r\n            },\r\n          },\r\n        ],\r\n      };\r\n\r\n      chart.setOption(option);\r\n    },\r\n\r\n    resetFilter() {\r\n      this.filterForm = {\r\n        timeRan