n            name: \"等待时间(分钟)\",\r\n            type: \"line\",\r\n            data: waitingData,\r\n            lineStyle: {\r\n              color: \"#3A84FF\",\r\n              width: 2,\r\n            },\r\n            symbol: \"circle\",\r\n            symbolSize: 6,\r\n            itemStyle: {\r\n              color: \"#3A84FF\",\r\n            },\r\n            smooth: true,\r\n          },\r\n          {\r\n            name: \"诊疗时间(分钟)\",\r\n            type: \"line\",\r\n            data: consultingData,\r\n            lineStyle: {\r\n              color: \"#FF6B6B\",\r\n              width: 2,\r\n            },\r\n            symbol: \"circle\",\r\n            symbolSize: 6,\r\n            itemStyle: {\r\n              color: \"#FF6B6B\",\r\n            },\r\n            smooth: true,\r\n          },\r\n        ],\r\n      };\r\n\r\n      this.charts.waitingTimeChart.setOption(option);\r\n    },\r\n\r\n    updateDeptRevenueChart() {\r\n      if (!this.charts.deptRevenueChart) {\r\n        this.charts.deptRevenueChart = echarts.init(\r\n          this.$refs.deptRevenueChart\r\n        );\r\n      }\r\n\r\n      const option = {\r\n        tooltip: {\r\n          trigger: \"axis\",\r\n          axisPointer: {\r\n            type: \"shadow\",\r\n          },\r\n        },\r\n        grid: {\r\n          left: \"3%\",\r\n          right: \"4%\",\r\n          bottom: \"3%\",\r\n          containLabel: true,\r\n        },\r\n        xAxis: {\r\n          type: \"value\",\r\n        },\r\n        yAxis: {\r\n          type: \"category\",\r\n          data: [\"眼科门诊\", \"眼科住院\", \"专家门诊\", \"手术科室\", \"口腔科\"],\r\n        },\r\n        series: [\r\n          {\r\n            name: \"收入(万元)\",\r\n            type: \"bar\",\r\n            data: [20788, 13081, 6890, 6455, 3972],\r\n            itemStyle: {\r\n              color: function (params) {\r\n                const colorList = [\r\n                  \"#00C0FF\",\r\n                  \"#2467D2\",\r\n             