<el-col :xs=\"12\" :sm=\"12\" :md=\"6\" :lg=\"6\">\r\n            <el-card class=\"stat-card\" style=\"background-color: #fff\">\r\n              <div class=\"stat-content\">\r\n                <div class=\"stat-left\">\r\n                  <div class=\"stat-value\">{{ stats.newPatients }}</div>\r\n                  <div class=\"stat-trend\">\r\n                    <span :class=\"stats.newPatientsTrend > 0 ? 'up' : 'down'\">\r\n                      {{ stats.newPatientsTrend > 0 ? \"+\" : \"\"\r\n                      }}{{ stats.newPatientsTrend }}% 较昨日\r\n                    </span>\r\n                  </div>\r\n                  <div class=\"stat-title\">今日新增患者</div>\r\n                </div>\r\n                <div class=\"stat-chart\" ref=\"newPatientsChart\"></div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"12\" :sm=\"12\" :md=\"6\" :lg=\"6\">\r\n            <el-card class=\"stat-card\" style=\"background-color: #fff\">\r\n              <div class=\"stat-content\">\r\n                <div class=\"stat-left\">\r\n                  <div class=\"stat-value\">{{ stats.totalCases }}</div>\r\n                  <div class=\"stat-trend\">\r\n                    <span class=\"up\">+{{ stats.totalCasesTrend }}% 较上月</span>\r\n                  </div>\r\n                  <div class=\"stat-title\">病例总数</div>\r\n                </div>\r\n                <div class=\"stat-chart\" ref=\"totalCasesChart\"></div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"12\" :sm=\"12\" :md=\"6\" :lg=\"6\">\r\n            <el-card class=\"stat-card\" style=\"background-color: #fff\">\r\n              <div class=\"stat-content\">\r\n                <div class=\"stat-left\">\r\n                  <div class=\"stat-value\">{{ stats.totalDiagnosis }}</div>\r\n                  <div class=\"stat-trend\">\r\n                    <span class=\"up\"\r\n                      >+{{ stats.totalDiagnosisTrend }}% 较上月</span\r\n                    >\r\n                  </div>\r\n                  <div class=\"stat-title\">累计诊断量</div>\r\n                </div>\r\n                <div class=\"stat-chart\" ref=\"totalDiagnosisChart\"></div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n\r\n      <!-- 快速入口区域 -->\r\n      <div class=\"quick-actions-section\">\r\n        <h2 class=\"section-title\">快速入口</h2>\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"6\" :lg=\"6\">\r\n            <el-card class=\"action-card\" @click=\"navigateTo('/diagnosis')\">\r\n              <div class=\"action-image\">\r\n                <img\r\n                  src=\"@/assets/images/personal-diagnosis.jpg\"\r\n                  alt=\"个人诊断\"\r\n                />\r\n              </div>\r\n              <div class=\"action-content\">\r\n                <div class=\"action-title\">个人诊断</div>\r\n                <div class=\"action-desc\">\r\n                  快速进行个人病症诊断，提供专业建议\r\n                </div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"6\" :lg=\"6\">\r\n            <el-card\r\n              class=\"action-card\"\r\n              @click=\"navigateTo('/diagnosis?tab=batch')\"\r\n            >\r\n              <div class=\"action-image\">\r\n                <img src=\"@/assets/images/batch-diagnosis.png\" alt=\"批量诊断\" />\r\n              </div>\r\n              <div class=\"action-content\">\r\n                <div class=\"action-title\">批量诊断</div>\r\n                <div class=\"action-desc\">高效处理多个病例，提升诊断效率</div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"6\" :lg=\"6\">\r\n            <el-card class=\"action-card\" @click=\"navigateTo('/reports')\">\r\n              <div class=\"action-image\">\r\n                <img src=\"@/assets/images/history-records.jpg\" alt=\"历史记录\" />\r\n              </div>\r\n              <div class=\"action-content\">\r\n                <div class=\"action-title\">历史记录</div>\r\n                <div class=\"action-desc\">查看往日诊断记录，跟踪诊疗进展</div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\" :md=\"6\" :lg=\"6\">\r\n            <el-card class=\"action-card\" @click=\"navigateTo('/case-reports')\">\r\n              <div class=\"action-image\">\r\n                <img src=\"@/assets/images/case-management.jpg\" alt=\"病例查询\" />\r\n              </div>\r\n              <div class=\"action-content\">\r\n                <div class=\"action-title\">病例查询</div>\r\n                <div class=\"action-desc\">快速查询患者病历与诊断结果</div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n\r\n      <!-- 病例展示区域 -->\r\n      <div class=\"cases-section\">\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"8\">\r\n            <h2 class=\"section-title\">病例标签</h2>\r\n            <el-card class=\"tag-cloud-card\">\r\n              <div class=\"tag-cloud\">\r\n                <el-tag\r\n                  v-for=\"tag in caseTags\"\r\n                  :key=\"tag.name\"\r\n                  :type=\"tag.type\"\r\n                  effect=\"plain\"\r\n                  :style=\"{ fontSize: tag.size + 'px' }\"\r\n                  class=\"case-tag\"\r\n                >\r\n                  {{ tag.name }} ({{ tag.count }})\r\n                </el-tag>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"24\" :md=\"16\">\r\n            <h2 class=\"section-title\">典型病例</h2>\r\n            <el-row :gutter=\"20\">\r\n              <el-col\r\n                :xs=\"24\"\r\n                :sm=\"12\"\r\n                :lg=\"8\"\r\n                v-for=\"(item, index) in typicalCases\"\r\n                :key=\"index\"\r\n              >\r\n                <el-card class=\"case-card\" shadow=\"hover\">\r\n                  <div class=\"case-image\">\r\n                    <img :src=\"item.image\" alt=\"眼底图像\" />\r\n                  </div>\r\n                  <div class=\"case-info\">\r\n                    <div class=\"case-title\">{{ item.diagnosis }}</div>\r\n                    <div class=\"case-meta\">\r\n                      <span class=\"case-id\">ID: {{ item.id }}</span>\r\n                      <span class=\"case-time\">{{ item.time }}</span>\r\n                    </div>\r\n                    <el-tag size=\"small\" :type=\"item.statusType\">{{\r\n                      item.status\r\n                    }}</el-tag>\r\n                  </div>\r\n                </el-card>\r\n              </el-col>\r\n            </el-row>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n\r\n      <!-- 资源中心 -->\r\n      <div class=\"resources-section\">\r\n        <h2 class=\"section-title\">资源中心</h2>\r\n        <el-row :gutter=\"20\">\r\n          <el-col :xs=\"24\" :sm=\"12\">\r\n            <el-card class=\"resource-card\">\r\n              <template #header>\r\n                <div class=\"resource-header\">\r\n                  <span>合规文档下载中心</span>\r\n                  <el-button type=\"text\">查看全部</el-button>\r\n                </div>\r\n              </template>\r\n              <div class=\"resource-list\">\r\n                <div\r\n                  v-for=\"(doc, index) in complianceDocs\"\r\n                  :key=\"index\"\r\n                  class=\"resource-item\"\r\n                >\r\n                  <div class=\"resource-info\">\r\n                    <div class=\"resource-title\">{{ doc.title }}</div>\r\n                    <div class=\"resource-desc\">{{ doc.description }}</div>\r\n                  </div>\r\n                  <el-button type=\"primary\" size=\"small\" icon=\"el-icon-download\"\r\n                    >下载</el-button\r\n                  >\r\n                </div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :xs=\"24\" :sm=\"12\">\r\n            <el-card class=\"resource-card\">\r\n              <template #header>\r\n                <div class=\"resource-header\">\r\n                  <span>医学参考文献库</span>\r\n                  <el-button type=\"text\">查看全部</el-button>\r\n                </div>\r\n              </template>\r\n              <div class=\"resource-list\">\r\n                <div\r\n                  v-for=\"(ref, index) in references\"\r\n                  :key=\"index\"\r\n                  class=\"resource-item\"\r\n                >\r\n                  <div class=\"resource-info\">\r\n                    <div class=\"resource-title\">{{ ref.title }}</div>\r\n                    <div class=\"resource-desc\">\r\n                      {{ ref.authors }} - {{ ref.journal }}\r\n                    </div>\r\n                  </div>\r\n                  <el-button type=\"primary\" size=\"small\" icon=\"el-icon-view\"\r\n                    >查看</el-button\r\n                  >\r\n                </div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n    </div>\r\n  </app-layout>\r\n</template>\r\n\r\n<script>\r\nimport AppLayout from \"@/components/AppLayout.vue\";\r\n\r\nexport default {\r\n  name: \"DashboardView\",\r\n  components: {\r\n    AppLayout,\r\n  },\r\n  data() {\r\n    return {\r\n      stats: {\r\n        todayDiagnosis: 286,\r\n        diagnosisTrend: 12.5,\r\n        totalDiagnosis: 15769,\r\n        totalDiagnosisTrend: 8.2,\r\n        totalCases: 28456,\r\n        totalCasesTrend: 15.3,\r\n        newPatients: 342,\r\n        newPatientsTrend: -5.8,\r\n        diagnosisChartData: [\r\n          30, 40, 35, 50, 49, 60, 70, 91, 125, 160, 180, 210, 220, 182, 191,\r\n          234, 290, 330, 310, 286,\r\n        ],\r\n