pe: \"success\"\n      }],\n      typicalCases: [{\n        id: \"5\",\n        diagnosis: \"糖尿病视网膜病变\",\n        image: \"https://pic3.zhimg.com/100/v2-32577c3202d56d08d1a897d402b000fe_qhd.jpg\",\n        time: \"2023-06-15\",\n        status: \"已确诊\",\n        statusType: \"danger\"\n      }, {\n        id: \"30\",\n        diagnosis: \"青光眼\",\n        image: \"https://pic4.zhimg.com/100/v2-113776afcd6e82ed437c1418a858de73_r.jpg\",\n        time: \"2023-06-14\",\n        status: \"待复查\",\n        statusType: \"warning\"\n      }, {\n        id: \"1\",\n        diagnosis: \"正常\",\n        image: \"https://picx.zhimg.com/100/v2-f2c50c067ae00c9b43f986154bb67571_qhd.jpg\",\n        time: \"2023-06-13\",\n        status: \"已确认\",\n        statusType: \"success\"\n      }],\n      complianceDocs: [{\n        title: \"眼底图像采集规范V2.1\",\n        description: \"最新版眼底图像采集标准与操作指南\"\n      }, {\n        title: \"医疗数据保密协议\",\n        description: \"患者数据处理与保密规范\"\n      }, {\n        title: \"诊断报告标准模板\",\n        description: \"标准化眼底疾病诊断报告模板\"\n      }],\n      references: [{\n        title: \"基于深度学习的糖尿病视网膜病变自动检测\",\n        authors: \"张三, 李四, 王五\",\n        journal: \"中华眼科杂志, 2023\"\n      }, {\n        title: \"眼底图像分析在青光眼早期诊断中的应用\",\n        authors: \"刘一, 陈二\",\n        journal: \"临床眼科杂志, 2022\"\n      }, {\n        title: \"人工智能辅助眼底疾病诊断的研究进展\",\n        authors: \"赵六, 孙七\",\n        journal: \"国际眼科学杂志, 2023\"\n      }]\n    };\n  },\n  methods: {\n    formatDate(date) {\n      const d = new Date(date);\n      return `${d.getFullYear()}年 ${d.getMonth() + 1}月`;\n    },\n    formatDay(day) {\n      return day ? day.split(\"-\")[2] : \"\";\n    },\n    navigateTo(path) {\n      this.$router.push(path);\n    },\n    initCharts() {\n      this.initTrendChart(\"todayDiagnosisChart\", this.stats.diagnosisChartData, \"#409EFF\");\n      this.initTrendChart(\"totalDiagnosisChart\", this.stats.totalDiagnosisChartData, \"#409EFF\");\n      this.initTrendChart(\"totalCasesChart\", this.stats.totalCasesChartData, \"#409EFF\");\n      this.initTrendChart(\"newPatientsChart\", this.stats.newPatientsChartData, this.stats.newPatientsTrend > 0 ? \"#67C23A\" : \"#F56C6C\");\n    },\n    initTrendChart(refName, data, color) {\n      const chartDom = this.$refs[refName];\n      const myChart = this.$echarts.init(chartDom);\n      const option = {\n        grid: {\n          left: 0,\n          right: 0,\n          top: 0,\n          bottom: 0\n        },\n        xAxis: {\n          type: \"category\",\n          show: false,\n          boundaryGap: false\n        },\n        yAxis: {\n          type: \"value\",\n          show: false\n        },\n        series: [{\n          data: data,\n          type: \"line\",\n          smooth: true,\n          symbol: \"none\",\n          areaStyle: {\n            color: {\n              type: \"linear\",\n              x: 0,\n              y: 0,\n              x2: 0,\n              y2: 1,\n              colorStops: [{\n                offset: 0,\n                color: color // 渐变起始颜色\n              }, {\n                offset: 1,\n                color: \"rgba(255, 255, 255, 0.1)\" // 渐变结束颜色\n              }]\n            }\n          },\n          lineStyle: {\n            color: color\n          }\n        }]\n      };\n      myChart.setOption(option);\n\n      // 保存图表实例以便在窗口大小变化时重新渲染\n      if (!this.charts) {\n        this.charts = {};\n      }\n      this.charts[refName] = myChart;\n    },\n    handleResize() {\n      if (this.charts) {\n        Object.values(this.charts).forEach(chart => {\n          chart.resize();\n        });\n      }\n    },\n    isToday(day) {\n      const today = new Date().toISOString().split(\"T\")[0];\n      return day === today;\n    }\n  },\n  mounted() {\n    // 检查登录状态\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\n    if (!isLoggedIn) {\n      this.$router.push(\"/login\");\n    }\n\n    // 初始化图表\n    this.$nextTick(() => {\n      this.initCharts();\n\n      // 添加窗口大小变化监听\n      window.addEventListener(\"resize\", this.handleResize);\n    });\n  },\n  beforeUnmount() {\n    // 移除窗口大小变化监听\n    window.removeEventListener(\"resize\", this.handleResize);\n\n    // 销毁图表实例\n    if (this.charts) {\n      Object.values(this.charts).forEach(chart => {\n        chart.dispose();\n      });\n    }\n  }\n};\nexport default /*@__PURE__*/Object.assign(__default__, {\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const currentDate = new Date().toLocaleDateString(\"zh-CN\", {\n      year: \"numeric\",\n      month: \"long\",\n      day: \"numeric\"\n    });\n    const currentWeekday = new Date().toLocaleDateString(\"zh-CN\", {\n      weekday: \"long\"\n    });\n    const __returned__ = {\n      currentDate,\n      currentWeekday,\n      AppLayout\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n});","map":{"version":3,"names":["AppLayout","__default__","name","components","data","stats","todayDiagnosis","diagnosisTrend","totalDiagnosis","totalDiagnosisTrend","totalCases","totalCasesTrend","newPatients","newPatientsTrend","diagnosisChartData","totalDiagnosisChartData","totalCasesChartData","newPatientsChartData","caseTags","count","size","type","typicalCases","id","diagnosis","image","time","status","statusType","complianceDocs","title","description","references","authors","journal","methods","formatDate","date","d","Date","getFullYear","getMonth","formatDay","day","split","navigateTo","path","$router","push","initCharts","initTrendChart","refName","color","chartDom","$refs","myChart","$echarts","init","option","grid","left","right","top","bottom","xAxis","show","boundaryGap","yAxis","series","smooth","symbol","areaStyle","x","y","x2","y2","colorStops","offset","lineStyle","setOption","charts","handleResize","Object","values","forEach","chart","resize","isToday","today","toISOString","mounted","isLoggedIn","local