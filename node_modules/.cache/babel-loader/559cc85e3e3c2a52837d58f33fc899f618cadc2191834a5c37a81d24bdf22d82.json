{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport AppLayout from \"@/components/AppLayout.vue\";\nexport default {\n  name: \"ReportDetailView\",\n  components: {\n    AppLayout\n  },\n  data() {\n    return {\n      reportId: null,\n      doctorNotes: \"\",\n      treatmentPlan: \"\",\n      isEditing: false,\n      isPrinting: false,\n      diseaseCategories: [\"糖尿病视网膜病变\", \"青光眼\", \"白内障\", \"AMD\", \"高血压视网膜病变\", \"近视\", \"其他异常\", \"正常\"],\n      report: {\n        id: \"\",\n        time: \"\",\n        doctor: \"\",\n        leftEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        rightEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        leftEye: {\n          diagnosis: \"\",\n          confidence: 0,\n          probabilities: []\n        },\n        rightEye: {\n          diagnosis: \"\",\n          confidence: 0,\n          probabilities: []\n        },\n        finalDiagnosis: \"\",\n        suggestion: \"\"\n      },\n      patientInfo: {\n        name: \"张保远\",\n        gender: \"male\",\n        age: 45\n      }\n    };\n  },\n  computed: {\n    formattedDate() {\n      const now = new Date();\n      return `${now.getFullYear()}年${now.getMonth() + 1}月${now.getDate()}日`;\n    }\n  },\n  methods: {\n    goBack() {\n      this.$router.go(-1);\n    },\n    exportReport() {\n      this.isPrinting = true;\n      this.$nextTick(() => {\n        // 这里应该调用导出PDF的库，如html2pdf等\n        // 简单起见，我们使用打印功能代替\n        window.print();\n        this.$message.success(\"报告已导出为PDF文件\");\n        this.isPrinting = false;\n      });\n    },\n    printReport() {\n      this.isPrinting = true;\n      this.$nextTick(() => {\n        window.print();\n        this.isPrinting = false;\n      });\n    },\n    startEdit() {\n      this.isEditing = true;\n    },\n    cancelEdit() {\n      this.isEditing = false;\n    },\n    saveTreatmentPlan() {\n      this.isEditing = false;\n      this.$message.success(\"治疗方案已保存\");\n    },\n    saveNotes() {\n      this.$message.success(\"医生备注已保存\");\n    },\n    percentFormat(percentage) {\n      return percentage + \"%\";\n    },\n    getConfidenceColor(confidence) {\n      if (confidence >= 80) {\n        return \"#67c23a\"; // 高置信度，绿色\n      } else if (confidence >= 60) {\n        return \"#e6a23c\"; // 中等置信度，黄色\n      } else {\n        return \"#f56c6c\"; // 低置信度，红色\n      }\n    },\n    getMatrixData(probabilities) {\n      if (!probabilities || probabilities.length === 0) {\n        return [];\n      }\n      return this.diseaseCategories.map((disease, index) => ({\n        disease,\n        probability: Math.round(probabilities[index] * 100)\n      }));\n    },\n    generateRandomProbabilities() {\n      // 生成随机概率分布\n      const probs = Array(this.diseaseCategories.length).fill(0).map(() => Math.random());\n      const sum = probs.reduce((a, b) => a + b, 0);\n      return probs.map(p => p / sum);\n    },\n    getMaxProbabilityIndex(probabilities) {\n      return probabilities.indexOf(Math.max(...probabilities));\n    },\n    generateFinalDiagnosis(leftIndex, rightIndex) {\n      // 根据左右眼结果生成综合诊断\n      if (leftIndex === rightIndex) {\n        return `双眼${this.diseaseCategories[leftIndex]}`;\n      } else if (leftIndex === 7 || rightIndex === 7) {\n        // 7是\"正常\"的索引\n        const abnormalIndex = leftIndex === 7 ? rightIndex : leftIndex;\n        const abnormalSide = leftIndex === 7 ? \"右眼\" : \"左眼\";\n        return `${abnormalSide}${this.diseaseCategories[abnormalIndex]}，另眼正常`;\n      } else {\n        return `左眼${this.diseaseCategories[leftIndex]}，右眼${this.diseaseCategories[rightIndex]}`;\n      }\n    },\n    generateSuggestion(leftIndex, rightIndex) {\n      // 根据诊断结果生成建议\n      const suggestions = {\n        0: \"建议进行血糖控制，定期复查眼底，必要时考虑激光或抗VEGF治疗。\",\n        1: \"建议测量眼压，进行视野检查，必要时使用降眼压药物。\",\n        2: \"建议进行视力矫正，必要时考虑白内障手术。\",\n        3: \"建议定期监测黄斑区变化，必要时考虑抗VEGF治疗。\",\n        4: \"建议控制血压，定期复查眼底。\",\n        5: \"建议进行屈光矫正，控制近距离用眼时间。\",\n        6: \"建议进一步检查确定具体异常类型。\",\n        7: \"眼底未见明显异常，建议定期检查。\"\n      };\n      if (leftIndex === rightIndex) {\n        return suggestions[leftIndex];\n      } else {\n        return `左眼：${suggestions[leftIndex]}\\n右眼：${suggestions[rightIndex]}`;\n      }\n    },\n    loadReportData() {\n      // 模拟从后端加载报告数据\n      // 在实际应用中，这里应该是一个API请求\n      // 模拟数据，也应该加载患者信息\n\n      // 获取路由中的患者ID信息\n      const patientId = this.$route.query.patientId;\n      if (patientId) {\n        // 在实际应用中，这里应该根据患者ID从服务器获取患者信息\n        // 为简单起见，我们使用示例数据\n        this.patientInfo = {\n          name: \"张保远\",\n          gender: \"male\",\n          age: 45\n        };\n      }\n\n      // 生成模拟数据\n      const leftEyeProbs = this.generateRandomProbabilities();\n      const rightEyeProbs = this.generateRandomProbabilities();\n      const leftMaxIndex = this.getMaxProbabilityIndex(leftEyeProbs);\n      const rightMaxIndex = this.getMaxProbabilityIndex(rightEyeProbs);\n      const date = new Date();\n      this.report = {\n        id: this.reportId,\n        time: date.toLocaleString(),\n        doctor: \"张医生\",\n        leftEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        rightEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\n        leftEye: {\n          diagnosis: this.diseaseCategories[leftMaxIndex],\n          confidence: Math.round(leftEyeProbs[leftMaxIndex] * 100),\n          probabilities: leftEyeProbs\n        },\n        rightEye: {\n          diagnosis: this.diseaseCategories[rightMaxIndex],\n          confidence: Math.round(rightEyeProbs[rightMaxIndex] * 100),\n          probabilities: rightEyeProbs\n        },\n        finalDiagnosis: this.generateFinalDiagnosis(leftMaxIndex, rightMaxIndex),\n        suggestion: this.generateSuggestion(leftMaxIndex, rightMaxIndex)\n      };\n\n      // 设置初始治疗方案\n      this.treatmentPlan = this.report.suggestion;\n    },\n    getTopFiveDiseases(probabilities) {\n      // 实现获取前五可能疾病的逻辑\n      // 这里需要根据概率分布来确定前五可能的疾病\n      // 这里只是一个示例实现，实际应用中需要根据实际情况来实现\n      return this.getMatrixData(probabilities).slice(0, 5);\n    }\n  },\n  created() {\n    // 从路由参数获取报告ID\n    this.reportId = this.$route.params.id;\n    this.loadReportData();\n  },\n  mounted() {\n    // 检查登录状态\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\n    if (!isLoggedIn) {\n      this.$router.push(\"/login\");\n    }\n\n    // 监听打印事件\n    window.addEventListener(\"beforeprint\", () => {\n      this.isPrinting = true;\n    });\n    window.addEventListener(\"afterprint\", () => {\n      this.isPrinting = false;\n    });\n  },\n  beforeUnmount() {\n    // 移除打印事件监听\n    window.removeEventListener(\"beforeprint\", () => {\n      this.isPrinting = true;\n    });\n    window.removeEventListener(\"afterprint\", () => {\n      this.isPrinting = false;\n    });\n  }\n};","map":{"version":3,"names":["AppLayout","name","components","data","reportId","doctorNotes","treatmentPlan","isEditing","isPrinting","diseaseCategories","report","id","time","doctor","leftEyeImage","rightEyeImage","leftEye","diagnosis","confidence","probabilities","rightEye","finalDiagnosis","suggestion","patientInfo","gender","age","computed","formattedDate","now","Date","getFullYear","getMonth","getDate","methods","goBack","$router","go","exportReport","$nextTick","window","print","$message","success","printReport","startEdit","cancelEdit","saveTreatmentPlan","saveNotes","percentFormat","percentage","getConfidenceColor","getMatrixData","length","map","disease","index","probability","Math","round","generateRandomProbabilities","probs","Array","fill","random","sum","reduce","a","b","p","getMaxProbabilityIndex","indexOf","max","generateFinalDiagnosis","leftIndex","rightIndex","abnormalIndex","abnormalSide","generateSuggestion","suggestions","loadReportData","patientId","$route","query","leftEyeProbs","rightEyeProbs","leftMaxIndex","rightMaxIndex","date","toLocaleString","getTopFiveDiseases","slice","created","params","mounted","isLoggedIn","localStorage","getItem","push","addEventListener","beforeUnmount","removeEventListener"],"sources":["E:\\Apollo\\Eye-Diagnose-System\\src\\views\\ReportDetailView.vue"],"sourcesContent":["<template>\r\n  <app-layout active-menu=\"/reports\">\r\n    <div class=\"report-detail-container\">\r\n      <div class=\"report-header\">\r\n        <div class=\"back-button\">\r\n          <el-button icon=\"el-icon-arrow-left\" @click=\"goBack\">返回</el-button>\r\n        </div>\r\n        <h1 class=\"report-title\">眼科诊断报告</h1>\r\n        <div class=\"report-actions\">\r\n          <el-button\r\n            type=\"primary\"\r\n            icon=\"el-icon-download\"\r\n            @click=\"exportReport\"\r\n            >导出报告</el-button\r\n          >\r\n          <el-button type=\"success\" icon=\"el-icon-printer\" @click=\"printReport\"\r\n            >打印报告</el-button\r\n          >\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"report-content\" ref=\"reportContent\">\r\n        <!-- A4 尺寸的报告区域 -->\r\n        <div class=\"a4-container\">\r\n          <div class=\"report-paper\">\r\n            <!-- 报告头部 -->\r\n            <div class=\"report-paper-header\">\r\n              <div class=\"report-logo-section\">\r\n                <div class=\"report-logo\">\r\n                  <img src=\"@/assets/logo.png\" alt=\"Logo\" class=\"logo-image\" />\r\n                </div>\r\n                <div class=\"report-title-section\">\r\n                  <h1 class=\"report-main-title\">眼科诊断报告</h1>\r\n                </div>\r\n              </div>\r\n              <div class=\"report-barcode-section\">\r\n                <div class=\"barcode-container\">\r\n                  <!-- 这里放置条形码，实际项目中可使用条形码库生成 -->\r\n                  <div class=\"barcode-placeholder\"></div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 报告编号和日期 -->\r\n            <div class=\"report-meta\">\r\n              <div class=\"report-id\">报告编号：EYE{{ reportId }}</div>\r\n              <div class=\"report-date\">生成日期：{{ formattedDate }}</div>\r\n            </div>\r\n\r\n            <!-- 患者信息 -->\r\n            <div class=\"patient-info-section\">\r\n              <h2 class=\"section-subtitle\">患者信息</h2>\r\n              <div class=\"patient-info-grid\">\r\n                <div class=\"info-row\">\r\n                  <div class=\"info-item\">\r\n                    <span class=\"info-label\">姓名：</span>\r\n                    <span class=\"info-value\">{{ patientInfo.name }}</span>\r\n                  </div>\r\n                  <div class=\"info-item\">\r\n                    <span class=\"info-label\">性别：</span>\r\n                    <span class=\"info-value\">{{\r\n                      patientInfo.gender === \"male\" ? \"男\" : \"女\"\r\n                    }}</span>\r\n                  </div>\r\n                  <div class=\"info-item\">\r\n                    <span class=\"info-label\">年龄：</span>\r\n                    <span class=\"info-value\">{{ patientInfo.age }}岁</span>\r\n                  </div>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                  <div class=\"info-item\">\r\n                    <span class=\"info-label\">患者ID：</span>\r\n                    <span class=\"info-value\">P{{ reportId }}</span>\r\n                  </div>\r\n                  <div class=\"info-item\">\r\n                    <span class=\"info-label\">诊断日期：</span>\r\n                    <span class=\"info-value\">{{ report.time }}</span>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 眼底图片 -->\r\n            <div class=\"eye-images-section\">\r\n              <h2 class=\"section-subtitle\">眼底图片</h2>\r\n              <div class=\"eye-images-grid\">\r\n                <div class=\"eye-image-container\">\r\n                  <img\r\n                    :src=\"report.leftEyeImage\"\r\n                    alt=\"左眼眼底图像\"\r\n                    class=\"eye-image\"\r\n                  />\r\n                  <div class=\"eye-label-below\">左眼</div>\r\n                </div>\r\n                <div class=\"eye-image-container\">\r\n                  <img\r\n                    :src=\"report.rightEyeImage\"\r\n                    alt=\"右眼眼底图像\"\r\n                    class=\"eye-image\"\r\n                  />\r\n                  <div class=\"eye-label-below\">右眼</div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 诊断结果 -->\r\n            <div class=\"diagnosis-section\">\r\n              <h2 class=\"section-subtitle\">诊断结果</h2>\r\n              <div class=\"diagnosis-grid\">\r\n                <div class=\"diagnosis-item\">\r\n                  <h3 class=\"diagnosis-title\">左眼诊断：</h3>\r\n                  <el-table\r\n                    :data=\"getTopFiveDiseases(report.leftEye.probabilities)\"\r\n                    stripe\r\n                  >\r\n                    <el-table-column\r\n                      prop=\"disease\"\r\n                      label=\"疾病名称\"\r\n                      width=\"180\"\r\n                    ></el-table-column>\r\n                    <el-table-column prop=\"probability\" label=\"概率\">\r\n                      <template #default=\"scope\">\r\n                        {{ scope.row.probability }}%\r\n                      </template>\r\n                    </el-table-column>\r\n                  </el-table>\r\n                  <div class=\"diagnosis-conclusion\">\r\n                    <span class=\"conclusion-label\">诊断结论：</span>\r\n                    <span class=\"conclusion-value\">{{\r\n                      report.leftEye.diagnosis\r\n                    }}</span>\r\n                  </div>\r\n                </div>\r\n                <div class=\"diagnosis-item\">\r\n                  <h3 class=\"diagnosis-title\">右眼诊断：</h3>\r\n                  <el-table\r\n                    :data=\"getTopFiveDiseases(report.rightEye.probabilities)\"\r\n                    stripe\r\n                  >\r\n                    <el-table-column\r\n                      prop=\"disease\"\r\n                      label=\"疾病名称\"\r\n                      width=\"180\"\r\n                    ></el-table-column>\r\n                    <el-table-column prop=\"probability\" label=\"概率\">\r\n                      <template #default=\"scope\">\r\n                        {{ scope.row.probability }}%\r\n                      </template>\r\n                    </el-table-column>\r\n                  </el-table>\r\n                  <div class=\"diagnosis-conclusion\">\r\n                    <span class=\"conclusion-label\">诊断结论：</span>\r\n                    <span class=\"conclusion-value\">{{\r\n                      report.rightEye.diagnosis\r\n                    }}</span>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n\r\n              <!-- 综合诊断 -->\r\n              <div class=\"final-diagnosis\">\r\n                <h3 class=\"diagnosis-title\">综合诊断结果：</h3>\r\n                <div class=\"final-diagnosis-value\">\r\n                  {{ report.finalDiagnosis }}\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 治疗建议 -->\r\n            <div class=\"treatment-section\">\r\n              <h2 class=\"section-subtitle\">建议治疗方案</h2>\r\n              <div class=\"treatment-content\">\r\n                <el-input\r\n                  type=\"textarea\"\r\n                  v-model=\"treatmentPlan\"\r\n                  :rows=\"4\"\r\n                  placeholder=\"请输入建议治疗方案...\"\r\n                  :disabled=\"!isEditing\"\r\n                ></el-input>\r\n                <div class=\"treatment-actions\" v-if=\"isEditing\">\r\n                  <el-button\r\n                    type=\"primary\"\r\n                    size=\"small\"\r\n                    @click=\"saveTreatmentPlan\"\r\n                    >保存方案</el-button\r\n                  >\r\n                  <el-button size=\"small\" @click=\"cancelEdit\">取消</el-button>\r\n                </div>\r\n                <div class=\"treatment-actions\" v-else>\r\n                  <el-button type=\"primary\" size=\"small\" @click=\"startEdit\"\r\n                    >编辑方案</el-button\r\n                  >\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 医生签名 -->\r\n            <div class=\"doctor-signature\">\r\n              <div class=\"signature-text\">\r\n                <div>医生签名：_________________</div>\r\n                <div>日期：___________________</div>\r\n              </div>\r\n              <div class=\"hospital-stamp\">\r\n                <div class=\"stamp-placeholder\">医院盖章</div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 页脚 -->\r\n            <div class=\"report-footer\">\r\n              <div>本报告仅供医疗参考，最终诊断请以医生诊断为准</div>\r\n              <div>报告编号：EYE{{ reportId }}</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 编辑模式下的额外备注输入 -->\r\n      <el-card class=\"notes-card\" v-if=\"!isPrinting\">\r\n        <template #header>\r\n          <div class=\"notes-header\">\r\n            <h2>医生备注（不会出现在打印报告中）</h2>\r\n          </div>\r\n        </template>\r\n        <div class=\"notes-content\">\r\n          <el-input\r\n            type=\"textarea\"\r\n            v-model=\"doctorNotes\"\r\n            :rows=\"4\"\r\n            placeholder=\"请输入医生备注...\"\r\n          ></el-input>\r\n          <div class=\"notes-actions\">\r\n            <el-button type=\"primary\" @click=\"saveNotes\">保存备注</el-button>\r\n          </div>\r\n        </div>\r\n      </el-card>\r\n    </div>\r\n  </app-layout>\r\n</template>\r\n\r\n<script>\r\nimport AppLayout from \"@/components/AppLayout.vue\";\r\n\r\nexport default {\r\n  name: \"ReportDetailView\",\r\n  components: {\r\n    AppLayout,\r\n  },\r\n  data() {\r\n    return {\r\n      reportId: null,\r\n      doctorNotes: \"\",\r\n      treatmentPlan: \"\",\r\n      isEditing: false,\r\n      isPrinting: false,\r\n      diseaseCategories: [\r\n        \"糖尿病视网膜病变\",\r\n        \"青光眼\",\r\n        \"白内障\",\r\n        \"AMD\",\r\n        \"高血压视网膜病变\",\r\n        \"近视\",\r\n        \"其他异常\",\r\n        \"正常\",\r\n      ],\r\n      report: {\r\n        id: \"\",\r\n        time: \"\",\r\n        doctor: \"\",\r\n        leftEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\r\n        rightEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\r\n        leftEye: {\r\n          diagnosis: \"\",\r\n          confidence: 0,\r\n          probabilities: [],\r\n        },\r\n        rightEye: {\r\n          diagnosis: \"\",\r\n          confidence: 0,\r\n          probabilities: [],\r\n        },\r\n        finalDiagnosis: \"\",\r\n        suggestion: \"\",\r\n      },\r\n      patientInfo: {\r\n        name: \"张保远\",\r\n        gender: \"male\",\r\n        age: 45,\r\n      },\r\n    };\r\n  },\r\n  computed: {\r\n    formattedDate() {\r\n      const now = new Date();\r\n      return `${now.getFullYear()}年${now.getMonth() + 1}月${now.getDate()}日`;\r\n    },\r\n  },\r\n  methods: {\r\n    goBack() {\r\n      this.$router.go(-1);\r\n    },\r\n\r\n    exportReport() {\r\n      this.isPrinting = true;\r\n      this.$nextTick(() => {\r\n        // 这里应该调用导出PDF的库，如html2pdf等\r\n        // 简单起见，我们使用打印功能代替\r\n        window.print();\r\n        this.$message.success(\"报告已导出为PDF文件\");\r\n        this.isPrinting = false;\r\n      });\r\n    },\r\n\r\n    printReport() {\r\n      this.isPrinting = true;\r\n      this.$nextTick(() => {\r\n        window.print();\r\n        this.isPrinting = false;\r\n      });\r\n    },\r\n\r\n    startEdit() {\r\n      this.isEditing = true;\r\n    },\r\n\r\n    cancelEdit() {\r\n      this.isEditing = false;\r\n    },\r\n\r\n    saveTreatmentPlan() {\r\n      this.isEditing = false;\r\n      this.$message.success(\"治疗方案已保存\");\r\n    },\r\n\r\n    saveNotes() {\r\n      this.$message.success(\"医生备注已保存\");\r\n    },\r\n\r\n    percentFormat(percentage) {\r\n      return percentage + \"%\";\r\n    },\r\n\r\n    getConfidenceColor(confidence) {\r\n      if (confidence >= 80) {\r\n        return \"#67c23a\"; // 高置信度，绿色\r\n      } else if (confidence >= 60) {\r\n        return \"#e6a23c\"; // 中等置信度，黄色\r\n      } else {\r\n        return \"#f56c6c\"; // 低置信度，红色\r\n      }\r\n    },\r\n\r\n    getMatrixData(probabilities) {\r\n      if (!probabilities || probabilities.length === 0) {\r\n        return [];\r\n      }\r\n\r\n      return this.diseaseCategories.map((disease, index) => ({\r\n        disease,\r\n        probability: Math.round(probabilities[index] * 100),\r\n      }));\r\n    },\r\n\r\n    generateRandomProbabilities() {\r\n      // 生成随机概率分布\r\n      const probs = Array(this.diseaseCategories.length)\r\n        .fill(0)\r\n        .map(() => Math.random());\r\n      const sum = probs.reduce((a, b) => a + b, 0);\r\n      return probs.map((p) => p / sum);\r\n    },\r\n\r\n    getMaxProbabilityIndex(probabilities) {\r\n      return probabilities.indexOf(Math.max(...probabilities));\r\n    },\r\n\r\n    generateFinalDiagnosis(leftIndex, rightIndex) {\r\n      // 根据左右眼结果生成综合诊断\r\n      if (leftIndex === rightIndex) {\r\n        return `双眼${this.diseaseCategories[leftIndex]}`;\r\n      } else if (leftIndex === 7 || rightIndex === 7) {\r\n        // 7是\"正常\"的索引\r\n        const abnormalIndex = leftIndex === 7 ? rightIndex : leftIndex;\r\n        const abnormalSide = leftIndex === 7 ? \"右眼\" : \"左眼\";\r\n        return `${abnormalSide}${this.diseaseCategories[abnormalIndex]}，另眼正常`;\r\n      } else {\r\n        return `左眼${this.diseaseCategories[leftIndex]}，右眼${this.diseaseCategories[rightIndex]}`;\r\n      }\r\n    },\r\n\r\n    generateSuggestion(leftIndex, rightIndex) {\r\n      // 根据诊断结果生成建议\r\n      const suggestions = {\r\n        0: \"建议进行血糖控制，定期复查眼底，必要时考虑激光或抗VEGF治疗。\",\r\n        1: \"建议测量眼压，进行视野检查，必要时使用降眼压药物。\",\r\n        2: \"建议进行视力矫正，必要时考虑白内障手术。\",\r\n        3: \"建议定期监测黄斑区变化，必要时考虑抗VEGF治疗。\",\r\n        4: \"建议控制血压，定期复查眼底。\",\r\n        5: \"建议进行屈光矫正，控制近距离用眼时间。\",\r\n        6: \"建议进一步检查确定具体异常类型。\",\r\n        7: \"眼底未见明显异常，建议定期检查。\",\r\n      };\r\n\r\n      if (leftIndex === rightIndex) {\r\n        return suggestions[leftIndex];\r\n      } else {\r\n        return `左眼：${suggestions[leftIndex]}\\n右眼：${suggestions[rightIndex]}`;\r\n      }\r\n    },\r\n\r\n    loadReportData() {\r\n      // 模拟从后端加载报告数据\r\n      // 在实际应用中，这里应该是一个API请求\r\n      // 模拟数据，也应该加载患者信息\r\n\r\n      // 获取路由中的患者ID信息\r\n      const patientId = this.$route.query.patientId;\r\n      if (patientId) {\r\n        // 在实际应用中，这里应该根据患者ID从服务器获取患者信息\r\n        // 为简单起见，我们使用示例数据\r\n        this.patientInfo = {\r\n          name: \"张保远\",\r\n          gender: \"male\",\r\n          age: 45,\r\n        };\r\n      }\r\n\r\n      // 生成模拟数据\r\n      const leftEyeProbs = this.generateRandomProbabilities();\r\n      const rightEyeProbs = this.generateRandomProbabilities();\r\n\r\n      const leftMaxIndex = this.getMaxProbabilityIndex(leftEyeProbs);\r\n      const rightMaxIndex = this.getMaxProbabilityIndex(rightEyeProbs);\r\n\r\n      const date = new Date();\r\n\r\n      this.report = {\r\n        id: this.reportId,\r\n        time: date.toLocaleString(),\r\n        doctor: \"张医生\",\r\n        leftEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\r\n        rightEyeImage: \"https://avatars.githubusercontent.com/u/153343413?v=4\",\r\n        leftEye: {\r\n          diagnosis: this.diseaseCategories[leftMaxIndex],\r\n          confidence: Math.round(leftEyeProbs[leftMaxIndex] * 100),\r\n          probabilities: leftEyeProbs,\r\n        },\r\n        rightEye: {\r\n          diagnosis: this.diseaseCategories[rightMaxIndex],\r\n          confidence: Math.round(rightEyeProbs[rightMaxIndex] * 100),\r\n          probabilities: rightEyeProbs,\r\n        },\r\n        finalDiagnosis: this.generateFinalDiagnosis(\r\n          leftMaxIndex,\r\n          rightMaxIndex\r\n        ),\r\n        suggestion: this.generateSuggestion(leftMaxIndex, rightMaxIndex),\r\n      };\r\n\r\n      // 设置初始治疗方案\r\n      this.treatmentPlan = this.report.suggestion;\r\n    },\r\n\r\n    getTopFiveDiseases(probabilities) {\r\n      // 实现获取前五可能疾病的逻辑\r\n      // 这里需要根据概率分布来确定前五可能的疾病\r\n      // 这里只是一个示例实现，实际应用中需要根据实际情况来实现\r\n      return this.getMatrixData(probabilities).slice(0, 5);\r\n    },\r\n  },\r\n  created() {\r\n    // 从路由参数获取报告ID\r\n    this.reportId = this.$route.params.id;\r\n    this.loadReportData();\r\n  },\r\n  mounted() {\r\n    // 检查登录状态\r\n    const isLoggedIn = localStorage.getItem(\"isLoggedIn\");\r\n    if (!isLoggedIn) {\r\n      this.$router.push(\"/login\");\r\n    }\r\n\r\n    // 监听打印事件\r\n    window.addEventListener(\"beforeprint\", () => {\r\n      this.isPrinting = true;\r\n    });\r\n    window.addEventListener(\"afterprint\", () => {\r\n      this.isPrinting = false;\r\n    });\r\n  },\r\n  beforeUnmount() {\r\n    // 移除打印事件监听\r\n    window.removeEventListener(\"beforeprint\", () => {\r\n      this.isPrinting = true;\r\n    });\r\n    window.removeEventListener(\"afterprint\", () => {\r\n      this.isPrinting = false;\r\n    });\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.report-detail-container {\r\n  padding: 20px;\r\n  background-color: #f5f7fa;\r\n  min-height: calc(100vh - 60px);\r\n}\r\n\r\n.report-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.report-title {\r\n  font-size: 24px;\r\n  font-weight: 600;\r\n  color: #303133;\r\n  margin: 0;\r\n}\r\n\r\n.report-content {\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n/* A4尺寸样式 */\r\n.a4-container {\r\n  width: 210mm;\r\n  margin: 0 auto;\r\n  background: white;\r\n  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.report-paper {\r\n  padding: 20mm;\r\n  position: relative;\r\n  min-height: 297mm;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* 报告头部样式 */\r\n.report-paper-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 15px;\r\n  border-bottom: 2px solid #2c3e50;\r\n  padding-bottom: 15px;\r\n}\r\n\r\n.report-logo-section {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.logo-image {\r\n  width: 60px;\r\n  height: 60px;\r\n  object-fit: contain;\r\n}\r\n\r\n.report-title-section {\r\n  margin-left: 15px;\r\n}\r\n\r\n.report-main-title {\r\n  margin: 0;\r\n  font-size: 28px;\r\n  color: #2c3e50;\r\n  font-weight: bold;\r\n}\r\n\r\n.report-barcode-section {\r\n  text-align: right;\r\n}\r\n\r\n.barcode-container {\r\n  margin-left: auto;\r\n}\r\n\r\n.barcode-placeholder {\r\n  width: 200px;\r\n  height: 60px;\r\n  background-image: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"60\" viewBox=\"0 0 200 60\"><rect x=\"10\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"15\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"20\" y=\"10\" width=\"3\" height=\"40\" fill=\"%23000\"/><rect x=\"26\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"30\" y=\"10\" width=\"4\" height=\"40\" fill=\"%23000\"/><rect x=\"36\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"39\" y=\"10\" width=\"3\" height=\"40\" fill=\"%23000\"/><rect x=\"45\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"49\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"52\" y=\"10\" width=\"4\" height=\"40\" fill=\"%23000\"/><rect x=\"58\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"62\" y=\"10\" width=\"3\" height=\"40\" fill=\"%23000\"/><rect x=\"68\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"71\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"75\" y=\"10\" width=\"4\" height=\"40\" fill=\"%23000\"/><rect x=\"81\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"84\" y=\"10\" width=\"3\" height=\"40\" fill=\"%23000\"/><rect x=\"90\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"94\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"97\" y=\"10\" width=\"4\" height=\"40\" fill=\"%23000\"/><rect x=\"103\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"107\" y=\"10\" width=\"3\" height=\"40\" fill=\"%23000\"/><rect x=\"113\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"116\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"120\" y=\"10\" width=\"4\" height=\"40\" fill=\"%23000\"/><rect x=\"126\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"129\" y=\"10\" width=\"3\" height=\"40\" fill=\"%23000\"/><rect x=\"135\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"139\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"142\" y=\"10\" width=\"4\" height=\"40\" fill=\"%23000\"/><rect x=\"148\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"152\" y=\"10\" width=\"3\" height=\"40\" fill=\"%23000\"/><rect x=\"158\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"161\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/><rect x=\"165\" y=\"10\" width=\"4\" height=\"40\" fill=\"%23000\"/><rect x=\"171\" y=\"10\" width=\"1\" height=\"40\" fill=\"%23000\"/><rect x=\"174\" y=\"10\" width=\"3\" height=\"40\" fill=\"%23000\"/><rect x=\"180\" y=\"10\" width=\"2\" height=\"40\" fill=\"%23000\"/></svg>');\r\n  background-repeat: no-repeat;\r\n  background-position: center;\r\n}\r\n\r\n/* 报告元数据 */\r\n.report-meta {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  margin-bottom: 20px;\r\n  font-size: 14px;\r\n  color: #606266;\r\n}\r\n\r\n/* 患者信息区域 */\r\n.patient-info-section {\r\n  margin-bottom: 25px;\r\n  border: 1px solid #ebeef5;\r\n  border-radius: 4px;\r\n  padding: 15px;\r\n  background-color: #f8f9fa;\r\n}\r\n\r\n.section-subtitle {\r\n  margin-top: 0;\r\n  margin-bottom: 15px;\r\n  font-size: 18px;\r\n  color: #2c3e50;\r\n  padding-bottom: 8px;\r\n  border-bottom: 1px solid #dcdfe6;\r\n}\r\n\r\n.patient-info-grid {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.info-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 20px;\r\n}\r\n\r\n.info-item {\r\n  min-width: 120px;\r\n  flex: 1;\r\n}\r\n\r\n.info-label {\r\n  font-weight: 600;\r\n  color: #606266;\r\n}\r\n\r\n.info-value {\r\n  color: #303133;\r\n}\r\n\r\n/* 眼底图像区域 */\r\n.eye-images-section {\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.eye-images-grid {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 20px;\r\n}\r\n\r\n.eye-image-container {\r\n  flex: 1;\r\n  text-align: center;\r\n  position: relative;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n}\r\n\r\n.eye-image {\r\n  width: 100%;\r\n  max-height: 200px;\r\n  object-fit: contain;\r\n  border: 1px solid #dcdfe6;\r\n  border-radius: 4px;\r\n}\r\n\r\n.eye-label-below {\r\n  margin-top: 10px;\r\n  background-color: #409eff;\r\n  color: white;\r\n  padding: 4px 12px;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n}\r\n\r\n/* 诊断结果区域 */\r\n.diagnosis-section {\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.diagnosis-grid {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 20px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.diagnosis-item {\r\n  flex: 1;\r\n  padding: 15px;\r\n  border-radius: 4px;\r\n  background-color: #f8f9fa;\r\n  border: 1px solid #ebeef5;\r\n}\r\n\r\n.diagnosis-title {\r\n  margin-top: 0;\r\n  margin-bottom: 15px;\r\n  font-size: 16px;\r\n  color: #606266;\r\n}\r\n\r\n.diagnosis-conclusion {\r\n  margin-top: 15px;\r\n  padding: 10px;\r\n  background-color: #f0f9eb;\r\n  border-radius: 4px;\r\n  border: 1px solid #e1f3d8;\r\n}\r\n\r\n.conclusion-label {\r\n  color: #606266;\r\n  font-size: 14px;\r\n  margin-right: 8px;\r\n}\r\n\r\n.conclusion-value {\r\n  color: #67c23a;\r\n  font-weight: 600;\r\n  font-size: 15px;\r\n}\r\n\r\n.confidence-bar {\r\n  margin-top: 10px;\r\n}\r\n\r\n.confidence-label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n  font-size: 14px;\r\n  color: #606266;\r\n}\r\n\r\n.final-diagnosis {\r\n  padding: 15px;\r\n  border-radius: 4px;\r\n  background-color: #f0f9eb;\r\n  border: 1px solid #e1f3d8;\r\n}\r\n\r\n.final-diagnosis-value {\r\n  font-size: 20px;\r\n  font-weight: 600;\r\n  color: #67c23a;\r\n}\r\n\r\n.top-diseases {\r\n  margin-top: 20px;\r\n}\r\n\r\n.top-diseases h4 {\r\n  margin-bottom: 10px;\r\n  color: #606266;\r\n  font-size: 14px;\r\n}\r\n\r\n.top-diseases :deep(.el-table) {\r\n  margin-top: 10px;\r\n  font-size: 13px;\r\n}\r\n\r\n.top-diseases :deep(.el-table th) {\r\n  background-color: #f5f7fa;\r\n  color: #606266;\r\n}\r\n\r\n.top-diseases :deep(.el-table td) {\r\n  padding: 8px 0;\r\n}\r\n\r\n/* 治疗建议区域 */\r\n.treatment-section {\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.treatment-content {\r\n  padding: 15px;\r\n  border-radius: 4px;\r\n  background-color: #f8f9fa;\r\n  border: 1px solid #ebeef5;\r\n}\r\n\r\n.treatment-actions {\r\n  margin-top: 10px;\r\n  text-align: right;\r\n}\r\n\r\n/* 医生签名区域 */\r\n.doctor-signature {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  margin-top: 30px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.signature-text {\r\n  line-height: 2;\r\n  color: #606266;\r\n}\r\n\r\n.hospital-stamp {\r\n  width: 100px;\r\n  height: 100px;\r\n  border: 1px dashed #dcdfe6;\r\n  border-radius: 50%;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  color: #909399;\r\n  font-size: 14px;\r\n}\r\n\r\n/* 页脚 */\r\n.report-footer {\r\n  margin-top: 30px;\r\n  text-align: center;\r\n  color: #909399;\r\n  font-size: 12px;\r\n  border-top: 1px solid #ebeef5;\r\n  padding-top: 15px;\r\n}\r\n\r\n/* 备注卡片 */\r\n.notes-card {\r\n  margin-top: 30px;\r\n  margin-bottom: 40px;\r\n}\r\n\r\n.notes-header h2 {\r\n  margin: 0;\r\n  font-size: 16px;\r\n}\r\n\r\n.notes-content {\r\n  padding: 20px 0;\r\n}\r\n\r\n.notes-actions {\r\n  margin-top: 15px;\r\n  text-align: right;\r\n}\r\n\r\n/* 打印样式 */\r\n@media print {\r\n  .report-header,\r\n  .notes-card,\r\n  .el-button {\r\n    display: none !important;\r\n  }\r\n\r\n  .report-detail-container {\r\n    padding: 0;\r\n    background-color: white;\r\n  }\r\n\r\n  .a4-container {\r\n    width: 100%;\r\n    box-shadow: none;\r\n  }\r\n\r\n  .report-paper {\r\n    padding: 0;\r\n  }\r\n\r\n  body {\r\n    -webkit-print-color-adjust: exact !important;\r\n    print-color-adjust: exact !important;\r\n  }\r\n}\r\n\r\n/* 响应式适配 */\r\n@media (max-width: 768px) {\r\n  .a4-container {\r\n    width: 100%;\r\n  }\r\n\r\n  .report-paper {\r\n    padding: 10px;\r\n  }\r\n\r\n  .eye-images-grid,\r\n  .diagnosis-grid {\r\n    flex-direction: column;\r\n  }\r\n\r\n  .report-header {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n  }\r\n\r\n  .report-title {\r\n    margin: 10px 0;\r\n  }\r\n\r\n  .report-actions {\r\n    margin-top: 10px;\r\n  }\r\n\r\n  .info-row {\r\n    flex-direction: column;\r\n  }\r\n\r\n  .info-item {\r\n    margin-right: 0;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;;;AAgPA,OAAOA,SAAQ,MAAO,4BAA4B;AAElD,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,IAAI;MACdC,WAAW,EAAE,EAAE;MACfC,aAAa,EAAE,EAAE;MACjBC,SAAS,EAAE,KAAK;MAChBC,UAAU,EAAE,KAAK;MACjBC,iBAAiB,EAAE,CACjB,UAAU,EACV,KAAK,EACL,KAAK,EACL,KAAK,EACL,UAAU,EACV,IAAI,EACJ,MAAM,EACN,IAAI,CACL;MACDC,MAAM,EAAE;QACNC,EAAE,EAAE,EAAE;QACNC,IAAI,EAAE,EAAE;QACRC,MAAM,EAAE,EAAE;QACVC,YAAY,EAAE,uDAAuD;QACrEC,aAAa,EAAE,uDAAuD;QACtEC,OAAO,EAAE;UACPC,SAAS,EAAE,EAAE;UACbC,UAAU,EAAE,CAAC;UACbC,aAAa,EAAE;QACjB,CAAC;QACDC,QAAQ,EAAE;UACRH,SAAS,E