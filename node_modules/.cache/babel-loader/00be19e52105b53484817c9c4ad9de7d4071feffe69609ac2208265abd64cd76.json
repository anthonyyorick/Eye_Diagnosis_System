m\\src\\views\\DashboardView.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard\">\r\n    <div class=\"hero-section\">\r\n      <div class=\"content-wrapper\">\r\n        <h1 class=\"main-title\">专业的医疗帮助系统</h1>\r\n        <p class=\"subtitle\">\r\n          为医疗工作者提供全方位的支持与指导，助力提升诊疗效率与准确性\r\n        </p>\r\n        <el-button type=\"primary\" class=\"start-button\">立即开始</el-button>\r\n\r\n        <div class=\"date-display\">\r\n          <span class=\"date\">{{ currentDate }}</span>\r\n          <span class=\"weekday\">{{ currentWeekday }}</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nconst currentDate = new Date().toLocaleDateString(\"zh-CN\", {\r\n  year: \"numeric\",\r\n  month: \"long\",\r\n  day: \"numeric\",\r\n});\r\n\r\nconst currentWeekday = new Date().toLocaleDateString(\"zh-CN\", {\r\n  weekday: \"long\",\r\n});\r\n</script>\r\n\r\n<style scoped>\r\n.dashboard {\r\n  width: 100%;\r\n}\r\n\r\n.hero-section {\r\n  width: 100%;\r\n  height: 300px;\r\n  background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%);\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.content-wrapper {\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  padding: 40px 20px;\r\n  color: white;\r\n  position: relative;\r\n}\r\n\r\n.main-title {\r\n  font-size: 2.5em;\r\n  margin-bottom: 16px;\r\n  font-weight: bold;\r\n}\r\n\r\n.subtitle {\r\n  font-size: 1.2em;\r\n  margin-bottom: 24px;\r\n  opacity: 0.9;\r\n  max-width: 600px;\r\n  line-height: 1.6;\r\n}\r\n\r\n.start-button {\r\n  padding: 12px 24px;\r\n  font-size: 1.1em;\r\n  background: #409eff;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.start-button:hover {\r\n  background: #66b1ff;\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.date-display {\r\n  position: absolute;\r\n  top: 40px;\r\n  right: 40px;\r\n  text-align: right;\r\n  color: white;\r\n}\r\n\r\n.date {\r\n  display: b